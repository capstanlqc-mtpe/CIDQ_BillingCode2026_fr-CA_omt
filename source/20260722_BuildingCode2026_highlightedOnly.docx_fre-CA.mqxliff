<trans-unit id="1235" mq:status="NotStarted" mq:segmentguid="c87b7d43-586f-4300-a69a-0cb8f53ab284" mq:lastchangedtimestamp="0001-01-01T00:00:00Z" mq:maxlengthchars="-1" mq:nosplitjoin="false" mq:firstlabel="1029" mq:lastlabel="1029" mq:autosplitjoinstate="0" mq:lastmodifrole="0" mq:multipleexactmatch="false">
<source xml:space="preserve" mq:segpart="1029" mq:hasfollowingobject="hasfollowingobject">Where approved, the prerecorded announcement is allowed to be manually deactivated for a period of time, not to exceed 3 minutes, for the sole purpose of allowing a live voice announcement from an approved, constantly attended location.</source>
<target xml:space="preserve"></target>
<context-group>
