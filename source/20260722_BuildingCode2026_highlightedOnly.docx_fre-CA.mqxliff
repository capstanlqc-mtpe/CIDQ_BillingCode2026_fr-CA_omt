<trans-unit id="3524" mq:status="NotStarted" mq:segmentguid="4d9fcd12-ce62-4461-bbb8-6595fd67387d" mq:lastchangedtimestamp="0001-01-01T00:00:00Z" mq:maxlengthchars="-1" mq:nosplitjoin="false" mq:firstlabel="2813" mq:lastlabel="2813" mq:autosplitjoinstate="0" mq:lastmodifrole="0" mq:multipleexactmatch="false">
<source xml:space="preserve" mq:segpart="2813" mq:hasfollowingobject="hasfollowingobject">In dwellings or dwelling units with split levels and without an intervening door between the adjacent levels, a smoke alarm installed on the upper level shall suffice for the adjacent lower level provided that the lower level is less than one full story below the upper level.</source>
<target xml:space="preserve"></target>
