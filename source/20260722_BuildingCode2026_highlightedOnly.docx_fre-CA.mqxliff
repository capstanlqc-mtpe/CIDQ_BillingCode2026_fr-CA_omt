<source xml:space="preserve" mq:segpart="2633" mq:hasfollowingobject="hasfollowingobject">The designation shall be acid etched, sandblasted, ceramic-fired, laser etched, embossed, or be of a type that once applied cannot be removed without being destroyed.</source>
<target xml:space="preserve"></target>
<context-group>
