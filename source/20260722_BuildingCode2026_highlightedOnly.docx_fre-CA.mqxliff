<mq:originalsource edited="false" />
</trans-unit>
<trans-unit id="146" mq:status="NotStarted" mq:segmentguid="e00e5526-bbe3-492c-b489-95673086e589" mq:lastchangedtimestamp="0001-01-01T00:00:00Z" mq:maxlengthchars="-1" mq:nosplitjoin="false" mq:firstlabel="140" mq:lastlabel="140" mq:autosplitjoinstate="0" mq:lastmodifrole="0" mq:multipleexactmatch="false">
<source xml:space="preserve" mq:segpart="140" mq:hasfollowingobject="hasfollowingobject">The building official shall have access to such records at all times or such records shall be filed with the building official as designated.</source>
<target xml:space="preserve"></target>
