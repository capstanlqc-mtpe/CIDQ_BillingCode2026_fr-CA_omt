<source xml:space="preserve" mq:segpart="2995" mq:hasfollowingobject="hasfollowingobject"><bpt id="1" ctype="bold">{}</bpt>R1001.8.1 Smoke chamber dimensions.<ept id="1">{}</ept></source>
