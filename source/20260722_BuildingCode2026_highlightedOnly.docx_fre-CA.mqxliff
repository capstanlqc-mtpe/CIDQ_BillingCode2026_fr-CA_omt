<source xml:space="preserve" mq:segpart="1777" mq:hasfollowingobject="hasfollowingobject">Aisles that are sloped more than 1 unit vertical in 20 units horizontal (5-percent slope) shall be considered to be a ramped aisle.</source>
<target xml:space="preserve"></target>
<context-group>
<context context-type="x-mmq-structural-context">trans-units / trans-unit#5741 / struct-rpr#1</context>
