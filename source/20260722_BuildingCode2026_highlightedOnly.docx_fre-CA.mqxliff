<trans-unit id="145" mq:status="NotStarted" mq:segmentguid="194a6e7e-978c-41ee-94a1-f95572b90843" mq:lastchangedtimestamp="0001-01-01T00:00:00Z" mq:maxlengthchars="-1" mq:nosplitjoin="false" mq:firstlabel="140" mq:lastlabel="140" mq:autosplitjoinstate="0" mq:lastmodifrole="0" mq:multipleexactmatch="false">
<source xml:space="preserve" mq:segpart="140" mq:hasfollowingobject="hasfollowingobject">The person to whom an annual permit is issued shall keep a detailed record of alterations made under such annual permit.</source>
<target xml:space="preserve"></target>
<context-group>
<context context-type="x-mmq-structural-context">trans-units / trans-unit#139 / struct-rpr#1</context>
