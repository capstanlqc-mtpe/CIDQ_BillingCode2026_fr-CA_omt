<trans-unit id="1627" mq:status="NotStarted" mq:segmentguid="d4d17539-46ff-49a2-826e-e80d49dcbe3f" mq:lastchangedtimestamp="0001-01-01T00:00:00Z" mq:maxlengthchars="-1" mq:nosplitjoin="false" mq:firstlabel="1351" mq:lastlabel="1351" mq:autosplitjoinstate="0" mq:lastmodifrole="0" mq:multipleexactmatch="false">
<source xml:space="preserve" mq:segpart="1351" mq:hasfollowingobject="hasfollowingobject">The interior exit stairway and ramp ventilation systems shall be independent of other building ventilation systems.</source>
<target xml:space="preserve"></target>
<context-group>
