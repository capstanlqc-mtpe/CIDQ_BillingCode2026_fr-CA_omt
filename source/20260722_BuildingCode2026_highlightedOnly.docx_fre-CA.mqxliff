<mq:originalsource edited="false" />
</trans-unit>
<trans-unit id="2641" mq:status="NotStarted" mq:segmentguid="1dd54bf4-3732-44a2-aff7-d1568e379cee" mq:lastchangedtimestamp="0001-01-01T00:00:00Z" mq:maxlengthchars="-1" mq:nosplitjoin="false" mq:firstlabel="2175" mq:lastlabel="2175" mq:autosplitjoinstate="0" mq:lastmodifrole="0" mq:multipleexactmatch="false">
<source xml:space="preserve" mq:segpart="2175" mq:hasfollowingobject="hasfollowingobject">The number of Type A units shall be determined in accordance with Section 1108.6.2.2.1.</source>
<target xml:space="preserve"></target>
<context-group>
<context context-type="x-mmq-structural-context">trans-units / trans-unit#6131 / struct-rpr#1</context>
