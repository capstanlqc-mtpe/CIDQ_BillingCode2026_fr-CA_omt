<trans-unit id="390" mq:status="NotStarted" mq:segmentguid="3a95532e-291f-4d5c-8d46-1a26cee12566" mq:lastchangedtimestamp="0001-01-01T00:00:00Z" mq:maxlengthchars="-1" mq:nosplitjoin="false" mq:firstlabel="326" mq:lastlabel="326" mq:autosplitjoinstate="0" mq:lastmodifrole="0" mq:multipleexactmatch="false">
<source xml:space="preserve" mq:segpart="326" mq:hasfollowingobject="hasfollowingobject">Each riser shall supply sprinklers on alternate floors.</source>
<target xml:space="preserve"></target>
<context-group>
