<source xml:space="preserve" mq:segpart="1021" mq:hasfollowingobject="hasfollowingobject">Exceptions:</source>
<target xml:space="preserve"></target>
<context-group>
<context context-type="x-mmq-structural-context">trans-units / trans-unit#4169 / struct-rpr#1</context>
</context-group>
