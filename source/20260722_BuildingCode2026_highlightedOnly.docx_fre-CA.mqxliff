<source xml:space="preserve" mq:segpart="3795" mq:hasfollowingobject="hasfollowingobject">Characters shall be separated from raised borders and decorative elements 3/8 inch (9.5 mm) minimum.<ph id="1">&lt;/rpr id=&quot;5&quot; transform=&quot;close&quot;&gt;</ph></source>
