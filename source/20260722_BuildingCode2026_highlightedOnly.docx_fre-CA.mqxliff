<trans-unit id="875" mq:status="NotStarted" mq:segmentguid="d872042b-127e-4844-891e-d75df5a3b62f" mq:lastchangedtimestamp="0001-01-01T00:00:00Z" mq:maxlengthchars="-1" mq:nosplitjoin="false" mq:firstlabel="721" mq:lastlabel="721" mq:autosplitjoinstate="0" mq:lastmodifrole="0" mq:multipleexactmatch="false">
<source xml:space="preserve" mq:segpart="721" mq:hasfollowingobject="hasfollowingobject">Protection by a draft curtain and closely spaced sprinklers in accordance with NFPA 13 shall be permitted where the area of the vertical opening between stories does not exceed twice the horizontal projected area of the escalator.</source>
<target xml:space="preserve"></target>
<context-group>
<context context-type="x-mmq-structural-context">trans-units / trans-unit#3482 / struct-rpr#1</context>
</context-group>
<mq:startingws xml:space="preserve" />
<mq:endingws xml:space="preserve"> </mq:endingws>
