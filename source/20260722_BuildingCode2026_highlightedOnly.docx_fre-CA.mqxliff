<mq:endingws xml:space="preserve"> </mq:endingws>
<mq:commitinfos xmlns="MQXliff" /><mq:nosplitjoins />
<mq:originalsource edited="false" />
</trans-unit>
<trans-unit id="721" mq:status="NotStarted" mq:segmentguid="435e4b02-34ea-48af-ab29-b0ba574c59c1" mq:lastchangedtimestamp="0001-01-01T00:00:00Z" mq:maxlengthchars="-1" mq:nosplitjoin="false" mq:firstlabel="591" mq:lastlabel="591" mq:autosplitjoinstate="0" mq:lastmodifrole="0" mq:multipleexactmatch="false">
<source xml:space="preserve" mq:segpart="591" mq:hasfollowingobject="hasfollowingobject">The provisions of this code applicable to the aggregate building shall be applicable to each building.</source>
<target xml:space="preserve"></target>
<context-group>
