<source xml:space="preserve" mq:segpart="3883" mq:hasfollowingobject="hasfollowingobject">Where spectators are expected to remain seated for purposes of viewing events, spectators in wheelchair space locations shall be provided with a line of sight in accordance with Section 802.9.1.</source>
<target xml:space="preserve"></target>
<context-group>
<context context-type="x-mmq-structural-context">trans-units / trans-unit#8833 / struct-rpr#1</context>
</context-group>
<mq:startingws xml:space="preserve" />
<mq:endingws xml:space="preserve"> </mq:endingws>
<mq:commitinfos xmlns="MQXliff" /><mq:nosplitjoins />
<mq:originalsource edited="false" />
