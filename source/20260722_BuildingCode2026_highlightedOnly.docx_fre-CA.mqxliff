<source xml:space="preserve" mq:segpart="3287" mq:hasfollowingobject="hasfollowingobject">The function button shall be located immediately below the keypad arrangement or floor buttons.<ph id="1">&lt;/rpr id=&quot;65&quot; transform=&quot;close&quot;&gt;</ph></source>
