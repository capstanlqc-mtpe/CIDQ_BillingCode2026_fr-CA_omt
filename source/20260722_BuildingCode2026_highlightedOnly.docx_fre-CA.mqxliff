<mq:originalsource edited="false" />
</trans-unit>
<trans-unit id="3706" mq:status="NotStarted" mq:segmentguid="f946e5d9-d3df-4698-b3a2-f178b5b69ccf" mq:lastchangedtimestamp="0001-01-01T00:00:00Z" mq:maxlengthchars="-1" mq:nosplitjoin="false" mq:firstlabel="2973" mq:lastlabel="2973" mq:autosplitjoinstate="0" mq:lastmodifrole="0" mq:multipleexactmatch="false">
<source xml:space="preserve" mq:segpart="2973" mq:hasfollowingobject="hasfollowingobject">For chimneys more than 40 inches (1016 mm) wide, two additional No. 4 vertical bars shall be provided for each additional flue incorporated into the chimney or for each additional 40 inches (1016 mm) in width or fraction thereof.</source>
