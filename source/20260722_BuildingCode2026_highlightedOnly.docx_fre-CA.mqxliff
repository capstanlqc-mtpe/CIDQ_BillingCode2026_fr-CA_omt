<trans-unit id="2448" mq:status="NotStarted" mq:segmentguid="df1ac8f7-0b1c-4e15-8cac-1e8882490f21" mq:lastchangedtimestamp="0001-01-01T00:00:00Z" mq:maxlengthchars="-1" mq:nosplitjoin="false" mq:firstlabel="2013" mq:lastlabel="2013" mq:autosplitjoinstate="0" mq:lastmodifrole="0" mq:multipleexactmatch="false">
<source xml:space="preserve" mq:segpart="2013" mq:hasfollowingobject="hasfollowingobject">In addition to the other requirements of this chapter, occupancies having dwelling units or sleeping units shall be provided with accessible features in accordance with this section.</source>
<target xml:space="preserve"></target>
