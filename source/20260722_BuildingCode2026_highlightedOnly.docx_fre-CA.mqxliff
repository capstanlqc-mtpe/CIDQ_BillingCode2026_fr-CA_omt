<source xml:space="preserve" mq:segpart="1711" mq:hasfollowingobject="hasfollowingobject">Portions of an aisle accessway having a length not exceeding 6 feet (1829 mm) and used by a total of not more than four persons.</source>
<target xml:space="preserve"></target>
<context-group>
<context context-type="x-mmq-structural-context">trans-units / trans-unit#5675 / struct-rpr#1</context>
