<trans-unit id="3845" mq:status="NotStarted" mq:segmentguid="9a07f603-36ef-4091-b1f8-9582630d758f" mq:lastchangedtimestamp="0001-01-01T00:00:00Z" mq:maxlengthchars="-1" mq:nosplitjoin="false" mq:firstlabel="3052" mq:lastlabel="3052" mq:autosplitjoinstate="0" mq:lastmodifrole="0" mq:multipleexactmatch="false">
<source xml:space="preserve" mq:segpart="3052" mq:hasfollowingobject="hasfollowingobject">Where a range, counter-mounted cooking unit, or sink is installed in an island or peninsular countertop and the depth of the countertop behind the range, counter-mounted cooking unit, or sink is less than 12 inches (305 mm), the range, counter-mounted cooking unit, or sink has divided the countertop space into two separate countertop spaces as defined in Section E3901.4.4.</source>
<target xml:space="preserve"></target>
