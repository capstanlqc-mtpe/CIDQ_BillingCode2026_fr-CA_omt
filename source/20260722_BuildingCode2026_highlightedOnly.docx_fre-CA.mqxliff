<trans-unit id="4216" mq:status="NotStarted" mq:segmentguid="c900736d-ed39-4973-9818-6ae680fb5f2b" mq:lastchangedtimestamp="0001-01-01T00:00:00Z" mq:maxlengthchars="-1" mq:nosplitjoin="false" mq:firstlabel="3287" mq:lastlabel="3287" mq:autosplitjoinstate="0" mq:lastmodifrole="0" mq:multipleexactmatch="false">
<source xml:space="preserve" mq:segpart="3287" mq:hasfollowingobject="hasfollowingobject">The indication shall be three raised dots, spaced 1/4 inch (6.4 mm) at base diameter, in the form of an equilateral triangle.</source>
<target xml:space="preserve"></target>
<context-group>
<context context-type="x-mmq-structural-context">trans-units / trans-unit#7980</context>
</context-group>
