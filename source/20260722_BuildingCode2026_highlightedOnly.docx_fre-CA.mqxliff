<trans-unit id="2219" mq:status="NotStarted" mq:segmentguid="39072130-3f38-4abb-a49b-15efd1f931fc" mq:lastchangedtimestamp="0001-01-01T00:00:00Z" mq:maxlengthchars="-1" mq:nosplitjoin="false" mq:firstlabel="1818" mq:lastlabel="1818" mq:autosplitjoinstate="0" mq:lastmodifrole="0" mq:multipleexactmatch="false">
<source xml:space="preserve" mq:segpart="1818" mq:hasfollowingobject="hasfollowingobject">Where a stepped aisle is required to have two handrails, the mid-aisle handrails shall be discontinuous.</source>
<target xml:space="preserve"></target>
<context-group>
<context context-type="x-mmq-structural-context">trans-units / trans-unit#5782 / struct-rpr#1</context>
</context-group>
<mq:startingws xml:space="preserve" />
<mq:endingws xml:space="preserve"> </mq:endingws>
<mq:commitinfos xmlns="MQXliff" /><mq:nosplitjoins />
<mq:originalsource edited="false" />
</trans-unit>
<trans-unit id="2220" mq:status="NotStarted" mq:segmentguid="7a54be0f-a4fc-4ea3-a7de-ef769265622a" mq:lastchangedtimestamp="0001-01-01T00:00:00Z" mq:maxlengthchars="-1" mq:nosplitjoin="false" mq:firstlabel="1818" mq:lastlabel="1818" mq:autosplitjoinstate="0" mq:lastmodifrole="0" mq:multipleexactmatch="false">
<source xml:space="preserve" mq:segpart="1818" mq:hasfollowingobject="hasfollowingobject">Gaps or breaks shall be provided at intervals not exceeding five rows to facilitate access to seating and to permit crossing from one side of the aisle to the other.</source>
<target xml:space="preserve"></target>
<context-group>
<context context-type="x-mmq-structural-context">trans-units / trans-unit#5782 / struct-rpr#1</context>
</context-group>
<mq:startingws xml:space="preserve" />
<mq:endingws xml:space="preserve"> </mq:endingws>
<mq:commitinfos xmlns="MQXliff" /><mq:nosplitjoins />
<mq:originalsource edited="false" />
</trans-unit>
<trans-unit id="2221" mq:status="NotStarted" mq:segmentguid="314a234d-5bf6-4fe8-9705-eb119ee744b8" mq:lastchangedtimestamp="0001-01-01T00:00:00Z" mq:maxlengthchars="-1" mq:nosplitjoin="false" mq:firstlabel="1818" mq:lastlabel="1818" mq:autosplitjoinstate="0" mq:lastmodifrole="0" mq:multipleexactmatch="false">
<source xml:space="preserve" mq:segpart="1818" mq:hasfollowingobject="hasfollowingobject">These gaps or breaks shall have a clear width of not less than 22 inches (559 mm) and not greater than 36 inches (914 mm), measured horizontally, and the mid-aisle handrail shall have rounded terminations or bends.</source>
<target xml:space="preserve"></target>
<context-group>
