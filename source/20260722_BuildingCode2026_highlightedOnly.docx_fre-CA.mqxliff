<source xml:space="preserve" mq:segpart="2971" mq:hasfollowingobject="hasfollowingobject">Reinforcing shall conform to the requirements set forth in Table R1001.1 and Section R606.</source>
<target xml:space="preserve"></target>
<context-group>
