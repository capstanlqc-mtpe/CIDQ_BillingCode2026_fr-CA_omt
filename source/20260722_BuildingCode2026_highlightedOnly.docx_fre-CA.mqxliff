<source xml:space="preserve" mq:segpart="289" mq:hasfollowingobject="hasfollowingobject"><bpt id="1" rid="1">&lt;rpr id=&quot;12&quot;&gt;</bpt>Where special inspections are provided in accordance with Section 1705.1.1, Item 3.<ept id="2" rid="1">&lt;/rpr id=&quot;12&quot; transform=&quot;close&quot;&gt;</ept></source>
