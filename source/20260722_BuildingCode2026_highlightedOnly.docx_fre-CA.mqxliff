<trans-unit id="128" mq:status="NotStarted" mq:segmentguid="12a51b20-74ec-406c-9a91-3937d837ccac" mq:lastchangedtimestamp="0001-01-01T00:00:00Z" mq:maxlengthchars="-1" mq:nosplitjoin="false" mq:firstlabel="102" mq:lastlabel="102" mq:autosplitjoinstate="0" mq:lastmodifrole="0" mq:multipleexactmatch="false">
<source xml:space="preserve" mq:segpart="102" mq:hasfollowingobject="hasfollowingobject">The construction documents submitted with the application for permit shall be accompanied by a site plan showing to scale the size and location of new construction and existing structures on the site, distances from lot lines, the established street grades and the proposed finished grades and, as applicable, flood hazard areas, floodways, and design flood elevations; and it shall be drawn in accordance with an accurate boundary line survey.</source>
<target xml:space="preserve"></target>
<context-group>
