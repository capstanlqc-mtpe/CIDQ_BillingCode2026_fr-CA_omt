<trans-unit id="515" mq:status="NotStarted" mq:segmentguid="027a0251-dc41-4680-8831-cc69c4c7572f" mq:lastchangedtimestamp="0001-01-01T00:00:00Z" mq:maxlengthchars="-1" mq:nosplitjoin="false" mq:firstlabel="451" mq:lastlabel="451" mq:autosplitjoinstate="0" mq:lastmodifrole="0" mq:multipleexactmatch="false">
<source xml:space="preserve" mq:segpart="451" mq:hasfollowingobject="hasfollowingobject">Each sprinkler system zone in buildings that are more than 420 feet (128 m) in building height shall be supplied by not fewer than two risers.</source>
<target xml:space="preserve"></target>
<context-group>
