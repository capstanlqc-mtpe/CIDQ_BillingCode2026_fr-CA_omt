<mq:originalsource edited="false" />
</trans-unit>
<trans-unit id="524" mq:status="NotStarted" mq:segmentguid="1a178c22-fc82-484e-a930-79a2d3873686" mq:lastchangedtimestamp="0001-01-01T00:00:00Z" mq:maxlengthchars="-1" mq:nosplitjoin="false" mq:firstlabel="433" mq:lastlabel="433" mq:autosplitjoinstate="0" mq:lastmodifrole="0" mq:multipleexactmatch="false">
<source xml:space="preserve" mq:segpart="433" mq:hasfollowingobject="hasfollowingobject">Where glass doors are provided in the glass wall, they shall be either self-closing or automatic-closing.</source>
<target xml:space="preserve"></target>
<context-group>
<context context-type="x-mmq-structural-context">trans-units / trans-unit#807 / struct-rpr#1</context>
</context-group>
<mq:startingws xml:space="preserve" />
<mq:endingws xml:space="preserve" />
<mq:commitinfos xmlns="MQXliff" /><mq:nosplitjoins />
<mq:originalsource edited="false" />
</trans-unit>
<trans-unit id="525" mq:status="NotStarted" mq:segmentguid="ee484209-58d4-40f8-b933-40f41b21c0de" mq:lastchangedtimestamp="0001-01-01T00:00:00Z" mq:maxlengthchars="-1" mq:nosplitjoin="false" mq:firstlabel="434" mq:lastlabel="434" mq:autosplitjoinstate="0" mq:lastmodifrole="0" mq:multipleexactmatch="false">
<source xml:space="preserve" mq:segpart="434" mq:hasfollowingobject="hasfollowingobject">A fire barrier is not required where a glass-block wall assembly complying with Section 2110 and having a 3/4-hour fire protection rating is provided.</source>
<target xml:space="preserve"></target>
<context-group>
<context context-type="x-mmq-structural-context">trans-units / trans-unit#808 / struct-rpr#1</context>
</context-group>
<mq:startingws xml:space="preserve" />
<mq:endingws xml:space="preserve" />
<mq:commitinfos xmlns="MQXliff" /><mq:nosplitjoins />
<mq:originalsource edited="false" />
</trans-unit>
<trans-unit id="526" mq:status="NotStarted" mq:segmentguid="7edfa370-a5d6-4dcc-9c7c-363d4d94498d" mq:lastchangedtimestamp="0001-01-01T00:00:00Z" mq:maxlengthchars="-1" mq:nosplitjoin="false" mq:firstlabel="435" mq:lastlabel="435" mq:autosplitjoinstate="0" mq:lastmodifrole="0" mq:multipleexactmatch="false">
<source xml:space="preserve" mq:segpart="435" mq:hasfollowingobject="hasfollowingobject">A fire barrier is not required between the atrium and the adjoining spaces of up to three floors of the atrium provided that such spaces are accounted for in the design of the smoke control system.</source>
<target xml:space="preserve"></target>
<context-group>
<context context-type="x-mmq-structural-context">trans-units / trans-unit#809 / struct-rpr#1</context>
</context-group>
<mq:startingws xml:space="preserve" />
<mq:endingws xml:space="preserve" />
<mq:commitinfos xmlns="MQXliff" /><mq:nosplitjoins />
<mq:originalsource edited="false" />
</trans-unit>
<trans-unit id="527" mq:status="NotStarted" mq:segmentguid="be12dd6e-378e-4512-8d5f-9eb48551ed5d" mq:lastchangedtimestamp="0001-01-01T00:00:00Z" mq:maxlengthchars="-1" mq:nosplitjoin="false" mq:firstlabel="436" mq:lastlabel="436" mq:autosplitjoinstate="0" mq:lastmodifrole="0" mq:multipleexactmatch="false">
<source xml:space="preserve" mq:segpart="436" mq:hasfollowingobject="hasfollowingobject">A fire barrier is not required between the atrium and the adjoining spaces where the atrium is not required to be provided with a smoke control system.</source>
<target xml:space="preserve"></target>
<context-group>
<context context-type="x-mmq-structural-context">trans-units / trans-unit#810 / struct-rpr#1</context>
</context-group>
<mq:startingws xml:space="preserve" />
<mq:endingws xml:space="preserve" />
<mq:commitinfos xmlns="MQXliff" /><mq:nosplitjoins />
<mq:originalsource edited="false" />
</trans-unit>
<trans-unit id="528" mq:status="NotStarted" mq:segmentguid="fd79f0a6-886a-4b46-97ac-dd78246cf5bb" mq:lastchangedtimestamp="0001-01-01T00:00:00Z" mq:maxlengthchars="-1" mq:nosplitjoin="false" mq:firstlabel="437" mq:lastlabel="437" mq:autosplitjoinstate="0" mq:lastmodifrole="0" mq:multipleexactmatch="false">
<source xml:space="preserve" mq:segpart="437" mq:hasfollowingobject="hasfollowingobject">A horizontal assembly is not required between the atrium and openings for escalators complying with Section 712.1.3.</source>
<target xml:space="preserve"></target>
<context-group>
<context context-type="x-mmq-structural-context">trans-units / trans-unit#811 / struct-rpr#1</context>
</context-group>
