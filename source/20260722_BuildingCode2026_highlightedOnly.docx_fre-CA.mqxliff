<trans-unit id="591" mq:status="NotStarted" mq:segmentguid="6086386c-fdde-437f-814e-c9fdbec366ea" mq:lastchangedtimestamp="0001-01-01T00:00:00Z" mq:maxlengthchars="-1" mq:nosplitjoin="false" mq:firstlabel="486" mq:lastlabel="486" mq:autosplitjoinstate="0" mq:lastmodifrole="0" mq:multipleexactmatch="false">
<source xml:space="preserve" mq:segpart="486" mq:hasfollowingobject="hasfollowingobject">Where the space beneath the permanent platform is used only for equipment, wiring or plumbing, the underside of the permanent platform need not be protected.</source>
<target xml:space="preserve"></target>
