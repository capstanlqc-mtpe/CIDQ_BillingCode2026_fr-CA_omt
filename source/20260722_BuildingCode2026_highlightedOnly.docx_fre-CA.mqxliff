<trans-unit id="5065" mq:status="NotStarted" mq:segmentguid="d4a30ff9-f865-442a-aa95-694a8f14dca8" mq:lastchangedtimestamp="0001-01-01T00:00:00Z" mq:maxlengthchars="-1" mq:nosplitjoin="false" mq:firstlabel="3883" mq:lastlabel="3883" mq:autosplitjoinstate="0" mq:lastmodifrole="0" mq:multipleexactmatch="false">
<source xml:space="preserve" mq:segpart="3883" mq:hasfollowingobject="hasfollowingobject">Where spectators in front of the wheelchair space locations will be expected to stand at their seats for purposes of viewing events, spectators in wheelchair space locations shall be provided with a line of sight in accordance with Section 802.9.2.</source>
<target xml:space="preserve"></target>
<context-group>
<context context-type="x-mmq-structural-context">trans-units / trans-unit#8833 / struct-rpr#1</context>
</context-group>
