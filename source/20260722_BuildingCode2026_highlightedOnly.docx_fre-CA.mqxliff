<trans-unit id="563" mq:status="NotStarted" mq:segmentguid="86b5e430-c33b-44de-9f68-24afd6fe9158" mq:lastchangedtimestamp="0001-01-01T00:00:00Z" mq:maxlengthchars="-1" mq:nosplitjoin="false" mq:firstlabel="469" mq:lastlabel="469" mq:autosplitjoinstate="0" mq:lastmodifrole="0" mq:multipleexactmatch="false">
<source xml:space="preserve" mq:segpart="469" mq:hasfollowingobject="hasfollowingobject">Beams designed only for the attachment of portable or fixed theater equipment, gridirons, galleries and catwalks shall be constructed of approved materials consistent with the requirements for the type of construction of the building; and a fire-resistance rating shall not be required.</source>
<target xml:space="preserve"></target>
<context-group>
<context context-type="x-mmq-structural-context">trans-units / trans-unit#842 / struct-rpr#1</context>
</context-group>
<mq:startingws xml:space="preserve" />
<mq:endingws xml:space="preserve"> </mq:endingws>
<mq:commitinfos xmlns="MQXliff" /><mq:nosplitjoins />
<mq:originalsource edited="false" />
</trans-unit>
<trans-unit id="564" mq:status="NotStarted" mq:segmentguid="6fdb01e3-3ae2-4f66-a7cd-a2cd6e4d708c" mq:lastchangedtimestamp="0001-01-01T00:00:00Z" mq:maxlengthchars="-1" mq:nosplitjoin="false" mq:firstlabel="469" mq:lastlabel="469" mq:autosplitjoinstate="0" mq:lastmodifrole="0" mq:multipleexactmatch="false">
<source xml:space="preserve" mq:segpart="469" mq:hasfollowingobject="hasfollowingobject">These areas shall not be considered to be floors, stories, mezzanines or levels in applying this code.</source>
<target xml:space="preserve"></target>
<context-group>
<context context-type="x-mmq-structural-context">trans-units / trans-unit#842 / struct-rpr#1</context>
</context-group>
