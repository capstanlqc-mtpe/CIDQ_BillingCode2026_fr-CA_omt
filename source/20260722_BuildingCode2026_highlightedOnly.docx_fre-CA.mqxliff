<source xml:space="preserve" mq:segpart="2551" mq:hasfollowingobject="hasfollowingobject">Habitable rooms shall have an aggregate glazing area of not less than 8 percent of the floor area of such rooms.</source>
<target xml:space="preserve"></target>
