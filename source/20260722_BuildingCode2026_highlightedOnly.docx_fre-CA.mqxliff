<mq:originalsource edited="false" />
</trans-unit>
<trans-unit id="648" mq:status="NotStarted" mq:segmentguid="a7fb0865-9234-4382-9bd0-5dbb7e391b86" mq:lastchangedtimestamp="0001-01-01T00:00:00Z" mq:maxlengthchars="-1" mq:nosplitjoin="false" mq:firstlabel="556" mq:lastlabel="556" mq:autosplitjoinstate="0" mq:lastmodifrole="0" mq:multipleexactmatch="false">
<source xml:space="preserve" mq:segpart="556" mq:hasfollowingobject="hasfollowingobject">The sprinkler system shall be designed so that the entire surface of the glass is wet upon activation of the sprinkler system without obstruction;</source>
<target xml:space="preserve"></target>
<context-group>
<context context-type="x-mmq-structural-context">trans-units / trans-unit#543 / struct-rpr#1</context>
</context-group>
