<mq:commitinfos xmlns="MQXliff" /><mq:nosplitjoins />
<mq:originalsource edited="false" />
</trans-unit>
<trans-unit id="469" mq:status="NotStarted" mq:segmentguid="9f976407-b1e3-4f16-ad3e-1718d7693bc7" mq:lastchangedtimestamp="0001-01-01T00:00:00Z" mq:maxlengthchars="-1" mq:nosplitjoin="false" mq:firstlabel="387" mq:lastlabel="387" mq:autosplitjoinstate="0" mq:lastmodifrole="0" mq:multipleexactmatch="false">
<source xml:space="preserve" mq:segpart="387" mq:hasfollowingobject="hasfollowingobject">The total capacity of any combination of remaining interior exit stairways with one interior exit stairway removed shall be not less than the total capacity required by Section 1005.1.</source>
<target xml:space="preserve"></target>
<context-group>
<context context-type="x-mmq-structural-context">trans-units / trans-unit#762 / struct-rpr#1</context>
</context-group>
<mq:startingws xml:space="preserve" />
