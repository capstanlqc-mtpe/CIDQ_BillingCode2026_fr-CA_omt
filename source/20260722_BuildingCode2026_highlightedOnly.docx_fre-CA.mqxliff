<trans-unit id="3716" mq:status="NotStarted" mq:segmentguid="c703975d-61d6-44bd-bb19-f720d5f856fe" mq:lastchangedtimestamp="0001-01-01T00:00:00Z" mq:maxlengthchars="-1" mq:nosplitjoin="false" mq:firstlabel="2979" mq:lastlabel="2979" mq:autosplitjoinstate="0" mq:lastmodifrole="0" mq:multipleexactmatch="false">
<source xml:space="preserve" mq:segpart="2979" mq:hasfollowingobject="hasfollowingobject">Each strap shall be fastened to not less than four floor ceiling or floor joists or rafters with two 1/2-inch (12.7 mm) bolts.</source>
<target xml:space="preserve"></target>
<context-group>
<context context-type="x-mmq-structural-context">trans-units / trans-unit#7057 / struct-rpr#1</context>
