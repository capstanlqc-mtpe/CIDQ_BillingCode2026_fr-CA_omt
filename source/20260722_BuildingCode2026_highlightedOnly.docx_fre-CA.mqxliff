<source xml:space="preserve" mq:segpart="2975" mq:hasfollowingobject="hasfollowingobject">Vertical reinforcement shall be placed within 1/4-inch (6.4 mm) ties, or other reinforcing of equivalent net cross-sectional area, placed in the bed joints in accordance with Section R606 at not less than every 18 inches (457 mm) of vertical height.</source>
<target xml:space="preserve"></target>
<context-group>
<context context-type="x-mmq-structural-context">trans-units / trans-unit#7053 / struct-rpr#1</context>
</context-group>
