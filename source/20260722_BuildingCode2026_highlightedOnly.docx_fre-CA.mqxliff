<trans-unit id="725" mq:status="NotStarted" mq:segmentguid="fc570c6f-fa1d-4c7f-80b9-9ec77efe5b4a" mq:lastchangedtimestamp="0001-01-01T00:00:00Z" mq:maxlengthchars="-1" mq:nosplitjoin="false" mq:firstlabel="595" mq:lastlabel="595" mq:autosplitjoinstate="0" mq:lastmodifrole="0" mq:multipleexactmatch="false">
<source xml:space="preserve" mq:segpart="595" mq:hasfollowingobject="hasfollowingobject">A roof level or portion thereof shall be permitted to be used as an occupied roof provided the occupancy of the roof is an occupancy that is permitted by Table 504.4 for the story immediately below the roof.</source>
<target xml:space="preserve"></target>
<context-group>
<context context-type="x-mmq-structural-context">trans-units / trans-unit#968 / struct-rpr#1</context>
