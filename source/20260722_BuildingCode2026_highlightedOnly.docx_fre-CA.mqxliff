<trans-unit id="5130" mq:status="NotStarted" mq:segmentguid="cfad736f-9b5b-4c2e-a026-d2c145455c40" mq:lastchangedtimestamp="0001-01-01T00:00:00Z" mq:maxlengthchars="-1" mq:nosplitjoin="false" mq:firstlabel="3945" mq:lastlabel="3945" mq:autosplitjoinstate="0" mq:lastmodifrole="0" mq:multipleexactmatch="false">
<source xml:space="preserve" mq:segpart="3945" mq:hasfollowingobject="hasfollowingobject"><bpt id="1" ctype="x-sup">{}</bpt>3<ept id="1">{}</ept>Seating treads less than 33 inches (840 mm) in depth shall not be permitted with risers greater than 18 inches (455 mm) in height.</source>
<target xml:space="preserve"></target>
