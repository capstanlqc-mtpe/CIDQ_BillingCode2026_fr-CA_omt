<trans-unit id="398" mq:status="NotStarted" mq:segmentguid="5bc0859a-6f74-4fae-a7e5-097292f972e7" mq:lastchangedtimestamp="0001-01-01T00:00:00Z" mq:maxlengthchars="-1" mq:nosplitjoin="false" mq:firstlabel="342" mq:lastlabel="342" mq:autosplitjoinstate="0" mq:lastmodifrole="0" mq:multipleexactmatch="false">
<source xml:space="preserve" mq:segpart="342" mq:hasfollowingobject="hasfollowingobject">Where the building official finds any work regulated by this code being performed in a manner contrary to the provisions of this code or in a dangerous or unsafe manner, the building official is authorized to issue a stop work order.</source>
<target xml:space="preserve"></target>
<context-group>
