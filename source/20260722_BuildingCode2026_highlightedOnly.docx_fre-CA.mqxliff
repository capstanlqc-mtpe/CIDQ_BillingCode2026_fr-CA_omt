<trans-unit id="4214" mq:status="NotStarted" mq:segmentguid="c67d31e2-f173-4d6e-9794-1ea952ca53e2" mq:lastchangedtimestamp="0001-01-01T00:00:00Z" mq:maxlengthchars="-1" mq:nosplitjoin="false" mq:firstlabel="3287" mq:lastlabel="3287" mq:autosplitjoinstate="0" mq:lastmodifrole="0" mq:multipleexactmatch="false">
<source xml:space="preserve" mq:segpart="3287" mq:hasfollowingobject="hasfollowingobject">The function button shall be identified by the International Symbol for Accessibility and a raised indication.</source>
<target xml:space="preserve"></target>
<context-group>
<context context-type="x-mmq-structural-context">trans-units / trans-unit#7980</context>
</context-group>
<mq:startingws xml:space="preserve" />
