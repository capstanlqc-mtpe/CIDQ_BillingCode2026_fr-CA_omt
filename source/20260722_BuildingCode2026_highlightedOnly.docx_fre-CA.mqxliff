<source xml:space="preserve" mq:segpart="2721" mq:hasfollowingobject="hasfollowingobject"><bpt id="1" ctype="bold">{}</bpt>R308.4.4.1 Structural glass baluster panels.<ept id="1">{}</ept></source>
