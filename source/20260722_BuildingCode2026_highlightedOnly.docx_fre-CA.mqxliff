<trans-unit id="522" mq:status="NotStarted" mq:segmentguid="1a34de5a-f473-4154-87f6-1a3adbfc5e6b" mq:lastchangedtimestamp="0001-01-01T00:00:00Z" mq:maxlengthchars="-1" mq:nosplitjoin="false" mq:firstlabel="455" mq:lastlabel="455" mq:autosplitjoinstate="0" mq:lastmodifrole="0" mq:multipleexactmatch="false">
<source xml:space="preserve" mq:segpart="455" mq:hasfollowingobject="hasfollowingobject">Separate supply piping shall be provided between each connection to the water main and the pumps.</source>
<target xml:space="preserve"></target>
<context-group>
