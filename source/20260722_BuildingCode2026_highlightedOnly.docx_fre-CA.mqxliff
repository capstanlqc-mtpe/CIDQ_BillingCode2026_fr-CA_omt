<source xml:space="preserve" mq:segpart="3987" mq:hasfollowingobject="hasfollowingobject">Sign language interpreter stations shall comply with Section 802.11.</source>
<target xml:space="preserve"></target>
<context-group>
<context context-type="x-mmq-structural-context">trans-units / trans-unit#8936 / struct-rpr#1</context>
