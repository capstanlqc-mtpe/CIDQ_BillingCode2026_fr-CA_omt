<source xml:space="preserve" mq:segpart="1482" mq:hasfollowingobject="hasfollowingobject"><bpt id="1" ctype="bold">{}</bpt>1027.6 Exterior exit stairway and ramp protection.<ept id="1">{}</ept></source>
<target xml:space="preserve"></target>
