<trans-unit id="5628" mq:status="NotStarted" mq:segmentguid="03cc8aa1-872f-4acd-8b44-1e1723d389de" mq:lastchangedtimestamp="2026-07-21T07:30:06Z" mq:lastchanginguser="EmmaG" mq:maxlengthchars="-1" mq:nosplitjoin="false" mq:firstlabel="4370" mq:lastlabel="4370" mq:autosplitjoinstate="0" mq:lastmodifrole="0" mq:multipleexactmatch="false">
<source xml:space="preserve" mq:segpart="4370" mq:hasfollowingobject="hasfollowingobject">1.<ph id="1">&lt;mq:ch val=&quot;	&quot; /&gt;</ph>The clear width shall be permitted to be reduced to 32 inches (815 mm) minimum for a length of 24 inches (610 mm) maximum provided the reduced width segments are separated by segments that are 48 inches (1220 mm) minimum in length and 36 inches (915 mm) minimum in width.</source>
<target xml:space="preserve"></target>
<context-group>
