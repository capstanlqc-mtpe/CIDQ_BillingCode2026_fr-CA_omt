<source xml:space="preserve" mq:segpart="816" mq:hasfollowingobject="hasfollowingobject"><bpt id="1" ctype="bold">{}</bpt>805.1.2 Wood finish flooring.<ept id="1">{}</ept></source>
<target xml:space="preserve"></target>
<context-group>
<context context-type="x-mmq-structural-context">trans-units / trans-unit#3966 / struct-rpr#1</context>
</context-group>
