<mq:commitinfos xmlns="MQXliff" /><mq:nosplitjoins />
<mq:originalsource edited="false" />
</trans-unit>
<trans-unit id="599" mq:status="NotStarted" mq:segmentguid="a155c943-af68-4302-bcb9-a80d646a7375" mq:lastchangedtimestamp="0001-01-01T00:00:00Z" mq:maxlengthchars="-1" mq:nosplitjoin="false" mq:firstlabel="492" mq:lastlabel="492" mq:autosplitjoinstate="0" mq:lastmodifrole="0" mq:multipleexactmatch="false">
<source xml:space="preserve" mq:segpart="492" mq:hasfollowingobject="hasfollowingobject">The fire-resistance rating shall be not less than 2 hours for stage heights greater than 50 feet (15 240 mm) and not less than 1 hour for stage heights of 50 feet (15 240 mm) or less.</source>
<target xml:space="preserve"></target>
<context-group>
