<source xml:space="preserve" mq:segpart="389" mq:hasfollowingobject="hasfollowingobject">An additional interior exit stairway shall not be required to be installed in buildings having elevators used for occupant self-evacuation in accordance with Section 3008.</source>
<target xml:space="preserve"></target>
<context-group>
<context context-type="x-mmq-structural-context">trans-units / trans-unit#764 / struct-rpr#1</context>
