<source xml:space="preserve" mq:segpart="208" mq:hasfollowingobject="hasfollowingobject"><bpt id="1" ctype="bold">{}</bpt>[A] 112.1 Connection of service utilities.<ept id="1">{}</ept></source>
<target xml:space="preserve"></target>
<context-group>
