<source xml:space="preserve" mq:segpart="2701" mq:hasfollowingobject="hasfollowingobject">Glazing in an individual fixed or operable panel adjacent to a door shall be considered to be a hazardous location where the bottom exposed edge of the glazing is less than 60 inches (1524 mm) above the floor or walking surface and it meets either of the following conditions:</source>
<target xml:space="preserve"></target>
<context-group>
<context context-type="x-mmq-structural-context">trans-units / trans-unit#6784 / struct-rpr#1</context>
</context-group>
