<trans-unit id="756" mq:status="NotStarted" mq:segmentguid="6b21cc9b-c015-4b67-826f-eebc939d1644" mq:lastchangedtimestamp="0001-01-01T00:00:00Z" mq:maxlengthchars="-1" mq:nosplitjoin="false" mq:firstlabel="617" mq:lastlabel="617" mq:autosplitjoinstate="0" mq:lastmodifrole="0" mq:multipleexactmatch="false">
<source xml:space="preserve" mq:segpart="617" mq:hasfollowingobject="hasfollowingobject">Smoke-barrier walls used to enclose areas of refuge in accordance with Section 1009.6.4, or to enclose elevator lobbies in accordance with Section 405.4.3, 3007.6.2, or 3008.6.2, shall form an effective membrane enclosure that terminates at a fire barrier wall having a level of fire protection rating not less than 1 hour, another smoke barrier wall or an outside wall.</source>
<target xml:space="preserve"></target>
<context-group>
<context context-type="x-mmq-structural-context">trans-units / trans-unit#3381 / struct-rpr#1</context>
</context-group>
