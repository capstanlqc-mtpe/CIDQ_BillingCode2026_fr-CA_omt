<trans-unit id="140" mq:status="NotStarted" mq:segmentguid="9d087dcf-2286-4642-af75-0179dbf0d9cc" mq:lastchangedtimestamp="0001-01-01T00:00:00Z" mq:maxlengthchars="-1" mq:nosplitjoin="false" mq:firstlabel="112" mq:lastlabel="112" mq:autosplitjoinstate="0" mq:lastmodifrole="0" mq:multipleexactmatch="false">
<source xml:space="preserve" mq:segpart="112" mq:hasfollowingobject="hasfollowingobject">When the building official issues a permit, the construction documents shall be approved, in writing or by stamp, as “Reviewed for Code Compliance.”</source>
<target xml:space="preserve"></target>
<context-group>
<context context-type="x-mmq-structural-context">trans-units / trans-unit#112 / struct-rpr#1</context>
