<source xml:space="preserve" mq:segpart="139" mq:hasfollowingobject="hasfollowingobject"><bpt id="1" ctype="bold">{}</bpt>[A] 105.1.2 Annual permit records.<ept id="1">{}</ept></source>
<target xml:space="preserve"></target>
<context-group>
