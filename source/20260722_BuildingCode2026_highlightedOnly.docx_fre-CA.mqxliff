<source xml:space="preserve" mq:segpart="2176" mq:hasfollowingobject="hasfollowingobject"><bpt id="1" ctype="bold">{}</bpt>1108.7.1.1 One story with Type B units required.<ept id="1">{}</ept></source>
<target xml:space="preserve"></target>
<context-group>
<context context-type="x-mmq-structural-context">trans-units / trans-unit#6132 / struct-rpr#1</context>
</context-group>
