<source xml:space="preserve" mq:segpart="516" mq:hasfollowingobject="hasfollowingobject"><bpt id="1" ctype="bold">{}</bpt>403.5.3 Stairway door operation.<ept id="1">{}</ept></source>
<target xml:space="preserve"></target>
