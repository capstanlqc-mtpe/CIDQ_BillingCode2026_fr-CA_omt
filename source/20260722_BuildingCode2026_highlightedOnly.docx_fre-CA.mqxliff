<source xml:space="preserve" mq:segpart="720" mq:hasfollowingobject="hasfollowingobject"><bpt id="1" ctype="bold">{}</bpt>712.1.3.1 Opening size.<ept id="1">{}</ept></source>
<target xml:space="preserve"></target>
