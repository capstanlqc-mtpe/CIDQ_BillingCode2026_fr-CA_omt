<source xml:space="preserve" mq:segpart="1708" mq:hasfollowingobject="hasfollowingobject">Where tables or counters are served by fixed seats, the width of the aisle or aisle accessway shall be measured from the back of the seat.</source>
<target xml:space="preserve"></target>
