<source xml:space="preserve" mq:segpart="117" mq:hasfollowingobject="hasfollowingobject"><bpt id="1" ctype="bold">{}</bpt>[A] 107.3.4 Design professional in responsible charge.<ept id="1">{}</ept></source>
