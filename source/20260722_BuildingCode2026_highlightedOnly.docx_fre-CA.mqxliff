<source xml:space="preserve" mq:segpart="445" mq:hasfollowingobject="hasfollowingobject"><bpt id="1" ctype="bold">{}</bpt>403.2.3 Sprayed fire-resistant materials (SFRM).<ept id="1">{}</ept></source>
