<source xml:space="preserve" mq:segpart="2529" mq:hasfollowingobject="hasfollowingobject">Field tests shall be conducted upon the completion of an installation or following a major alteration of a personnel hoist<ph id="1">&lt;/rpr id=&quot;5&quot; transform=&quot;close&quot;&gt;</ph></source>
