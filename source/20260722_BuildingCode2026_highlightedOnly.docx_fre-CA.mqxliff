<source xml:space="preserve" mq:segpart="1822" mq:hasfollowingobject="hasfollowingobject">Mid-aisle handrails shall not extend beyond the lowest riser and shall terminate within 18 inches (381 mm), measured horizontally, from the lowest riser.</source>
<target xml:space="preserve"></target>
<context-group>
