<source xml:space="preserve" mq:segpart="328" mq:hasfollowingobject="hasfollowingobject">Sprinkler risers shall be placed in interior exit stairways and ramps that are remotely located in accordance with Section 1007.1.</source>
<target xml:space="preserve"></target>
<context-group>
