<trans-unit id="5131" mq:status="NotStarted" mq:segmentguid="107f5810-d5a9-41ed-bd36-dfdcdfac2b38" mq:lastchangedtimestamp="0001-01-01T00:00:00Z" mq:maxlengthchars="-1" mq:nosplitjoin="false" mq:firstlabel="3946" mq:lastlabel="3946" mq:autosplitjoinstate="0" mq:lastmodifrole="0" mq:multipleexactmatch="false">
<source xml:space="preserve" mq:segpart="3946" mq:hasfollowingobject="hasfollowingobject"><bpt id="1" ctype="x-sup">{}</bpt>4<ept id="1">{}</ept>Seating treads less than 44 inches (1120 mm) in depth shall not be permitted with risers greater than 27 inches (685 mm) in height.</source>
