<mq:endingws xml:space="preserve" />
<mq:commitinfos xmlns="MQXliff" /><mq:nosplitjoins />
<mq:originalsource edited="false" />
</trans-unit>
<trans-unit id="1907" mq:status="NotStarted" mq:segmentguid="2b38c027-c36b-4440-a85d-85080c9c5f9f" mq:lastchangedtimestamp="2026-07-21T07:30:06Z" mq:lastchanginguser="EmmaG" mq:maxlengthchars="-1" mq:nosplitjoin="false" mq:firstlabel="1560" mq:lastlabel="1560" mq:autosplitjoinstate="0" mq:lastmodifrole="0" mq:multipleexactmatch="false">
<source xml:space="preserve" mq:segpart="1560" mq:hasfollowingobject="hasfollowingobject">1.<ph id="1">&lt;mq:ch val=&quot;	&quot; /&gt;</ph>Not less than 0.3 inch (7.6 mm) of aisle capacity for each occupant served shall be provided on stepped aisles having riser heights 7 inches (178 mm) or less and tread depths 11 inches (279 mm) or greater, measured horizontally between tread nosings.</source>
<target xml:space="preserve"></target>
<context-group>
<context context-type="x-mmq-structural-context">trans-units / trans-unit#5524 / struct-rpr#1</context>
</context-group>
