<mq:originalsource edited="false" />
</trans-unit>
<trans-unit id="577" mq:status="NotStarted" mq:segmentguid="73db2a36-1e78-436f-b7c7-e192de0565e5" mq:lastchangedtimestamp="0001-01-01T00:00:00Z" mq:maxlengthchars="-1" mq:nosplitjoin="false" mq:firstlabel="479" mq:lastlabel="479" mq:autosplitjoinstate="0" mq:lastmodifrole="0" mq:multipleexactmatch="false">
<source xml:space="preserve" mq:segpart="479" mq:hasfollowingobject="hasfollowingobject"><bpt id="1" ctype="bold">{}</bpt>410.2.7 Stage ventilation.<ept id="1">{}</ept></source>
<target xml:space="preserve"></target>
<context-group>
<context context-type="x-mmq-structural-context">trans-units / trans-unit#852 / struct-rpr#1</context>
</context-group>
<mq:startingws xml:space="preserve" />
