<source xml:space="preserve" mq:segpart="384" mq:hasfollowingobject="hasfollowingobject"><bpt id="1" ctype="bold">{}</bpt>403.5.1 Remoteness of interior exit stairways.<ept id="1">{}</ept></source>
<target xml:space="preserve"></target>
<context-group>
<context context-type="x-mmq-structural-context">trans-units / trans-unit#759 / struct-rpr#1</context>
</context-group>
<mq:startingws xml:space="preserve" />
