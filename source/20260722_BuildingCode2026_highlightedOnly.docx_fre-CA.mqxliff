<trans-unit id="391" mq:status="NotStarted" mq:segmentguid="3d7829cc-9f0e-4b6c-b6f0-4391ba33eb65" mq:lastchangedtimestamp="0001-01-01T00:00:00Z" mq:maxlengthchars="-1" mq:nosplitjoin="false" mq:firstlabel="326" mq:lastlabel="326" mq:autosplitjoinstate="0" mq:lastmodifrole="0" mq:multipleexactmatch="false">
<source xml:space="preserve" mq:segpart="326" mq:hasfollowingobject="hasfollowingobject">If more than two risers are provided for a zone, sprinklers on adjacent floors shall not be supplied from the same riser.</source>
<target xml:space="preserve"></target>
