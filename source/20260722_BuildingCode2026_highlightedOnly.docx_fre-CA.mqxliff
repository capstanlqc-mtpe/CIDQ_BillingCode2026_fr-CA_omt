<mq:commitinfos xmlns="MQXliff" /><mq:nosplitjoins />
<mq:originalsource edited="false" />
</trans-unit>
<trans-unit id="1715" mq:status="NotStarted" mq:segmentguid="ac17081a-8c72-43af-807d-53b4bca2365f" mq:lastchangedtimestamp="0001-01-01T00:00:00Z" mq:maxlengthchars="-1" mq:nosplitjoin="false" mq:firstlabel="1417" mq:lastlabel="1417" mq:autosplitjoinstate="0" mq:lastmodifrole="0" mq:multipleexactmatch="false">
<source xml:space="preserve" mq:segpart="1417" mq:hasfollowingobject="hasfollowingobject">Openings within such exterior walls shall be protected by opening protectives having a fire protection rating of not less than 3/4 hour.</source>
<target xml:space="preserve"></target>
<context-group>
