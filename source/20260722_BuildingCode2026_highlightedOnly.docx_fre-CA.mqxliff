<trans-unit id="5071" mq:status="NotStarted" mq:segmentguid="b524d98e-ef0c-4727-878c-c0f79ba2f95c" mq:lastchangedtimestamp="0001-01-01T00:00:00Z" mq:maxlengthchars="-1" mq:nosplitjoin="false" mq:firstlabel="3887" mq:lastlabel="3887" mq:autosplitjoinstate="0" mq:lastmodifrole="0" mq:multipleexactmatch="false">
<source xml:space="preserve" mq:segpart="3887" mq:hasfollowingobject="hasfollowingobject">Spectators seated in a wheelchair space shall be afforded lines of sight over the heads of seated individuals in the first row in front of the wheelchair space location.</source>
<target xml:space="preserve"></target>
