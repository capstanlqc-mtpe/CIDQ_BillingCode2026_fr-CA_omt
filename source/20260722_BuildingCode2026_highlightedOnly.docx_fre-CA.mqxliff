<source xml:space="preserve" mq:segpart="999" mq:hasfollowingobject="hasfollowingobject">An automatic sprinkler system shall be installed at the top of rubbish and linen chutes and in their terminal rooms.</source>
<target xml:space="preserve"></target>
<context-group>
<context context-type="x-mmq-structural-context">trans-units / trans-unit#4148 / struct-rpr#1</context>
