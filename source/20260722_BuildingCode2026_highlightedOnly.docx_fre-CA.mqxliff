<source xml:space="preserve" mq:segpart="2284" mq:hasfollowingobject="hasfollowingobject">This Section shall apply to common interior walls, partitions and floor/ceiling assemblies between adjacent dwelling units and sleeping units or between dwelling units and sleeping units and adjacent public areas.</source>
<target xml:space="preserve"></target>
<context-group>
