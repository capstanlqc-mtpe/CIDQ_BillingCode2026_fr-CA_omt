<trans-unit id="1902" mq:status="NotStarted" mq:segmentguid="ace49147-5e0a-47e0-8d61-d08abf5abf5d" mq:lastchangedtimestamp="0001-01-01T00:00:00Z" mq:maxlengthchars="-1" mq:nosplitjoin="false" mq:firstlabel="1555" mq:lastlabel="1555" mq:autosplitjoinstate="0" mq:lastmodifrole="0" mq:multipleexactmatch="false">
<source xml:space="preserve" mq:segpart="1555" mq:hasfollowingobject="hasfollowingobject">For balconies, galleries or press boxes having a seating capacity of 50 or more located in a building, room or space used for assembly purposes, not less than two means of egress shall be provided, with one from each side of every balcony, gallery or press box.</source>
<target xml:space="preserve"></target>
