<trans-unit id="2091" mq:status="NotStarted" mq:segmentguid="9e1e9347-101b-4361-8367-bbec29b26e3c" mq:lastchangedtimestamp="0001-01-01T00:00:00Z" mq:maxlengthchars="-1" mq:nosplitjoin="false" mq:firstlabel="1715" mq:lastlabel="1715" mq:autosplitjoinstate="0" mq:lastmodifrole="0" mq:multipleexactmatch="false">
<source xml:space="preserve" mq:segpart="1715" mq:hasfollowingobject="hasfollowingobject">Where seating rows have 14 or fewer seats, the minimum clear aisle accessway width shall be not less than 12 inches (305 mm) measured as the clear horizontal distance from the back of the row ahead and the nearest projection of the row behind.</source>
<target xml:space="preserve"></target>
<context-group>
<context context-type="x-mmq-structural-context">trans-units / trans-unit#5679 / struct-rpr#1</context>
</context-group>
<mq:startingws xml:space="preserve" />
<mq:endingws xml:space="preserve"> </mq:endingws>
<mq:commitinfos xmlns="MQXliff" /><mq:nosplitjoins />
<mq:originalsource edited="false" />
</trans-unit>
<trans-unit id="2092" mq:status="NotStarted" mq:segmentguid="64e0f92b-d366-44a5-bb15-8dab8ee2c784" mq:lastchangedtimestamp="0001-01-01T00:00:00Z" mq:maxlengthchars="-1" mq:nosplitjoin="false" mq:firstlabel="1715" mq:lastlabel="1715" mq:autosplitjoinstate="0" mq:lastmodifrole="0" mq:multipleexactmatch="false">
<source xml:space="preserve" mq:segpart="1715" mq:hasfollowingobject="hasfollowingobject">Where chairs have automatic or self-rising seats, the measurement shall be made with seats in the raised position.</source>
<target xml:space="preserve"></target>
<context-group>
<context context-type="x-mmq-structural-context">trans-units / trans-unit#5679 / struct-rpr#1</context>
</context-group>
<mq:startingws xml:space="preserve" />
<mq:endingws xml:space="preserve"> </mq:endingws>
<mq:commitinfos xmlns="MQXliff" /><mq:nosplitjoins />
<mq:originalsource edited="false" />
</trans-unit>
<trans-unit id="2093" mq:status="NotStarted" mq:segmentguid="3f9d2f58-76d2-4ca2-84b1-e030f911e25a" mq:lastchangedtimestamp="0001-01-01T00:00:00Z" mq:maxlengthchars="-1" mq:nosplitjoin="false" mq:firstlabel="1715" mq:lastlabel="1715" mq:autosplitjoinstate="0" mq:lastmodifrole="0" mq:multipleexactmatch="false">
<source xml:space="preserve" mq:segpart="1715" mq:hasfollowingobject="hasfollowingobject">Where any chair in the row does not have an automatic or self-rising seat, the measurements shall be made with the seat in the down position.</source>
<target xml:space="preserve"></target>
<context-group>
<context context-type="x-mmq-structural-context">trans-units / trans-unit#5679 / struct-rpr#1</context>
</context-group>
<mq:startingws xml:space="preserve" />
<mq:endingws xml:space="preserve"> </mq:endingws>
<mq:commitinfos xmlns="MQXliff" /><mq:nosplitjoins />
<mq:originalsource edited="false" />
</trans-unit>
<trans-unit id="2094" mq:status="NotStarted" mq:segmentguid="9a592308-01e4-47cb-9d3b-dba1ea0117a3" mq:lastchangedtimestamp="0001-01-01T00:00:00Z" mq:maxlengthchars="-1" mq:nosplitjoin="false" mq:firstlabel="1715" mq:lastlabel="1715" mq:autosplitjoinstate="0" mq:lastmodifrole="0" mq:multipleexactmatch="false">
<source xml:space="preserve" mq:segpart="1715" mq:hasfollowingobject="hasfollowingobject">For seats with folding tablet arms, row spacing shall be determined with the tablet arm in the used position.</source>
<target xml:space="preserve"></target>
<context-group>
