<source xml:space="preserve" mq:segpart="1436" mq:hasfollowingobject="hasfollowingobject">The stripes shall be 1 to 2 inches (25 mm to 51 mm) wide with interruptions not exceeding 4 inches (102 mm).</source>
<target xml:space="preserve"></target>
