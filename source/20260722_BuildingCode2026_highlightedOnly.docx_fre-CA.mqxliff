<source xml:space="preserve" mq:segpart="1712" mq:hasfollowingobject="hasfollowingobject"><bpt id="1" ctype="bold">{}</bpt>1030.13.1.2 Seating at table aisle accessway length.<ept id="1">{}</ept></source>
<target xml:space="preserve"></target>
<context-group>
