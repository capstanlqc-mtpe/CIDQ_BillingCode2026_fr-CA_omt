<mq:originalsource edited="false" />
</trans-unit>
<trans-unit id="647" mq:status="NotStarted" mq:segmentguid="e27933b1-d5da-477e-8efe-7c5d8f1798fb" mq:lastchangedtimestamp="0001-01-01T00:00:00Z" mq:maxlengthchars="-1" mq:nosplitjoin="false" mq:firstlabel="556" mq:lastlabel="556" mq:autosplitjoinstate="0" mq:lastmodifrole="0" mq:multipleexactmatch="false">
<source xml:space="preserve" mq:segpart="556" mq:hasfollowingobject="hasfollowingobject">The sprinklers shall be located between 4 inches and 12 inches (102 mm and 305 mm) away from the glass and at intervals along the glass not greater than 6 feet (1829 mm).</source>
<target xml:space="preserve"></target>
<context-group>
<context context-type="x-mmq-structural-context">trans-units / trans-unit#543 / struct-rpr#1</context>
</context-group>
