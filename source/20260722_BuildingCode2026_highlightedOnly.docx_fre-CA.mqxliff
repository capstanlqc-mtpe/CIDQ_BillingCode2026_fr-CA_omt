<source xml:space="preserve" mq:segpart="310" mq:hasfollowingobject="hasfollowingobject"><bpt id="1" ctype="bold">{}</bpt><bpt id="2" rid="1">&lt;rpr id=&quot;15&quot;&gt;</bpt>[A] 111.1 Change of occupancy<ept id="1">{}</ept><ept id="3" rid="1">&lt;/rpr id=&quot;15&quot; transform=&quot;close&quot;&gt;</ept><bpt id="4" rid="2">&lt;rpr id=&quot;12&quot;&gt;</bpt>.<ept id="5" rid="2">&lt;/rpr id=&quot;12&quot; transform=&quot;close&quot;&gt;</ept></source>
