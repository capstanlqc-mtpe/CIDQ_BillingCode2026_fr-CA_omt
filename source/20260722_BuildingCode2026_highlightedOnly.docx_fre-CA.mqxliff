</trans-unit>
<trans-unit id="973" mq:status="NotStarted" mq:segmentguid="22c6e3d4-61d1-4762-a761-2e9e1bd8f588" mq:lastchangedtimestamp="0001-01-01T00:00:00Z" mq:maxlengthchars="-1" mq:nosplitjoin="false" mq:firstlabel="801" mq:lastlabel="801" mq:autosplitjoinstate="0" mq:lastmodifrole="0" mq:multipleexactmatch="false">
<source xml:space="preserve" mq:segpart="801" mq:hasfollowingobject="hasfollowingobject">Test reports confirming the information provided in the manufacturer's product identification shall be furnished to the building official on request.</source>
<target xml:space="preserve"></target>
<context-group>
<context context-type="x-mmq-structural-context">trans-units / trans-unit#3952 / struct-rpr#1</context>
