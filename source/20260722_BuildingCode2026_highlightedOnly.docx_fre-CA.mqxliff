<source xml:space="preserve" mq:segpart="2021" mq:hasfollowingobject="hasfollowingobject">Exterior decks, patios or balconies that are part of Type B units and have impervious surfaces, and that are not more than 4 inches (102 mm) below the finished floor level of the adjacent interior space of the unit.</source>
<target xml:space="preserve"></target>
<context-group>
