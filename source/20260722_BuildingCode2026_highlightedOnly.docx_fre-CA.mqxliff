<trans-unit id="999" mq:status="NotStarted" mq:segmentguid="1388fb97-62ab-4af6-9202-11716c98cac6" mq:lastchangedtimestamp="0001-01-01T00:00:00Z" mq:maxlengthchars="-1" mq:nosplitjoin="false" mq:firstlabel="824" mq:lastlabel="824" mq:autosplitjoinstate="0" mq:lastmodifrole="0" mq:multipleexactmatch="false">
<source xml:space="preserve" mq:segpart="824" mq:hasfollowingobject="hasfollowingobject">Furnishings or decorative materials of an explosive or highly flammable character shall not be used.</source>
<target xml:space="preserve"></target>
<context-group>
<context context-type="x-mmq-structural-context">trans-units / trans-unit#3973 / struct-rpr#1</context>
</context-group>
