<trans-unit id="4212" mq:status="PartiallyEdited" mq:segmentguid="1cbfee57-0006-4b44-b1c3-2f8acd35885a" mq:lastchangedtimestamp="2026-07-17T10:43:10Z" mq:lastchanginguser="EmmaG" mq:maxlengthchars="-1" mq:nosplitjoin="false" mq:firstlabel="3287" mq:lastlabel="3287" mq:autosplitjoinstate="0" mq:lastmodifrole="4" mq:multipleexactmatch="false">
<source xml:space="preserve" mq:segpart="3287" mq:hasfollowingobject="hasfollowingobject">Destination-oriented elevators shall be provided with a visible signal and audible tones, and verbal announcements to indicate which car is responding to a call.</source>
<target xml:space="preserve"></target>
<context-group>
<context context-type="x-mmq-structural-context">trans-units / trans-unit#7980</context>
</context-group>
<mq:startingws xml:space="preserve" />
<mq:endingws xml:space="preserve"> </mq:endingws>
<mq:commitinfos xmlns="MQXliff" /><mq:nosplitjoins />
<mq:originalsource edited="true">Destination-oriented elevators shall be pro- vided with a visible signal and audible tones, and verbal announcements to indicate which car is responding to a call.</mq:originalsource>
</trans-unit>
<trans-unit id="4213" mq:status="NotStarted" mq:segmentguid="625b90a8-2cf4-4b19-aab8-315b6ec1569f" mq:lastchangedtimestamp="0001-01-01T00:00:00Z" mq:maxlengthchars="-1" mq:nosplitjoin="false" mq:firstlabel="3287" mq:lastlabel="3287" mq:autosplitjoinstate="0" mq:lastmodifrole="0" mq:multipleexactmatch="false">
<source xml:space="preserve" mq:segpart="3287" mq:hasfollowingobject="hasfollowingobject">The audible tone and verbal announcement shall be activated by pressing a function button.</source>
<target xml:space="preserve"></target>
<context-group>
<context context-type="x-mmq-structural-context">trans-units / trans-unit#7980</context>
</context-group>
<mq:startingws xml:space="preserve" />
