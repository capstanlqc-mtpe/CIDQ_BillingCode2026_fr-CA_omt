<trans-unit id="650" mq:status="NotStarted" mq:segmentguid="eb6e7179-f097-4a64-b292-9db3fa56e457" mq:lastchangedtimestamp="0001-01-01T00:00:00Z" mq:maxlengthchars="-1" mq:nosplitjoin="false" mq:firstlabel="558" mq:lastlabel="558" mq:autosplitjoinstate="0" mq:lastmodifrole="0" mq:multipleexactmatch="false">
<source xml:space="preserve" mq:segpart="558" mq:hasfollowingobject="hasfollowingobject">Where glass doors are provided in the glass wall, they shall be either self-closing or automatic-closing.</source>
<target xml:space="preserve"></target>
<context-group>
<context context-type="x-mmq-structural-context">trans-units / trans-unit#545 / struct-rpr#1</context>
</context-group>
