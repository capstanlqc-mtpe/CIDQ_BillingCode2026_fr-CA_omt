<source xml:space="preserve" mq:segpart="2987" mq:hasfollowingobject="hasfollowingobject">The firebox of a concrete or masonry fireplace shall have a depth of not less than 20 inches (508 mm).</source>
<target xml:space="preserve"></target>
<context-group>
<context context-type="x-mmq-structural-context">trans-units / trans-unit#7065 / struct-rpr#1</context>
