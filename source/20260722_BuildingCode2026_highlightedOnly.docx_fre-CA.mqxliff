<source xml:space="preserve" mq:segpart="2971" mq:hasfollowingobject="hasfollowingobject">Masonry or concrete chimneys in Seismic Design Category D0, D1 or D2 shall be reinforced.</source>
<target xml:space="preserve"></target>
<context-group>
<context context-type="x-mmq-structural-context">trans-units / trans-unit#7049 / struct-rpr#1</context>
