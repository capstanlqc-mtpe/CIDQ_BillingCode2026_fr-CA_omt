<trans-unit id="3766" mq:status="NotStarted" mq:segmentguid="eb8bccf5-7c6b-48e8-b617-bef5442fae71" mq:lastchangedtimestamp="0001-01-01T00:00:00Z" mq:maxlengthchars="-1" mq:nosplitjoin="false" mq:firstlabel="3005" mq:lastlabel="3005" mq:autosplitjoinstate="0" mq:lastmodifrole="0" mq:multipleexactmatch="false">
<source xml:space="preserve" mq:segpart="3005" mq:hasfollowingobject="hasfollowingobject">Where the fireplace opening is 6 square feet (0.6 m2) or larger, the hearth extension shall extend not less than 20 inches (508 mm) in front of and not less than 12 inches (305 mm) beyond each side of the fireplace opening.</source>
<target xml:space="preserve"></target>
<context-group>
