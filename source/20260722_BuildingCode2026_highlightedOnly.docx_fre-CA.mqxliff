<source xml:space="preserve" mq:segpart="1352" mq:hasfollowingobject="hasfollowingobject"><bpt id="1" ctype="bold">{}</bpt>1023.7 Interior exit stairway and ramp exterior walls.<ept id="1">{}</ept></source>
