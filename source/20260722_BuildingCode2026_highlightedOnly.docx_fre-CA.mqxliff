<source xml:space="preserve" mq:segpart="1373" mq:hasfollowingobject="hasfollowingobject">The smokeproof enclosure shall be permitted to be extended by an exit passageway in accordance with Section 1023.3.</source>
<target xml:space="preserve"></target>
<context-group>
<context context-type="x-mmq-structural-context">trans-units / trans-unit#5329 / struct-rpr#1</context>
