<trans-unit id="1637" mq:status="NotStarted" mq:segmentguid="f4f36e81-cc20-4577-bffb-d8a12c5756fd" mq:lastchangedtimestamp="0001-01-01T00:00:00Z" mq:maxlengthchars="-1" mq:nosplitjoin="false" mq:firstlabel="1357" mq:lastlabel="1357" mq:autosplitjoinstate="0" mq:lastmodifrole="0" mq:multipleexactmatch="false">
<source xml:space="preserve" mq:segpart="1357" mq:hasfollowingobject="hasfollowingobject">A sign shall be provided at each floor landing in an interior exit stairway and ramp connecting more than three stories designating the floor level, the terminus of the top and bottom of the interior exit stairway and ramp and the identification of the stairway or ramp.</source>
<target xml:space="preserve"></target>
<context-group>
