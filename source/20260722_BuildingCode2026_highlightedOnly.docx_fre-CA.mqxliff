<trans-unit id="2673" mq:status="NotStarted" mq:segmentguid="21cd656c-566e-4bdb-bc81-3009ccb202c9" mq:lastchangedtimestamp="0001-01-01T00:00:00Z" mq:maxlengthchars="-1" mq:nosplitjoin="false" mq:firstlabel="2203" mq:lastlabel="2203" mq:autosplitjoinstate="0" mq:lastmodifrole="0" mq:multipleexactmatch="false">
<source xml:space="preserve" mq:segpart="2203" mq:hasfollowingobject="hasfollowingobject">This section is not applicable to toilet and bathing rooms that serve dwelling units or sleeping units that are not required to be accessible by Section 1107.</source>
<target xml:space="preserve"></target>
<context-group>
<context context-type="x-mmq-structural-context">trans-units / trans-unit#6285 / struct-rpr#1</context>
