<source xml:space="preserve" mq:segpart="2969" mq:hasfollowingobject="hasfollowingobject">Cleanout openings located within foundation walls below fireboxes, where provided, shall be equipped with ferrous metal or masonry doors and frames constructed to remain tightly closed except when in use.</source>
<target xml:space="preserve"></target>
<context-group>
<context context-type="x-mmq-structural-context">trans-units / trans-unit#7047 / struct-rpr#1</context>
