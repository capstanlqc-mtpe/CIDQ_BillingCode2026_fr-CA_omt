<trans-unit id="2218" mq:status="NotStarted" mq:segmentguid="5d978102-3590-42ff-8f5b-bc1190d3dccd" mq:lastchangedtimestamp="0001-01-01T00:00:00Z" mq:maxlengthchars="-1" mq:nosplitjoin="false" mq:firstlabel="1818" mq:lastlabel="1818" mq:autosplitjoinstate="0" mq:lastmodifrole="0" mq:multipleexactmatch="false">
<source xml:space="preserve" mq:segpart="1818" mq:hasfollowingobject="hasfollowingobject">Where there is seating on both sides of the aisle, the mid-aisle handrails shall be discontinuous.</source>
<target xml:space="preserve"></target>
<context-group>
<context context-type="x-mmq-structural-context">trans-units / trans-unit#5782 / struct-rpr#1</context>
</context-group>
