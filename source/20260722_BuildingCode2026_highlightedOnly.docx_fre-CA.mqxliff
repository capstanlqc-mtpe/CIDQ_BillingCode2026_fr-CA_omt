<source xml:space="preserve" mq:segpart="1027" mq:hasfollowingobject="hasfollowingobject"><bpt id="1" ctype="bold">{}</bpt>[F] 907.2.1.1 System initiation in Group A occupancies with an occupant load of 1,000 or more.<ept id="1">{}</ept></source>
<target xml:space="preserve"></target>
<context-group>
