<trans-unit id="589" mq:status="NotStarted" mq:segmentguid="c127cb72-8590-40da-8866-89a8d4018b19" mq:lastchangedtimestamp="0001-01-01T00:00:00Z" mq:maxlengthchars="-1" mq:nosplitjoin="false" mq:firstlabel="510" mq:lastlabel="510" mq:autosplitjoinstate="0" mq:lastmodifrole="0" mq:multipleexactmatch="false">
<source xml:space="preserve" mq:segpart="510" mq:hasfollowingobject="hasfollowingobject">Required interior exit stairways shall be separated by a distance not less than 30 feet (9144 mm) or not less than one-fourth of the length of the maximum overall diagonal dimension of the building or area to be served, whichever is less.</source>
<target xml:space="preserve"></target>
<context-group>
<context context-type="x-mmq-structural-context">trans-units / trans-unit#498 / struct-rpr#1</context>
</context-group>
<mq:startingws xml:space="preserve" />
<mq:endingws xml:space="preserve"> </mq:endingws>
<mq:commitinfos xmlns="MQXliff" /><mq:nosplitjoins />
<mq:originalsource edited="false" />
</trans-unit>
<trans-unit id="590" mq:status="NotStarted" mq:segmentguid="083424ee-ed0f-4e19-a730-1ff3793fb86c" mq:lastchangedtimestamp="0001-01-01T00:00:00Z" mq:maxlengthchars="-1" mq:nosplitjoin="false" mq:firstlabel="510" mq:lastlabel="510" mq:autosplitjoinstate="0" mq:lastmodifrole="0" mq:multipleexactmatch="false">
<source xml:space="preserve" mq:segpart="510" mq:hasfollowingobject="hasfollowingobject">The distance shall be measured in a straight line between the nearest points of the enclosure surrounding the interior exit stairways.</source>
<target xml:space="preserve"></target>
<context-group>
<context context-type="x-mmq-structural-context">trans-units / trans-unit#498 / struct-rpr#1</context>
</context-group>
<mq:startingws xml:space="preserve" />
<mq:endingws xml:space="preserve"> </mq:endingws>
<mq:commitinfos xmlns="MQXliff" /><mq:nosplitjoins />
<mq:originalsource edited="false" />
</trans-unit>
<trans-unit id="591" mq:status="NotStarted" mq:segmentguid="a4244eb8-7bc6-4d0f-ba98-69da2ad34743" mq:lastchangedtimestamp="0001-01-01T00:00:00Z" mq:maxlengthchars="-1" mq:nosplitjoin="false" mq:firstlabel="510" mq:lastlabel="510" mq:autosplitjoinstate="0" mq:lastmodifrole="0" mq:multipleexactmatch="false">
<source xml:space="preserve" mq:segpart="510" mq:hasfollowingobject="hasfollowingobject">In buildings with three or more interior exit stairways, not fewer than two of the interior exit stairways shall comply with this section.</source>
<target xml:space="preserve"></target>
<context-group>
<context context-type="x-mmq-structural-context">trans-units / trans-unit#498 / struct-rpr#1</context>
</context-group>
<mq:startingws xml:space="preserve" />
<mq:endingws xml:space="preserve"> </mq:endingws>
<mq:commitinfos xmlns="MQXliff" /><mq:nosplitjoins />
<mq:originalsource edited="false" />
</trans-unit>
<trans-unit id="592" mq:status="NotStarted" mq:segmentguid="babe129a-572f-4c8e-b15e-309835c77bea" mq:lastchangedtimestamp="0001-01-01T00:00:00Z" mq:maxlengthchars="-1" mq:nosplitjoin="false" mq:firstlabel="510" mq:lastlabel="510" mq:autosplitjoinstate="0" mq:lastmodifrole="0" mq:multipleexactmatch="false">
<source xml:space="preserve" mq:segpart="510" mq:hasfollowingobject="hasfollowingobject">Interlocking or scissor stairways shall be counted as one interior exit stairway.</source>
<target xml:space="preserve"></target>
<context-group>
<context context-type="x-mmq-structural-context">trans-units / trans-unit#498 / struct-rpr#1</context>
</context-group>
