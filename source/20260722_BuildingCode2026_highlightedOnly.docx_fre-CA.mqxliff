<trans-unit id="878" mq:status="NotStarted" mq:segmentguid="85521f70-d735-42fb-8d8d-050323fd9a94" mq:lastchangedtimestamp="0001-01-01T00:00:00Z" mq:maxlengthchars="-1" mq:nosplitjoin="false" mq:firstlabel="723" mq:lastlabel="723" mq:autosplitjoinstate="0" mq:lastmodifrole="0" mq:multipleexactmatch="false">
<source xml:space="preserve" mq:segpart="723" mq:hasfollowingobject="hasfollowingobject">Protection of the vertical opening by approved shutters at every penetrated floor shall be permitted in accordance with this section.</source>
<target xml:space="preserve"></target>
<context-group>
<context context-type="x-mmq-structural-context">trans-units / trans-unit#3484 / struct-rpr#1</context>
</context-group>
<mq:startingws xml:space="preserve" />
<mq:endingws xml:space="preserve"> </mq:endingws>
<mq:commitinfos xmlns="MQXliff" /><mq:nosplitjoins />
<mq:originalsource edited="false" />
</trans-unit>
<trans-unit id="879" mq:status="NotStarted" mq:segmentguid="b6cd156c-c828-484e-8ae2-d651560700a0" mq:lastchangedtimestamp="0001-01-01T00:00:00Z" mq:maxlengthchars="-1" mq:nosplitjoin="false" mq:firstlabel="723" mq:lastlabel="723" mq:autosplitjoinstate="0" mq:lastmodifrole="0" mq:multipleexactmatch="false">
<source xml:space="preserve" mq:segpart="723" mq:hasfollowingobject="hasfollowingobject">The shutters shall be of noncombustible construction and have a fire-resistance rating of not less than 1.5 hours.</source>
<target xml:space="preserve"></target>
<context-group>
<context context-type="x-mmq-structural-context">trans-units / trans-unit#3484 / struct-rpr#1</context>
</context-group>
<mq:startingws xml:space="preserve" />
<mq:endingws xml:space="preserve"> </mq:endingws>
<mq:commitinfos xmlns="MQXliff" /><mq:nosplitjoins />
<mq:originalsource edited="false" />
</trans-unit>
<trans-unit id="880" mq:status="NotStarted" mq:segmentguid="8918854f-a2d1-4478-a111-c0e627c74ec6" mq:lastchangedtimestamp="0001-01-01T00:00:00Z" mq:maxlengthchars="-1" mq:nosplitjoin="false" mq:firstlabel="723" mq:lastlabel="723" mq:autosplitjoinstate="0" mq:lastmodifrole="0" mq:multipleexactmatch="false">
<source xml:space="preserve" mq:segpart="723" mq:hasfollowingobject="hasfollowingobject">The shutter shall be so constructed as to close immediately upon the actuation of a smoke detector installed in accordance with Section 907.3.1 and shall completely shut off the well opening.</source>
<target xml:space="preserve"></target>
<context-group>
<context context-type="x-mmq-structural-context">trans-units / trans-unit#3484 / struct-rpr#1</context>
</context-group>
<mq:startingws xml:space="preserve" />
<mq:endingws xml:space="preserve"> </mq:endingws>
<mq:commitinfos xmlns="MQXliff" /><mq:nosplitjoins />
<mq:originalsource edited="false" />
</trans-unit>
<trans-unit id="881" mq:status="NotStarted" mq:segmentguid="d2546327-cd9f-4e37-b7c4-f1aa3d2199ef" mq:lastchangedtimestamp="0001-01-01T00:00:00Z" mq:maxlengthchars="-1" mq:nosplitjoin="false" mq:firstlabel="723" mq:lastlabel="723" mq:autosplitjoinstate="0" mq:lastmodifrole="0" mq:multipleexactmatch="false">
<source xml:space="preserve" mq:segpart="723" mq:hasfollowingobject="hasfollowingobject">Escalators shall cease operation when the shutter begins to close.</source>
<target xml:space="preserve"></target>
<context-group>
<context context-type="x-mmq-structural-context">trans-units / trans-unit#3484 / struct-rpr#1</context>
</context-group>
<mq:startingws xml:space="preserve" />
<mq:endingws xml:space="preserve"> </mq:endingws>
<mq:commitinfos xmlns="MQXliff" /><mq:nosplitjoins />
<mq:originalsource edited="false" />
</trans-unit>
<trans-unit id="882" mq:status="NotStarted" mq:segmentguid="512bf2dd-31ef-4336-b0a9-63b89876c69f" mq:lastchangedtimestamp="0001-01-01T00:00:00Z" mq:maxlengthchars="-1" mq:nosplitjoin="false" mq:firstlabel="723" mq:lastlabel="723" mq:autosplitjoinstate="0" mq:lastmodifrole="0" mq:multipleexactmatch="false">
<source xml:space="preserve" mq:segpart="723" mq:hasfollowingobject="hasfollowingobject">The shutter shall operate at a speed of not more than 30 feet per minute (152.4 mm/s) and shall be equipped with a sensitive leading edge to arrest its progress where in contact with any obstacle, and to continue its progress on release therefrom.</source>
<target xml:space="preserve"></target>
<context-group>
<context context-type="x-mmq-structural-context">trans-units / trans-unit#3484 / struct-rpr#1</context>
