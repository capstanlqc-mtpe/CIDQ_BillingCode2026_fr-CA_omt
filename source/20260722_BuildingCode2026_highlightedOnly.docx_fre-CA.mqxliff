<mq:errorwarning mq:errorwarning-code="02011" mq:errorwarning-categoryid="8" mq:errorwarning-ignorable="errorwarning-ignorable" mq:errorwarning-shorttext="An inline tag is missing from the translated text: mq:ch. Add it to match the source." mq:errorwarning-problemname="missing inline tag" mq:errorwarning-longdesc="" mq:errorwarning-localizationargs="mq:ch" mq:errorwarning-dataspecific="errorwarning-dataspecific" mq:errorwarning-segmenthash="-646921660" mq:errorwarning-combinedposstart="2" mq:errorwarning-combinedposlength="1" mq:errorwarning-posinsource="errorwarning-posinsource" />
