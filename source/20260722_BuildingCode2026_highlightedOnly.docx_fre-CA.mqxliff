<source xml:space="preserve" mq:segpart="1410" mq:hasfollowingobject="hasfollowingobject">Equipment and ductwork for exit passageway ventilation as permitted by Section 1024.6 shall comply with one of the following:</source>
<target xml:space="preserve"></target>
<context-group>
<context context-type="x-mmq-structural-context">trans-units / trans-unit#5365 / struct-rpr#1</context>
</context-group>
<mq:startingws xml:space="preserve" />
<mq:endingws xml:space="preserve" />
<mq:commitinfos xmlns="MQXliff" /><mq:nosplitjoins />
<mq:originalsource edited="false" />
