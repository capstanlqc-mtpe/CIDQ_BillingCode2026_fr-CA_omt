<trans-unit id="142" mq:status="NotStarted" mq:segmentguid="d76ef4a2-ff89-49c0-93d7-b77223d06132" mq:lastchangedtimestamp="0001-01-01T00:00:00Z" mq:maxlengthchars="-1" mq:nosplitjoin="false" mq:firstlabel="112" mq:lastlabel="112" mq:autosplitjoinstate="0" mq:lastmodifrole="0" mq:multipleexactmatch="false">
<source xml:space="preserve" mq:segpart="112" mq:hasfollowingobject="hasfollowingobject">The other set shall be returned to the applicant, shall be kept at the site of work and shall be open to inspection by the building official or a duly authorized representative.</source>
<target xml:space="preserve"></target>
<context-group>
