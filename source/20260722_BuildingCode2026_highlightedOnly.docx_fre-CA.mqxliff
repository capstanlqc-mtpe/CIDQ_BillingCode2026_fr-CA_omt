<trans-unit id="320" mq:status="NotStarted" mq:segmentguid="3a66f7db-296a-40d6-b47f-4d9aae0fd1c0" mq:lastchangedtimestamp="0001-01-01T00:00:00Z" mq:maxlengthchars="-1" mq:nosplitjoin="false" mq:firstlabel="275" mq:lastlabel="275" mq:autosplitjoinstate="0" mq:lastmodifrole="0" mq:multipleexactmatch="false">
<source xml:space="preserve" mq:segpart="275" mq:hasfollowingobject="hasfollowingobject">Materials for the foundation shall be on the job, except where concrete is ready mixed in accordance with ASTM C94, the concrete need not be on the job.</source>
<target xml:space="preserve"></target>
<context-group>
<context context-type="x-mmq-structural-context">trans-units / trans-unit#270 / struct-rpr#1</context>
</context-group>
