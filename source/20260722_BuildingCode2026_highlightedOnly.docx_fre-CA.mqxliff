<source xml:space="preserve" mq:segpart="1707" mq:hasfollowingobject="hasfollowingobject">The 19-inch (483 mm) distance shall be measured perpendicular to the side of the table or counter.</source>
<target xml:space="preserve"></target>
<context-group>
<context context-type="x-mmq-structural-context">trans-units / trans-unit#5671 / struct-rpr#1</context>
