<source xml:space="preserve" mq:segpart="3884" mq:hasfollowingobject="hasfollowingobject"><bpt id="1" ctype="bold">{}</bpt>802.9.1 Line of sight over seated spectators.<ept id="1">{}</ept></source>
<target xml:space="preserve"></target>
<context-group>
