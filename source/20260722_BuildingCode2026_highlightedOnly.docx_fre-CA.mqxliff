<trans-unit id="520" mq:status="NotStarted" mq:segmentguid="62968572-9fa4-45a4-90d0-b30ce4392f81" mq:lastchangedtimestamp="0001-01-01T00:00:00Z" mq:maxlengthchars="-1" mq:nosplitjoin="false" mq:firstlabel="431" mq:lastlabel="431" mq:autosplitjoinstate="0" mq:lastmodifrole="0" mq:multipleexactmatch="false">
<source xml:space="preserve" mq:segpart="431" mq:hasfollowingobject="hasfollowingobject">Automatic sprinklers are provided along both sides of the separation wall and doors, or on the room side only if there is not a walkway on the atrium side.</source>
<target xml:space="preserve"></target>
<context-group>
<context context-type="x-mmq-structural-context">trans-units / trans-unit#805 / struct-rpr#1</context>
</context-group>
<mq:startingws xml:space="preserve" />
<mq:endingws xml:space="preserve"> </mq:endingws>
<mq:commitinfos xmlns="MQXliff" /><mq:nosplitjoins />
<mq:originalsource edited="false" />
</trans-unit>
<trans-unit id="521" mq:status="NotStarted" mq:segmentguid="cee5de4b-ac88-486d-9ffd-14b705099e84" mq:lastchangedtimestamp="0001-01-01T00:00:00Z" mq:maxlengthchars="-1" mq:nosplitjoin="false" mq:firstlabel="431" mq:lastlabel="431" mq:autosplitjoinstate="0" mq:lastmodifrole="0" mq:multipleexactmatch="false">
<source xml:space="preserve" mq:segpart="431" mq:hasfollowingobject="hasfollowingobject">The sprinklers shall be located between 4 inches and 12 inches (102 mm and 305 mm) away from the glass and at intervals along the glass not greater than 6 feet (1829 mm).</source>
<target xml:space="preserve"></target>
<context-group>
<context context-type="x-mmq-structural-context">trans-units / trans-unit#805 / struct-rpr#1</context>
</context-group>
