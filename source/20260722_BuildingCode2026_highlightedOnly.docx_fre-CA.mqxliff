<source xml:space="preserve" mq:segpart="2732" mq:hasfollowingobject="hasfollowingobject"><bpt id="1" ctype="bold">{}</bpt>R308.4.7 Glazing adjacent to the bottom stair landing.<ept id="1">{}</ept></source>
