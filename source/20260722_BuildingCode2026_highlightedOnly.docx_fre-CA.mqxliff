<trans-unit id="202" mq:status="NotStarted" mq:segmentguid="4af1ace7-99c0-4b7a-9cdc-345d1bb63fbc" mq:lastchangedtimestamp="0001-01-01T00:00:00Z" mq:maxlengthchars="-1" mq:nosplitjoin="false" mq:firstlabel="158" mq:lastlabel="158" mq:autosplitjoinstate="0" mq:lastmodifrole="0" mq:multipleexactmatch="false">
<source xml:space="preserve" mq:segpart="158" mq:hasfollowingobject="hasfollowingobject">In buildings of Types IV-A, IV-B and IV-C construction, where connection fire-resistance ratings are provided by wood cover calculated to meet the requirements of Section 2304.10.1, inspection of the wood cover shall be made after the cover is installed, but before any other coverings or finishes are installed.</source>
