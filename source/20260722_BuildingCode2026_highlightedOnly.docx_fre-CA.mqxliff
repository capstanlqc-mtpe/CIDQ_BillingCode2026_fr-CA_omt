</trans-unit>
<trans-unit id="2674" mq:status="NotStarted" mq:segmentguid="a4bbe6fc-83c2-4fcd-a9aa-b706923d78ed" mq:lastchangedtimestamp="0001-01-01T00:00:00Z" mq:maxlengthchars="-1" mq:nosplitjoin="false" mq:firstlabel="2204" mq:lastlabel="2204" mq:autosplitjoinstate="0" mq:lastmodifrole="0" mq:multipleexactmatch="false">
<source xml:space="preserve" mq:segpart="2204" mq:hasfollowingobject="hasfollowingobject">Where multiple single-user toilet rooms or bathing rooms are clustered at a single location, at least 50 percent but not less than one room for each use at each cluster shall be accessible.</source>
<target xml:space="preserve"></target>
<context-group>
<context context-type="x-mmq-structural-context">trans-units / trans-unit#6286 / struct-rpr#1</context>
</context-group>
