<source xml:space="preserve" mq:segpart="426" mq:hasfollowingobject="hasfollowingobject">All stories above the lowest two stories shall be separated from the atrium in accordance with the provisions for a shaft in Section 713.4.</source>
<target xml:space="preserve"></target>
