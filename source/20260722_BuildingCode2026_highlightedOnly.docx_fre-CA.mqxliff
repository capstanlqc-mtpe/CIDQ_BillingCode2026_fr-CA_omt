<mq:originalsource edited="false" />
</trans-unit>
<trans-unit id="3367" mq:status="NotStarted" mq:segmentguid="75e4ae3f-8236-404f-80e3-645f76639b02" mq:lastchangedtimestamp="2026-07-21T07:30:06Z" mq:lastchanginguser="EmmaG" mq:maxlengthchars="-1" mq:nosplitjoin="false" mq:firstlabel="2703" mq:lastlabel="2703" mq:autosplitjoinstate="0" mq:lastmodifrole="0" mq:multipleexactmatch="false">
<source xml:space="preserve" mq:segpart="2703" mq:hasfollowingobject="hasfollowingobject">2.<ph id="1">&lt;mq:ch val=&quot;	&quot; /&gt;</ph>Where the glazing is on a wall less than 180 degrees (3.14 rad) from the plane of the door in a closed position and within 24 inches (610 mm) of the hinge side of an in-swinging door.</source>
<target xml:space="preserve"></target>
<context-group>
