<trans-unit id="654" mq:status="NotStarted" mq:segmentguid="2862c928-28b1-4c6f-b6c0-cfe3a3497cdd" mq:lastchangedtimestamp="0001-01-01T00:00:00Z" mq:maxlengthchars="-1" mq:nosplitjoin="false" mq:firstlabel="562" mq:lastlabel="562" mq:autosplitjoinstate="0" mq:lastmodifrole="0" mq:multipleexactmatch="false">
<source xml:space="preserve" mq:segpart="562" mq:hasfollowingobject="hasfollowingobject">A horizontal assembly is not required between the atrium and openings for escalators complying with Section 712.1.3.</source>
<target xml:space="preserve"></target>
<context-group>
<context context-type="x-mmq-structural-context">trans-units / trans-unit#549 / struct-rpr#1</context>
