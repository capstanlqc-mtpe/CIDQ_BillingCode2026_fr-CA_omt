<source xml:space="preserve" mq:segpart="4088" mq:hasfollowingobject="hasfollowingobject"><bpt id="1" ctype="bold">{}</bpt>808.3.1 Sound sources outside of the classroom.<ept id="1">{}</ept></source>
<target xml:space="preserve"></target>
<context-group>
