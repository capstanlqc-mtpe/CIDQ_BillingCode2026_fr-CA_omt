<source xml:space="preserve" mq:segpart="311" mq:hasfollowingobject="hasfollowingobject"><bpt id="1" ctype="bold">{}</bpt>[BS] 403.2.2.2 Wall assembly materials—hard body impact.<ept id="1">{}</ept></source>
<target xml:space="preserve"></target>
<context-group>
<context context-type="x-mmq-structural-context">trans-units / trans-unit#686 / struct-rpr#1</context>
</context-group>
