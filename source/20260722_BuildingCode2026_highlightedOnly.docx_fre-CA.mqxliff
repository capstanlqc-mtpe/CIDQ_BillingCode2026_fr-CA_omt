<source xml:space="preserve" mq:segpart="2156" mq:hasfollowingobject="hasfollowingobject">Bedrooms within congregate living facilities, dormitories, sororities, fraternities and boarding houses shall be counted as sleeping units for the purpose of determining the number of units.</source>
<target xml:space="preserve"></target>
<context-group>
