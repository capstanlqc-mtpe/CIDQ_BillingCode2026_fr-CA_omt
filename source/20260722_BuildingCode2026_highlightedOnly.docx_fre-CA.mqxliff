<mq:originalsource edited="false" />
</trans-unit>
<trans-unit id="1819" mq:status="NotStarted" mq:segmentguid="e82b6270-d9b1-4408-881a-a160e03dbeac" mq:lastchangedtimestamp="0001-01-01T00:00:00Z" mq:maxlengthchars="-1" mq:nosplitjoin="false" mq:firstlabel="1489" mq:lastlabel="1489" mq:autosplitjoinstate="0" mq:lastmodifrole="0" mq:multipleexactmatch="false">
<source xml:space="preserve" mq:segpart="1489" mq:hasfollowingobject="hasfollowingobject">The open-ended corridors comply with Section 1020.</source>
<target xml:space="preserve"></target>
<context-group>
<context context-type="x-mmq-structural-context">trans-units / trans-unit#5456 / struct-rpr#1</context>
</context-group>
<mq:startingws xml:space="preserve" />
<mq:endingws xml:space="preserve" />
