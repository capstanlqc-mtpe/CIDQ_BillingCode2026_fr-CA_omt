<mq:originalsource edited="false" />
</trans-unit>
<trans-unit id="726" mq:status="NotStarted" mq:segmentguid="754236c2-e186-4cb9-b586-072677b44434" mq:lastchangedtimestamp="0001-01-01T00:00:00Z" mq:maxlengthchars="-1" mq:nosplitjoin="false" mq:firstlabel="595" mq:lastlabel="595" mq:autosplitjoinstate="0" mq:lastmodifrole="0" mq:multipleexactmatch="false">
<source xml:space="preserve" mq:segpart="595" mq:hasfollowingobject="hasfollowingobject">The area of the occupied roofs shall not be included in the building area as regulated by Section 506.</source>
<target xml:space="preserve"></target>
<context-group>
