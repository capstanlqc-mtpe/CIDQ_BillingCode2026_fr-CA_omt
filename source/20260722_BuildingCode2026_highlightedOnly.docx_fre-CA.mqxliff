<mq:originalsource edited="false" />
</trans-unit>
<trans-unit id="1593" mq:status="NotStarted" mq:segmentguid="97a59751-6b93-4f7c-b8df-5d8db65e14bb" mq:lastchangedtimestamp="0001-01-01T00:00:00Z" mq:maxlengthchars="-1" mq:nosplitjoin="false" mq:firstlabel="1324" mq:lastlabel="1324" mq:autosplitjoinstate="0" mq:lastmodifrole="0" mq:multipleexactmatch="false">
<source xml:space="preserve" mq:segpart="1324" mq:hasfollowingobject="hasfollowingobject"><bpt id="1" ctype="bold">{}</bpt>1023.3.1 Extension.<ept id="1">{}</ept></source>
<target xml:space="preserve"></target>
<context-group>
<context context-type="x-mmq-structural-context">trans-units / trans-unit#5280 / struct-rpr#1</context>
</context-group>
<mq:startingws xml:space="preserve" />
