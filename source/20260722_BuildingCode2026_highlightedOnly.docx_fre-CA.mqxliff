<source xml:space="preserve" mq:segpart="1024" mq:hasfollowingobject="hasfollowingobject"><bpt id="1" ctype="bold">{}</bpt>[F] 907.2.1 Group A.<ept id="1">{}</ept></source>
<target xml:space="preserve"></target>
<context-group>
<context context-type="x-mmq-structural-context">trans-units / trans-unit#4172 / struct-rpr#1</context>
</context-group>
<mq:startingws xml:space="preserve" />
