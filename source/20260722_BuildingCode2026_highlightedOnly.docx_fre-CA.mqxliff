<source xml:space="preserve" mq:segpart="1829" mq:hasfollowingobject="hasfollowingobject">Where the seats are self-rising, guard height shall be 42 inches (1067 mm) high minimum, measured from the floor surface.</source>
<target xml:space="preserve"></target>
