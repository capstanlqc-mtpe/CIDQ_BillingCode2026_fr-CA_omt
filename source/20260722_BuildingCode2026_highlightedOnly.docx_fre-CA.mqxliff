<trans-unit id="5303" mq:status="NotStarted" mq:segmentguid="4649aa2d-2362-4bc1-88c9-3a57a10ad356" mq:lastchangedtimestamp="0001-01-01T00:00:00Z" mq:maxlengthchars="-1" mq:nosplitjoin="false" mq:firstlabel="4089" mq:lastlabel="4089" mq:autosplitjoinstate="0" mq:lastmodifrole="0" mq:multipleexactmatch="false">
<source xml:space="preserve" mq:segpart="4089" mq:hasfollowingobject="hasfollowingobject">Classroom ambient sound levels shall not exceed 35 dBA and 55 dBC due to intruding noise from sound sources outside of the classroom, whether from the exterior or from other interior spaces.</source>
<target xml:space="preserve"></target>
