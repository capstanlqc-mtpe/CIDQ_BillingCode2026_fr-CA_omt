<source xml:space="preserve" mq:segpart="1018" mq:hasfollowingobject="hasfollowingobject"><bpt id="1" ctype="bold">{}</bpt>[F] 907.2 Where required—new buildings and structures.<ept id="1">{}</ept></source>
<target xml:space="preserve"></target>
