<source xml:space="preserve" mq:segpart="2738" mq:hasfollowingobject="hasfollowingobject">The means of egress shall provide a continuous and unobstructed path of vertical and horizontal egress travel from all portions of the dwelling to the required egress door without requiring travel through a garage.</source>
<target xml:space="preserve"></target>
<context-group>
<context context-type="x-mmq-structural-context">trans-units / trans-unit#6820 / struct-rpr#1</context>
</context-group>
