<trans-unit id="598" mq:status="NotStarted" mq:segmentguid="3424bab8-864a-465b-821c-46fcddb99a8a" mq:lastchangedtimestamp="0001-01-01T00:00:00Z" mq:maxlengthchars="-1" mq:nosplitjoin="false" mq:firstlabel="514" mq:lastlabel="514" mq:autosplitjoinstate="0" mq:lastmodifrole="0" mq:multipleexactmatch="false">
<source xml:space="preserve" mq:segpart="514" mq:hasfollowingobject="hasfollowingobject">An additional interior exit stairway shall not be required to be installed in buildings having elevators used for occupant self-evacuation in accordance with Section 3008.</source>
<target xml:space="preserve"></target>
<context-group>
<context context-type="x-mmq-structural-context">trans-units / trans-unit#502 / struct-rpr#1</context>
</context-group>
<mq:startingws xml:space="preserve" />
<mq:endingws xml:space="preserve" />
