<trans-unit id="1223" mq:status="NotStarted" mq:segmentguid="6c28955d-4613-403d-8a3a-e0002e8b669a" mq:lastchangedtimestamp="0001-01-01T00:00:00Z" mq:maxlengthchars="-1" mq:nosplitjoin="false" mq:firstlabel="1022" mq:lastlabel="1022" mq:autosplitjoinstate="0" mq:lastmodifrole="0" mq:multipleexactmatch="false">
<source xml:space="preserve" mq:segpart="1022" mq:hasfollowingobject="hasfollowingobject">The manual fire alarm box is not required for fire alarm systems dedicated to elevator recall control and supervisory service.</source>
<target xml:space="preserve"></target>
<context-group>
<context context-type="x-mmq-structural-context">trans-units / trans-unit#4170 / struct-rpr#1</context>
</context-group>
<mq:startingws xml:space="preserve" />
<mq:endingws xml:space="preserve" />
<mq:commitinfos xmlns="MQXliff" /><mq:nosplitjoins />
<mq:originalsource edited="false" />
</trans-unit>
<trans-unit id="1224" mq:status="NotStarted" mq:segmentguid="56813438-b6fe-4512-ba49-8543ef1f147b" mq:lastchangedtimestamp="0001-01-01T00:00:00Z" mq:maxlengthchars="-1" mq:nosplitjoin="false" mq:firstlabel="1023" mq:lastlabel="1023" mq:autosplitjoinstate="0" mq:lastmodifrole="0" mq:multipleexactmatch="false">
<source xml:space="preserve" mq:segpart="1023" mq:hasfollowingobject="hasfollowingobject">The manual fire alarm box is not required for Group R-2 occupancies unless required by the fire code official to provide a means for fire watch personnel to initiate an alarm during a sprinkler system impairment event.</source>
<target xml:space="preserve"></target>
<context-group>
<context context-type="x-mmq-structural-context">trans-units / trans-unit#4171 / struct-rpr#1</context>
</context-group>
<mq:startingws xml:space="preserve" />
<mq:endingws xml:space="preserve"> </mq:endingws>
<mq:commitinfos xmlns="MQXliff" /><mq:nosplitjoins />
<mq:originalsource edited="false" />
</trans-unit>
<trans-unit id="1225" mq:status="NotStarted" mq:segmentguid="f2914370-7a57-40a0-b07a-efc8fb74552c" mq:lastchangedtimestamp="0001-01-01T00:00:00Z" mq:maxlengthchars="-1" mq:nosplitjoin="false" mq:firstlabel="1023" mq:lastlabel="1023" mq:autosplitjoinstate="0" mq:lastmodifrole="0" mq:multipleexactmatch="false">
<source xml:space="preserve" mq:segpart="1023" mq:hasfollowingobject="hasfollowingobject">Where provided, the manual fire alarm box shall not be located in an area that is open to the public.</source>
<target xml:space="preserve"></target>
<context-group>
<context context-type="x-mmq-structural-context">trans-units / trans-unit#4171 / struct-rpr#1</context>
</context-group>
