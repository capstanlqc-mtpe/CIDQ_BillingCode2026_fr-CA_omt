<source xml:space="preserve" mq:segpart="1817" mq:hasfollowingobject="hasfollowingobject"><bpt id="1" ctype="bold">{}</bpt>1030.16.1 Discontinuous mid-aisle handrails.<ept id="1">{}</ept></source>
