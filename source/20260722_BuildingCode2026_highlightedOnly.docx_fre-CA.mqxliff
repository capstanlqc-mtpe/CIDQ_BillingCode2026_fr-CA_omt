<source xml:space="preserve" mq:segpart="1777" mq:hasfollowingobject="hasfollowingobject">Ramped aisles that serve as part of an accessible route in accordance with Sections 1009 and 1109.2 shall have a maximum slope of 1 unit vertical in 12 units horizontal (8-percent slope).</source>
<target xml:space="preserve"></target>
<context-group>
<context context-type="x-mmq-structural-context">trans-units / trans-unit#5741 / struct-rpr#1</context>
</context-group>
