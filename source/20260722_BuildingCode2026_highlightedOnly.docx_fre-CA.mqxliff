<trans-unit id="5188" mq:status="NotStarted" mq:segmentguid="ceaa2081-a287-436c-8782-ec134aa707e2" mq:lastchangedtimestamp="0001-01-01T00:00:00Z" mq:maxlengthchars="-1" mq:nosplitjoin="false" mq:firstlabel="3993" mq:lastlabel="3993" mq:autosplitjoinstate="0" mq:lastmodifrole="0" mq:multipleexactmatch="false">
<source xml:space="preserve" mq:segpart="3993" mq:hasfollowingobject="hasfollowingobject">The sign language interpreter station shall have lighting facilities capable of providing 10 footcandles (108 lux) of illuminance while signing is underway measured at the center of the floor of the sign language station at a height of 48 inches (1220 mm) above the floor.</source>
<target xml:space="preserve"></target>
<context-group>
<context context-type="x-mmq-structural-context">trans-units / trans-unit#8942 / struct-rpr#1</context>
</context-group>
