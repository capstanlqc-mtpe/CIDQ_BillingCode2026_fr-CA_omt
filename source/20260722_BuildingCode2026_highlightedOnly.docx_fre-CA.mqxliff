<source xml:space="preserve" mq:segpart="1428" mq:hasfollowingobject="hasfollowingobject">A solid and continuous stripe shall be applied to the horizontal leading edge of each step and shall extend for the full length of the step.</source>
<target xml:space="preserve"></target>
