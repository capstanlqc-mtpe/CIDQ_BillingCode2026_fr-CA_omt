<trans-unit id="1624" mq:status="NotStarted" mq:segmentguid="f5afbea8-79af-4750-9556-51c0c1151a68" mq:lastchangedtimestamp="2026-07-21T07:30:06Z" mq:lastchanginguser="EmmaG" mq:maxlengthchars="-1" mq:nosplitjoin="false" mq:firstlabel="1348" mq:lastlabel="1348" mq:autosplitjoinstate="0" mq:lastmodifrole="0" mq:multipleexactmatch="false">
<source xml:space="preserve" mq:segpart="1348" mq:hasfollowingobject="hasfollowingobject">2.<ph id="1">&lt;mq:ch val=&quot;	&quot; /&gt;</ph>Where such equipment and ductwork is located within the interior exit stairway and ramp, the intake air shall be taken directly from the outdoors and the exhaust air shall be discharged directly to the outdoors, or such air shall be conveyed through ducts enclosed in construction as required for shafts.</source>
<target xml:space="preserve"></target>
<context-group>
<context context-type="x-mmq-structural-context">trans-units / trans-unit#5304 / struct-rpr#1</context>
