<source xml:space="preserve" mq:segpart="1829" mq:hasfollowingobject="hasfollowingobject">Where the seatboards are adjacent to the perimeter, guard height shall be 42 inches (1067 mm) high minimum, measured from the seatboard.</source>
<target xml:space="preserve"></target>
