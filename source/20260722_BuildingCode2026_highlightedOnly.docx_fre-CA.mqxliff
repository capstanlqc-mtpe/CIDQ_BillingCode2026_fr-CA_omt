<trans-unit id="975" mq:status="NotStarted" mq:segmentguid="2800dab3-1720-4419-94a1-79d602aea625" mq:lastchangedtimestamp="0001-01-01T00:00:00Z" mq:maxlengthchars="-1" mq:nosplitjoin="false" mq:firstlabel="803" mq:lastlabel="803" mq:autosplitjoinstate="0" mq:lastmodifrole="0" mq:multipleexactmatch="false">
<source xml:space="preserve" mq:segpart="803" mq:hasfollowingobject="hasfollowingobject">Interior floor covering materials shall comply with Sections 804.4.1 and 804.4.2 and interior floor finish materials shall comply with Section 804.4.2.</source>
<target xml:space="preserve"></target>
<context-group>
<context context-type="x-mmq-structural-context">trans-units / trans-unit#3954 / struct-rpr#1</context>
