<source xml:space="preserve" mq:segpart="2202" mq:hasfollowingobject="hasfollowingobject">Toilet rooms or bathing rooms accessed only through a private office, not for common or public use and intended for use by a single occupant, shall be permitted to comply with the specific exceptions in ICC A117.1.</source>
<target xml:space="preserve"></target>
<context-group>
<context context-type="x-mmq-structural-context">trans-units / trans-unit#6284 / struct-rpr#1</context>
</context-group>
