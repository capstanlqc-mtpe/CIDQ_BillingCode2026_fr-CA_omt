<source xml:space="preserve" mq:segpart="1837" mq:hasfollowingobject="hasfollowingobject"><bpt id="1" ctype="bold">{}</bpt>1030.17.3 Sightline-constrained guard heights.<ept id="1">{}</ept></source>
