<source xml:space="preserve" mq:segpart="2207" mq:hasfollowingobject="hasfollowingobject">The sleeping units served by bariatrics toilet or bathing rooms shall not count toward the required number of Accessible sleeping units.</source>
<target xml:space="preserve"></target>
<context-group>
