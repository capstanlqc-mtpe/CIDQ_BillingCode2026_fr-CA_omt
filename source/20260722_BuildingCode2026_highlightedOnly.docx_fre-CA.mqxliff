<source xml:space="preserve" mq:segpart="511" mq:hasfollowingobject="hasfollowingobject"><bpt id="1" ctype="bold">{}</bpt>403.5.2 Additional interior exit stairway.<ept id="1">{}</ept></source>
<target xml:space="preserve"></target>
<context-group>
<context context-type="x-mmq-structural-context">trans-units / trans-unit#499 / struct-rpr#1</context>
</context-group>
