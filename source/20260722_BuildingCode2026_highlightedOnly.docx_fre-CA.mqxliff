<trans-unit id="5133" mq:status="NotStarted" mq:segmentguid="62033881-58cf-4979-8153-d2cc0f657c48" mq:lastchangedtimestamp="0001-01-01T00:00:00Z" mq:maxlengthchars="-1" mq:nosplitjoin="false" mq:firstlabel="3947" mq:lastlabel="3947" mq:autosplitjoinstate="0" mq:lastmodifrole="0" mq:multipleexactmatch="false">
<source xml:space="preserve" mq:segpart="3947" mq:hasfollowingobject="hasfollowingobject">The table is based on the following calculation: [(2X+34)(Y-2.25)/X]+(20.2-Y) where Y is the riser height of the rows in front of the wheelchair space location and X is the tread depth of the rows in front of the wheelchair space location.</source>
<target xml:space="preserve"></target>
