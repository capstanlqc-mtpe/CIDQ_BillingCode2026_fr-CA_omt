<source xml:space="preserve" mq:segpart="2551" mq:hasfollowingobject="hasfollowingobject">Such openings shall be provided with ready access or shall otherwise be readily controllable by the building occupants.</source>
<target xml:space="preserve"></target>
<context-group>
