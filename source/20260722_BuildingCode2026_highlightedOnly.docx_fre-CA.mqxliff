<trans-unit id="4932" mq:status="NotStarted" mq:segmentguid="5fc2fc44-c8db-4ff2-bf35-ec945519145f" mq:lastchangedtimestamp="0001-01-01T00:00:00Z" mq:maxlengthchars="-1" mq:nosplitjoin="false" mq:firstlabel="3795" mq:lastlabel="3795" mq:autosplitjoinstate="0" mq:lastmodifrole="0" mq:multipleexactmatch="false">
<source xml:space="preserve" mq:segpart="3795" mq:hasfollowingobject="hasfollowingobject">Spacing between individual raised characters shall be 1/8 inch (3.2 mm) minimum measured at the top surface of the characters, 1/16 inch (1.6 mm) minimum measured at the base of the characters, and four times the raised character stroke width maximum.</source>
<target xml:space="preserve"></target>
