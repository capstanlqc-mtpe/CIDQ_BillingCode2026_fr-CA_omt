<trans-unit id="5138" mq:status="NotStarted" mq:segmentguid="e459699c-9433-4339-8613-9955c820d577" mq:lastchangedtimestamp="0001-01-01T00:00:00Z" mq:maxlengthchars="-1" mq:nosplitjoin="false" mq:firstlabel="3949" mq:lastlabel="3949" mq:autosplitjoinstate="0" mq:lastmodifrole="0" mq:multipleexactmatch="false">
<source xml:space="preserve" mq:segpart="3949" mq:hasfollowingobject="hasfollowingobject">In addition, wheelchair space locations shall be dispersed in accordance with Section 802.10.4 in spaces utilized primarily for viewing motion picture projection.</source>
