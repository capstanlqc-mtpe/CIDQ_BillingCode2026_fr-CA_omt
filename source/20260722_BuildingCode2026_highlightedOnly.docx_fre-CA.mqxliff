<mq:endingws xml:space="preserve" />
<mq:commitinfos xmlns="MQXliff" /><mq:nosplitjoins />
<mq:originalsource edited="false" />
</trans-unit>
<trans-unit id="651" mq:status="NotStarted" mq:segmentguid="f80483af-c405-40fd-8091-126142f44abd" mq:lastchangedtimestamp="0001-01-01T00:00:00Z" mq:maxlengthchars="-1" mq:nosplitjoin="false" mq:firstlabel="559" mq:lastlabel="559" mq:autosplitjoinstate="0" mq:lastmodifrole="0" mq:multipleexactmatch="false">
<source xml:space="preserve" mq:segpart="559" mq:hasfollowingobject="hasfollowingobject">A fire barrier is not required where a glass-block wall assembly complying with Section 2110 and having a 3/4-hour fire protection rating is provided.</source>
<target xml:space="preserve"></target>
<context-group>
<context context-type="x-mmq-structural-context">trans-units / trans-unit#546 / struct-rpr#1</context>
</context-group>
<mq:startingws xml:space="preserve" />
<mq:endingws xml:space="preserve" />
<mq:commitinfos xmlns="MQXliff" /><mq:nosplitjoins />
<mq:originalsource edited="false" />
</trans-unit>
<trans-unit id="652" mq:status="NotStarted" mq:segmentguid="ce05e034-2ce4-4b7a-91a5-972b3632659a" mq:lastchangedtimestamp="0001-01-01T00:00:00Z" mq:maxlengthchars="-1" mq:nosplitjoin="false" mq:firstlabel="560" mq:lastlabel="560" mq:autosplitjoinstate="0" mq:lastmodifrole="0" mq:multipleexactmatch="false">
<source xml:space="preserve" mq:segpart="560" mq:hasfollowingobject="hasfollowingobject">A fire barrier is not required between the atrium and the adjoining spaces of up to three floors of the atrium provided that such spaces are accounted for in the design of the smoke control system.</source>
<target xml:space="preserve"></target>
<context-group>
<context context-type="x-mmq-structural-context">trans-units / trans-unit#547 / struct-rpr#1</context>
</context-group>
