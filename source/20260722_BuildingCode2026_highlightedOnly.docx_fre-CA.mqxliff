<trans-unit id="555" mq:status="NotStarted" mq:segmentguid="93545b63-2820-4e4d-a674-f1154d2c8851" mq:lastchangedtimestamp="0001-01-01T00:00:00Z" mq:maxlengthchars="-1" mq:nosplitjoin="false" mq:firstlabel="463" mq:lastlabel="463" mq:autosplitjoinstate="0" mq:lastmodifrole="0" mq:multipleexactmatch="false">
<source xml:space="preserve" mq:segpart="463" mq:hasfollowingobject="hasfollowingobject">Stages of Type IIB or IV construction with a nominal 2-inch (51 mm) wood deck, provided that the stage is separated from other areas in accordance with Section 410.2.4.</source>
<target xml:space="preserve"></target>
<context-group>
<context context-type="x-mmq-structural-context">trans-units / trans-unit#836 / struct-rpr#1</context>
</context-group>
