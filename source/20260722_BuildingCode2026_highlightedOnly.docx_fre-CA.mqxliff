<mq:originalsource edited="false" />
</trans-unit>
<trans-unit id="1630" mq:status="NotStarted" mq:segmentguid="59c6a581-f41d-4e4f-a659-8cad9c4651e7" mq:lastchangedtimestamp="0001-01-01T00:00:00Z" mq:maxlengthchars="-1" mq:nosplitjoin="false" mq:firstlabel="1353" mq:lastlabel="1353" mq:autosplitjoinstate="0" mq:lastmodifrole="0" mq:multipleexactmatch="false">
<source xml:space="preserve" mq:segpart="1353" mq:hasfollowingobject="hasfollowingobject">Where nonrated walls or unprotected openings enclose the exterior of the stairway or ramps and the walls or openings are exposed by other parts of the building at an angle of less than 180 degrees (3.14 rad), the building exterior walls within 10 feet (3048 mm) horizontally of a nonrated wall or unprotected opening shall have a fire-resistance rating of not less than 1 hour.</source>
<target xml:space="preserve"></target>
<context-group>
