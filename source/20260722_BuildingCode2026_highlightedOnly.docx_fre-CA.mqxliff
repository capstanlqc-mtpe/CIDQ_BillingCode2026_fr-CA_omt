<source xml:space="preserve" mq:segpart="276" mq:hasfollowingobject="hasfollowingobject"><bpt id="1" ctype="bold">{}</bpt>[A] 110.3.2 Concrete slab and under-floor inspection.<ept id="1">{}</ept></source>
<target xml:space="preserve"></target>
<context-group>
