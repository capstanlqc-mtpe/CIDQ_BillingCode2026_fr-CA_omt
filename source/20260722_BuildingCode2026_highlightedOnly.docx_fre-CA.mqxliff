<source xml:space="preserve" mq:segpart="525" mq:hasfollowingobject="hasfollowingobject">Elevator installation and operation in high-rise buildings shall comply with Chapter 30 and Sections 403.6.1 and 403.6.2.</source>
<target xml:space="preserve"></target>
