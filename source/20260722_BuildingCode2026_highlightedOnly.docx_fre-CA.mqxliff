<trans-unit id="385" mq:status="NotStarted" mq:segmentguid="f1bd5a06-2563-4bc6-9ad0-fda5ae0c3d3e" mq:lastchangedtimestamp="0001-01-01T00:00:00Z" mq:maxlengthchars="-1" mq:nosplitjoin="false" mq:firstlabel="323" mq:lastlabel="323" mq:autosplitjoinstate="0" mq:lastmodifrole="0" mq:multipleexactmatch="false">
<source xml:space="preserve" mq:segpart="323" mq:hasfollowingobject="hasfollowingobject">Buildings and structures shall be equipped throughout with an automatic sprinkler system in accordance with Section 903.3.1.1 and a secondary water supply where required by Section 403.3.3.</source>
<target xml:space="preserve"></target>
<context-group>
