<source xml:space="preserve" mq:segpart="337" mq:hasfollowingobject="hasfollowingobject"><bpt id="1" ctype="bold">{}</bpt>[A] 112.3 Authority to disconnect service utilities.<ept id="1">{}</ept></source>
