<trans-unit id="568" mq:status="NotStarted" mq:segmentguid="813b4b87-0a81-45a9-8fc4-ea02ff2e66a8" mq:lastchangedtimestamp="0001-01-01T00:00:00Z" mq:maxlengthchars="-1" mq:nosplitjoin="false" mq:firstlabel="472" mq:lastlabel="472" mq:autosplitjoinstate="0" mq:lastmodifrole="0" mq:multipleexactmatch="false">
<source xml:space="preserve" mq:segpart="472" mq:hasfollowingobject="hasfollowingobject">Where protection of openings is required, exterior exit doors shall be protected with fire door assemblies that comply with Section 716.</source>
<target xml:space="preserve"></target>
<context-group>
<context context-type="x-mmq-structural-context">trans-units / trans-unit#845 / struct-rpr#1</context>
</context-group>
<mq:startingws xml:space="preserve" />
<mq:endingws xml:space="preserve"> </mq:endingws>
<mq:commitinfos xmlns="MQXliff" /><mq:nosplitjoins />
<mq:originalsource edited="false" />
</trans-unit>
<trans-unit id="569" mq:status="NotStarted" mq:segmentguid="a610beda-25a7-4781-bbf3-0c12ef6a0176" mq:lastchangedtimestamp="0001-01-01T00:00:00Z" mq:maxlengthchars="-1" mq:nosplitjoin="false" mq:firstlabel="472" mq:lastlabel="472" mq:autosplitjoinstate="0" mq:lastmodifrole="0" mq:multipleexactmatch="false">
<source xml:space="preserve" mq:segpart="472" mq:hasfollowingobject="hasfollowingobject">Exterior openings that are located on the stage for means of egress or loading and unloading purposes, and that are likely to be open during occupancy of the theater, shall be constructed with vestibules to prevent air drafts into the auditorium.</source>
<target xml:space="preserve"></target>
<context-group>
<context context-type="x-mmq-structural-context">trans-units / trans-unit#845 / struct-rpr#1</context>
</context-group>
<mq:startingws xml:space="preserve" />
<mq:endingws xml:space="preserve" />
<mq:commitinfos xmlns="MQXliff" /><mq:nosplitjoins />
<mq:originalsource edited="false" />
</trans-unit>
<trans-unit id="570" mq:status="NotStarted" mq:segmentguid="318cd11a-ea56-467f-8782-7d477cd04ee9" mq:lastchangedtimestamp="0001-01-01T00:00:00Z" mq:maxlengthchars="-1" mq:nosplitjoin="false" mq:firstlabel="473" mq:lastlabel="473" mq:autosplitjoinstate="0" mq:lastmodifrole="0" mq:multipleexactmatch="false">
<source xml:space="preserve" mq:segpart="473" mq:hasfollowingobject="hasfollowingobject"><bpt id="1" ctype="bold">{}</bpt>410.2.4 Proscenium wall.<ept id="1">{}</ept></source>
<target xml:space="preserve"></target>
<context-group>
<context context-type="x-mmq-structural-context">trans-units / trans-unit#846 / struct-rpr#1</context>
</context-group>
<mq:startingws xml:space="preserve" />
<mq:endingws xml:space="preserve" />
<mq:commitinfos xmlns="MQXliff" /><mq:nosplitjoins />
<mq:originalsource edited="false" />
</trans-unit>
<trans-unit id="571" mq:status="NotStarted" mq:segmentguid="7e95199c-32b8-4889-9851-2175773ad8cd" mq:lastchangedtimestamp="0001-01-01T00:00:00Z" mq:maxlengthchars="-1" mq:nosplitjoin="false" mq:firstlabel="474" mq:lastlabel="474" mq:autosplitjoinstate="0" mq:lastmodifrole="0" mq:multipleexactmatch="false">
<source xml:space="preserve" mq:segpart="474" mq:hasfollowingobject="hasfollowingobject">Where the stage height is greater than 50 feet (15 240 mm), all portions of the stage shall be completely separated from the seating area by a proscenium wall with not less than a 2-hour fire-resistance rating extending continuously from the foundation to the roof.</source>
<target xml:space="preserve"></target>
<context-group>
<context context-type="x-mmq-structural-context">trans-units / trans-unit#847 / struct-rpr#1</context>
</context-group>
<mq:startingws xml:space="preserve" />
<mq:endingws xml:space="preserve" />
<mq:commitinfos xmlns="MQXliff" /><mq:nosplitjoins />
<mq:originalsource edited="false" />
</trans-unit>
<trans-unit id="572" mq:status="NotStarted" mq:segmentguid="d42f7847-e0e6-416e-bec6-984ff1e16ec1" mq:lastchangedtimestamp="0001-01-01T00:00:00Z" mq:maxlengthchars="-1" mq:nosplitjoin="false" mq:firstlabel="475" mq:lastlabel="475" mq:autosplitjoinstate="0" mq:lastmodifrole="0" mq:multipleexactmatch="false">
<source xml:space="preserve" mq:segpart="475" mq:hasfollowingobject="hasfollowingobject"><bpt id="1" ctype="bold">{}</bpt>410.2.5 Proscenium curtain.<ept id="1">{}</ept></source>
<target xml:space="preserve"></target>
<context-group>
<context context-type="x-mmq-structural-context">trans-units / trans-unit#848 / struct-rpr#1</context>
</context-group>
<mq:startingws xml:space="preserve" />
<mq:endingws xml:space="preserve" />
<mq:commitinfos xmlns="MQXliff" /><mq:nosplitjoins />
<mq:originalsource edited="false" />
</trans-unit>
<trans-unit id="573" mq:status="NotStarted" mq:segmentguid="97bdef47-f0d6-4c77-a942-6738afa0b28f" mq:lastchangedtimestamp="0001-01-01T00:00:00Z" mq:maxlengthchars="-1" mq:nosplitjoin="false" mq:firstlabel="476" mq:lastlabel="476" mq:autosplitjoinstate="0" mq:lastmodifrole="0" mq:multipleexactmatch="false">
<source xml:space="preserve" mq:segpart="476" mq:hasfollowingobject="hasfollowingobject">Where a proscenium wall is required to have a fire-resistance rating, the stage opening shall be provided with a fire curtain complying with NFPA 80, horizontal sliding doors complying with Section 716 having a fire protection rating of not less than 1 hour, or an approved water curtain complying with Section 903.3.1.1 or, in facilities not utilizing the provisions of smoke-protected assembly seating in accordance with Section 1030.6.2, a smoke control system complying with Section 909 or natural ventilation designed to maintain the smoke level not less than 6 feet (1829 mm) above the floor of the means of egress.</source>
<target xml:space="preserve"></target>
<context-group>
<context context-type="x-mmq-structural-context">trans-units / trans-unit#849 / struct-rpr#1</context>
</context-group>
<mq:startingws xml:space="preserve" />
<mq:endingws xml:space="preserve" />
<mq:commitinfos xmlns="MQXliff" /><mq:nosplitjoins />
<mq:originalsource edited="false" />
</trans-unit>
<trans-unit id="574" mq:status="NotStarted" mq:segmentguid="50c2d0c1-7c38-4e3d-8ba1-82a42631386a" mq:lastchangedtimestamp="0001-01-01T00:00:00Z" mq:maxlengthchars="-1" mq:nosplitjoin="false" mq:firstlabel="477" mq:lastlabel="477" mq:autosplitjoinstate="0" mq:lastmodifrole="0" mq:multipleexactmatch="false">
<source xml:space="preserve" mq:segpart="477" mq:hasfollowingobject="hasfollowingobject"><bpt id="1" ctype="bold">{}</bpt>410.2.6 Scenery.<ept id="1">{}</ept></source>
<target xml:space="preserve"></target>
<context-group>
<context context-type="x-mmq-structural-context">trans-units / trans-unit#850 / struct-rpr#1</context>
</context-group>
<mq:startingws xml:space="preserve" />
<mq:endingws xml:space="preserve" />
<mq:commitinfos xmlns="MQXliff" /><mq:nosplitjoins />
<mq:originalsource edited="false" />
</trans-unit>
<trans-unit id="575" mq:status="NotStarted" mq:segmentguid="2a176414-69fc-4bb5-99bb-9e267caff6a7" mq:lastchangedtimestamp="0001-01-01T00:00:00Z" mq:maxlengthchars="-1" mq:nosplitjoin="false" mq:firstlabel="478" mq:lastlabel="478" mq:autosplitjoinstate="0" mq:lastmodifrole="0" mq:multipleexactmatch="false">
<source xml:space="preserve" mq:segpart="478" mq:hasfollowingobject="hasfollowingobject">Combustible materials used in sets and scenery shall meet the fire propagation performance criteria of Test Method 1 or Test Method 2, as appropriate, of NFPA 701, in accordance with Section 806 and the International Fire Code.</source>
<target xml:space="preserve"></target>
<context-group>
<context context-type="x-mmq-structural-context">trans-units / trans-unit#851 / struct-rpr#1</context>
</context-group>
<mq:startingws xml:space="preserve" />
<mq:endingws xml:space="preserve"> </mq:endingws>
<mq:commitinfos xmlns="MQXliff" /><mq:nosplitjoins />
<mq:originalsource edited="false" />
</trans-unit>
<trans-unit id="576" mq:status="NotStarted" mq:segmentguid="d2d78b30-c1f4-4a2f-833e-9931ad387e0e" mq:lastchangedtimestamp="0001-01-01T00:00:00Z" mq:maxlengthchars="-1" mq:nosplitjoin="false" mq:firstlabel="478" mq:lastlabel="478" mq:autosplitjoinstate="0" mq:lastmodifrole="0" mq:multipleexactmatch="false">
<source xml:space="preserve" mq:segpart="478" mq:hasfollowingobject="hasfollowingobject">Foam plastics and materials containing foam plastics shall comply with Section 2603 and the International Fire Code.</source>
<target xml:space="preserve"></target>
<context-group>
<context context-type="x-mmq-structural-context">trans-units / trans-unit#851 / struct-rpr#1</context>
</context-group>
