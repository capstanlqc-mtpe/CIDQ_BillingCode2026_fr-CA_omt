<trans-unit id="470" mq:status="NotStarted" mq:segmentguid="2f3c66cf-d159-4a95-ac0f-0568d352139d" mq:lastchangedtimestamp="0001-01-01T00:00:00Z" mq:maxlengthchars="-1" mq:nosplitjoin="false" mq:firstlabel="387" mq:lastlabel="387" mq:autosplitjoinstate="0" mq:lastmodifrole="0" mq:multipleexactmatch="false">
<source xml:space="preserve" mq:segpart="387" mq:hasfollowingobject="hasfollowingobject">Scissor stairways shall not be considered the additional interior exit stairway required by this section.</source>
<target xml:space="preserve"></target>
<context-group>
<context context-type="x-mmq-structural-context">trans-units / trans-unit#762 / struct-rpr#1</context>
