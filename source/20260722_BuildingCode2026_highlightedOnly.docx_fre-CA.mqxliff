<source xml:space="preserve" mq:segpart="1442" mq:hasfollowingobject="hasfollowingobject">At the top or bottom of the stairs, demarcation lines shall drop vertically to the floor within 2 inches (51 mm) of the step or landing edge.</source>
<target xml:space="preserve"></target>
<context-group>
<context context-type="x-mmq-structural-context">trans-units / trans-unit#5396 / struct-rpr#1</context>
