<source xml:space="preserve" mq:segpart="112" mq:hasfollowingobject="hasfollowingobject">One set of construction documents so reviewed shall be retained by the building official.</source>
<target xml:space="preserve"></target>
<context-group>
<context context-type="x-mmq-structural-context">trans-units / trans-unit#112 / struct-rpr#1</context>
