<source xml:space="preserve" mq:segpart="509" mq:hasfollowingobject="hasfollowingobject"><bpt id="1" ctype="bold">{}</bpt>403.5.1 Remoteness of interior exit stairways.<ept id="1">{}</ept></source>
<target xml:space="preserve"></target>
<context-group>
<context context-type="x-mmq-structural-context">trans-units / trans-unit#497 / struct-rpr#1</context>
</context-group>
<mq:startingws xml:space="preserve" />
<mq:endingws xml:space="preserve" />
<mq:commitinfos xmlns="MQXliff" /><mq:nosplitjoins />
<mq:originalsource edited="false" />
