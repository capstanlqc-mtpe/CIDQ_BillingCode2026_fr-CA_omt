<trans-unit id="2204" mq:status="NotStarted" mq:segmentguid="acc4baee-2748-459d-9cb3-bf3c1681c1d5" mq:lastchangedtimestamp="2026-07-21T07:30:06Z" mq:lastchanginguser="EmmaG" mq:maxlengthchars="-1" mq:nosplitjoin="false" mq:firstlabel="1807" mq:lastlabel="1807" mq:autosplitjoinstate="0" mq:lastmodifrole="0" mq:multipleexactmatch="false">
<source xml:space="preserve" mq:segpart="1807" mq:hasfollowingobject="hasfollowingobject">3.<ph id="1">&lt;mq:ch val=&quot;	&quot; /&gt;</ph>In a building, room or space used for assembly purposes or portions thereof without ramped or tiered floors for seating and with greater than 200 seats, the seats shall be fastened together in groups of not less than three or the seats shall be securely fastened to the floor.</source>
<target xml:space="preserve"></target>
