<trans-unit id="5184" mq:status="NotStarted" mq:segmentguid="f092a8af-4fbe-45b2-8c31-9cd3a22d6122" mq:lastchangedtimestamp="0001-01-01T00:00:00Z" mq:maxlengthchars="-1" mq:nosplitjoin="false" mq:firstlabel="3989" mq:lastlabel="3989" mq:autosplitjoinstate="0" mq:lastmodifrole="0" mq:multipleexactmatch="false">
<source xml:space="preserve" mq:segpart="3989" mq:hasfollowingobject="hasfollowingobject">A sign language interpreter station shall provide a level and clear floor of a minimum size of 24 inches (610 mm) deep and 36 inches (915 mm) wide that is located to provide a direct line of sight from the seating area identified in Section 802.11.3.</source>
<target xml:space="preserve"></target>
<context-group>
<context context-type="x-mmq-structural-context">trans-units / trans-unit#8938 / struct-rpr#1</context>
</context-group>
