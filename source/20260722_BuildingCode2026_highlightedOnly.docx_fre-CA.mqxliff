<trans-unit id="4097" mq:status="NotStarted" mq:segmentguid="324135bd-c2ad-4b21-8723-29d9bdf04084" mq:lastchangedtimestamp="0001-01-01T00:00:00Z" mq:maxlengthchars="-1" mq:nosplitjoin="false" mq:firstlabel="3201" mq:lastlabel="3201" mq:autosplitjoinstate="0" mq:lastmodifrole="0" mq:multipleexactmatch="false">
<source xml:space="preserve" mq:segpart="3201" mq:hasfollowingobject="hasfollowingobject">Openings in floor surfaces shall be of a size that does not permit the passage of a 1/2 inch (13 mm) diameter sphere, except as allowed in Sections 407.4.3, 408.4.3, 409.4.3, 410.4, and 805.10.</source>
<target xml:space="preserve"></target>
<context-group>
