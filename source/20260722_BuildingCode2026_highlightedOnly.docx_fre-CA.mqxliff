<trans-unit id="5297" mq:status="NotStarted" mq:segmentguid="4d21ad79-6848-495c-8efb-09d9796cc43c" mq:lastchangedtimestamp="0001-01-01T00:00:00Z" mq:maxlengthchars="-1" mq:nosplitjoin="false" mq:firstlabel="4087" mq:lastlabel="4087" mq:autosplitjoinstate="0" mq:lastmodifrole="0" mq:multipleexactmatch="false">
<source xml:space="preserve" mq:segpart="4087" mq:hasfollowingobject="hasfollowingobject">Classroom ambient sound levels shall comply with Sections 808.3.1 and 808.3.2.</source>
<target xml:space="preserve"></target>
<context-group>
<context context-type="x-mmq-structural-context">trans-units / trans-unit#9033 / struct-rpr#1</context>
</context-group>
<mq:startingws xml:space="preserve" />
<mq:endingws xml:space="preserve"> </mq:endingws>
<mq:commitinfos xmlns="MQXliff" /><mq:nosplitjoins />
