<trans-unit id="1838" mq:status="NotStarted" mq:segmentguid="a2548642-e80e-48eb-bf2f-218971c411b3" mq:lastchangedtimestamp="0001-01-01T00:00:00Z" mq:maxlengthchars="-1" mq:nosplitjoin="false" mq:firstlabel="1504" mq:lastlabel="1504" mq:autosplitjoinstate="0" mq:lastmodifrole="0" mq:multipleexactmatch="false">
<source xml:space="preserve" mq:segpart="1504" mq:hasfollowingobject="hasfollowingobject">The egress path from the interior exit stairway and ramp on the level of exit discharge is protected throughout by an approved automatic sprinkler system.</source>
<target xml:space="preserve"></target>
<context-group>
<context context-type="x-mmq-structural-context">trans-units / trans-unit#5470 / struct-rpr#1</context>
</context-group>
<mq:startingws xml:space="preserve" />
<mq:endingws xml:space="preserve"> </mq:endingws>
<mq:commitinfos xmlns="MQXliff" /><mq:nosplitjoins />
<mq:originalsource edited="false" />
</trans-unit>
<trans-unit id="1839" mq:status="NotStarted" mq:segmentguid="f7034733-725d-4821-94fc-a5d8007c2e65" mq:lastchangedtimestamp="0001-01-01T00:00:00Z" mq:maxlengthchars="-1" mq:nosplitjoin="false" mq:firstlabel="1504" mq:lastlabel="1504" mq:autosplitjoinstate="0" mq:lastmodifrole="0" mq:multipleexactmatch="false">
<source xml:space="preserve" mq:segpart="1504" mq:hasfollowingobject="hasfollowingobject">Portions of the level of exit discharge with access to the egress path shall be either equipped throughout with an automatic sprinkler system installed in accordance with Section 903.3.1.1 or 903.3.1.2, or separated from the egress path in accordance with the requirements for the enclosure of interior exit stairways or ramps.</source>
<target xml:space="preserve"></target>
<context-group>
<context context-type="x-mmq-structural-context">trans-units / trans-unit#5470 / struct-rpr#1</context>
</context-group>
<mq:startingws xml:space="preserve" />
<mq:endingws xml:space="preserve" />
<mq:commitinfos xmlns="MQXliff" /><mq:nosplitjoins />
<mq:originalsource edited="false" />
</trans-unit>
<trans-unit id="1840" mq:status="NotStarted" mq:segmentguid="0e13b389-8cc1-4c32-8845-ee266684678d" mq:lastchangedtimestamp="0001-01-01T00:00:00Z" mq:maxlengthchars="-1" mq:nosplitjoin="false" mq:firstlabel="1505" mq:lastlabel="1505" mq:autosplitjoinstate="0" mq:lastmodifrole="0" mq:multipleexactmatch="false">
<source xml:space="preserve" mq:segpart="1505" mq:hasfollowingobject="hasfollowingobject">Where a required interior exit stairway or ramp and an exit access stairway or ramp serve the same floor level and terminate at the same level of exit discharge, the termination of the exit access stairway or ramp and the exit discharge door of the interior exit stairway or ramp shall be separated by a distance of not less than 30 feet (9144 mm) or not less than one-fourth the length of the maximum overall diagonal dimension of the building, whichever is less.</source>
<target xml:space="preserve"></target>
<context-group>
<context context-type="x-mmq-structural-context">trans-units / trans-unit#5471 / struct-rpr#1</context>
</context-group>
<mq:startingws xml:space="preserve" />
<mq:endingws xml:space="preserve"> </mq:endingws>
<mq:commitinfos xmlns="MQXliff" /><mq:nosplitjoins />
<mq:originalsource edited="false" />
</trans-unit>
<trans-unit id="1841" mq:status="NotStarted" mq:segmentguid="ce6ca22e-c82c-4b1b-9c97-8ab0f2bef827" mq:lastchangedtimestamp="0001-01-01T00:00:00Z" mq:maxlengthchars="-1" mq:nosplitjoin="false" mq:firstlabel="1505" mq:lastlabel="1505" mq:autosplitjoinstate="0" mq:lastmodifrole="0" mq:multipleexactmatch="false">
<source xml:space="preserve" mq:segpart="1505" mq:hasfollowingobject="hasfollowingobject">The distance shall be measured in a straight line between the exit discharge door from the interior exit stairway or ramp and the last tread of the exit access stairway or termination of slope of the exit access ramp.</source>
<target xml:space="preserve"></target>
<context-group>
<context context-type="x-mmq-structural-context">trans-units / trans-unit#5471 / struct-rpr#1</context>
</context-group>
