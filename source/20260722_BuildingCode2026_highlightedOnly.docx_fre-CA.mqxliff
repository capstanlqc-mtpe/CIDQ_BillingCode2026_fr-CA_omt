<trans-unit id="3715" mq:status="NotStarted" mq:segmentguid="27c32e53-98d9-49db-b9d5-6e2dc3f98dc9" mq:lastchangedtimestamp="0001-01-01T00:00:00Z" mq:maxlengthchars="-1" mq:nosplitjoin="false" mq:firstlabel="2979" mq:lastlabel="2979" mq:autosplitjoinstate="0" mq:lastmodifrole="0" mq:multipleexactmatch="false">
<source xml:space="preserve" mq:segpart="2979" mq:hasfollowingobject="hasfollowingobject">Straps shall be hooked around the outer bars and extend 6 inches (152 mm) beyond the bend.</source>
<target xml:space="preserve"></target>
<context-group>
<context context-type="x-mmq-structural-context">trans-units / trans-unit#7057 / struct-rpr#1</context>
</context-group>
