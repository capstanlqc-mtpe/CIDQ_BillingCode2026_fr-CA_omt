<source xml:space="preserve" mq:segpart="1829" mq:hasfollowingobject="hasfollowingobject">Perimeter guards shall be provided where the footboards or walking surface of seating facilities are more than 30 inches (762 mm) above the floor or grade below.</source>
<target xml:space="preserve"></target>
