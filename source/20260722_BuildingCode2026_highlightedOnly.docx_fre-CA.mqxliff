</trans-unit>
<trans-unit id="4098" mq:status="NotStarted" mq:segmentguid="9a44dd5c-aae4-4d71-8b4c-cdc3d56051e6" mq:lastchangedtimestamp="0001-01-01T00:00:00Z" mq:maxlengthchars="-1" mq:nosplitjoin="false" mq:firstlabel="3201" mq:lastlabel="3201" mq:autosplitjoinstate="0" mq:lastmodifrole="0" mq:multipleexactmatch="false">
<source xml:space="preserve" mq:segpart="3201" mq:hasfollowingobject="hasfollowingobject">Elongated openings shall be placed so that the long dimension is perpendicular to the predominant direction of travel.</source>
