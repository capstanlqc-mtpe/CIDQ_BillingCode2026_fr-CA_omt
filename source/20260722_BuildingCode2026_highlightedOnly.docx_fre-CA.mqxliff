<trans-unit id="1594" mq:status="NotStarted" mq:segmentguid="de4c5382-115e-4968-bc28-2a5a51598ff8" mq:lastchangedtimestamp="0001-01-01T00:00:00Z" mq:maxlengthchars="-1" mq:nosplitjoin="false" mq:firstlabel="1325" mq:lastlabel="1325" mq:autosplitjoinstate="0" mq:lastmodifrole="0" mq:multipleexactmatch="false">
<source xml:space="preserve" mq:segpart="1325" mq:hasfollowingobject="hasfollowingobject">Where interior exit stairways and ramps are extended to an exit discharge or a public way by an exit passageway, the interior exit stairway and ramp shall be separated from the exit passageway by a fire barrier constructed in accordance with Section 707 or a horizontal assembly constructed in accordance with Section 711, or both.</source>
<target xml:space="preserve"></target>
<context-group>
<context context-type="x-mmq-structural-context">trans-units / trans-unit#5281 / struct-rpr#1</context>
</context-group>
<mq:startingws xml:space="preserve" />
<mq:endingws xml:space="preserve"> </mq:endingws>
<mq:commitinfos xmlns="MQXliff" /><mq:nosplitjoins />
<mq:originalsource edited="false" />
</trans-unit>
<trans-unit id="1595" mq:status="NotStarted" mq:segmentguid="b8591c66-4715-4b38-968c-51aa6b146f69" mq:lastchangedtimestamp="0001-01-01T00:00:00Z" mq:maxlengthchars="-1" mq:nosplitjoin="false" mq:firstlabel="1325" mq:lastlabel="1325" mq:autosplitjoinstate="0" mq:lastmodifrole="0" mq:multipleexactmatch="false">
<source xml:space="preserve" mq:segpart="1325" mq:hasfollowingobject="hasfollowingobject">The fire-resistance rating shall be not less than that required for the interior exit stairway and ramp.</source>
<target xml:space="preserve"></target>
<context-group>
<context context-type="x-mmq-structural-context">trans-units / trans-unit#5281 / struct-rpr#1</context>
</context-group>
<mq:startingws xml:space="preserve" />
<mq:endingws xml:space="preserve"> </mq:endingws>
<mq:commitinfos xmlns="MQXliff" /><mq:nosplitjoins />
<mq:originalsource edited="false" />
</trans-unit>
<trans-unit id="1596" mq:status="NotStarted" mq:segmentguid="cf23d0d5-6a06-411e-b9ce-18aaee29b0ce" mq:lastchangedtimestamp="0001-01-01T00:00:00Z" mq:maxlengthchars="-1" mq:nosplitjoin="false" mq:firstlabel="1325" mq:lastlabel="1325" mq:autosplitjoinstate="0" mq:lastmodifrole="0" mq:multipleexactmatch="false">
<source xml:space="preserve" mq:segpart="1325" mq:hasfollowingobject="hasfollowingobject">A fire door assembly complying with Section 716 shall be installed in the fire barrier to provide a means of egress from the interior exit stairway and ramp to the exit passageway.</source>
<target xml:space="preserve"></target>
<context-group>
