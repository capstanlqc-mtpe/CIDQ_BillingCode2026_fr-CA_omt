<source xml:space="preserve" mq:segpart="121" mq:hasfollowingobject="hasfollowingobject">Deferral of any submittal items shall have the prior approval of the building official.</source>
<target xml:space="preserve"></target>
<context-group>
<context context-type="x-mmq-structural-context">trans-units / trans-unit#121 / struct-rpr#1</context>
