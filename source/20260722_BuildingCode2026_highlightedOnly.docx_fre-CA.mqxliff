<trans-unit id="529" mq:status="NotStarted" mq:segmentguid="a292ab11-6787-4766-b393-b8ceef833fd9" mq:lastchangedtimestamp="0001-01-01T00:00:00Z" mq:maxlengthchars="-1" mq:nosplitjoin="false" mq:firstlabel="458" mq:lastlabel="458" mq:autosplitjoinstate="0" mq:lastmodifrole="0" mq:multipleexactmatch="false">
<source xml:space="preserve" mq:segpart="458" mq:hasfollowingobject="hasfollowingobject">The secondary water supply shall have a duration of not less than 30 minutes as determined by the occupancy hazard classification in accordance with NFPA 13.</source>
<target xml:space="preserve"></target>
