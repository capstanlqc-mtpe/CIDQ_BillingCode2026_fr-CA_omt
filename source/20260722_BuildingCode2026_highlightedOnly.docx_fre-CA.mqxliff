<mq:originalsource edited="false" />
</trans-unit>
<trans-unit id="2165" mq:status="NotStarted" mq:segmentguid="58b4f22c-0db6-4ec0-98c4-48a24f050c62" mq:lastchangedtimestamp="0001-01-01T00:00:00Z" mq:maxlengthchars="-1" mq:nosplitjoin="false" mq:firstlabel="1777" mq:lastlabel="1777" mq:autosplitjoinstate="0" mq:lastmodifrole="0" mq:multipleexactmatch="false">
<source xml:space="preserve" mq:segpart="1777" mq:hasfollowingobject="hasfollowingobject">The slope of other ramped aisles shall not exceed 1 unit vertical in 8 units horizontal (12.5-percent slope).</source>
<target xml:space="preserve"></target>
