<source xml:space="preserve" mq:segpart="477" mq:hasfollowingobject="hasfollowingobject">Easily identifiable, manually operable windows or panels shall be distributed around the perimeter of each floor at not more than 50-foot (15 240 mm) intervals.</source>
<target xml:space="preserve"></target>
<context-group>
