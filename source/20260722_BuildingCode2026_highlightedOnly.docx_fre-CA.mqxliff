<source xml:space="preserve" mq:segpart="1812" mq:hasfollowingobject="hasfollowingobject">Where two handrails are required, one of the handrails shall be within 30 inches (762 mm) horizontally of the stepped aisle.</source>
<target xml:space="preserve"></target>
