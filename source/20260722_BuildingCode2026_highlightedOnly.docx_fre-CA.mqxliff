<source xml:space="preserve" mq:segpart="722" mq:hasfollowingobject="hasfollowingobject"><bpt id="1" ctype="bold">{}</bpt>712.1.3.2 Automatic shutters.<ept id="1">{}</ept></source>
<target xml:space="preserve"></target>
<context-group>
