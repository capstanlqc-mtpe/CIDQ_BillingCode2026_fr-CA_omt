<source xml:space="preserve" mq:segpart="471" mq:hasfollowingobject="hasfollowingobject"><bpt id="1" ctype="bold">{}</bpt>410.2.3 Exterior stage doors.<ept id="1">{}</ept></source>
<target xml:space="preserve"></target>
<context-group>
<context context-type="x-mmq-structural-context">trans-units / trans-unit#844 / struct-rpr#1</context>
</context-group>
<mq:startingws xml:space="preserve" />
<mq:endingws xml:space="preserve" />
<mq:commitinfos xmlns="MQXliff" /><mq:nosplitjoins />
<mq:originalsource edited="false" />
