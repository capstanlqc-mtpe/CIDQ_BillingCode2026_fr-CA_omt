<trans-unit id="649" mq:status="NotStarted" mq:segmentguid="67f245ef-7466-4ac9-8181-b885fdc9ad55" mq:lastchangedtimestamp="0001-01-01T00:00:00Z" mq:maxlengthchars="-1" mq:nosplitjoin="false" mq:firstlabel="557" mq:lastlabel="557" mq:autosplitjoinstate="0" mq:lastmodifrole="0" mq:multipleexactmatch="false">
<source xml:space="preserve" mq:segpart="557" mq:hasfollowingobject="hasfollowingobject">The glass wall shall be installed in a gasketed frame in a manner that the framing system deflects without breaking (loading) the glass before the sprinkler system operates; and</source>
<target xml:space="preserve"></target>
<context-group>
<context context-type="x-mmq-structural-context">trans-units / trans-unit#544 / struct-rpr#1</context>
</context-group>
