<mq:originalsource edited="false" />
</trans-unit>
<trans-unit id="377" mq:status="NotStarted" mq:segmentguid="5fe3fb20-6d2a-4a22-9cff-5e7d8cf60a88" mq:lastchangedtimestamp="0001-01-01T00:00:00Z" mq:maxlengthchars="-1" mq:nosplitjoin="false" mq:firstlabel="315" mq:lastlabel="315" mq:autosplitjoinstate="0" mq:lastmodifrole="0" mq:multipleexactmatch="false">
<source xml:space="preserve" mq:segpart="315" mq:hasfollowingobject="hasfollowingobject">The wall assembly incorporates multiple layers of any material, tested in tandem, that meets or exceeds Hard Body Impact Classification Level 3 as measured by the test method described in ASTM C1629/C1629M.</source>
<target xml:space="preserve"></target>
<context-group>
<context context-type="x-mmq-structural-context">trans-units / trans-unit#690 / struct-rpr#1</context>
</context-group>
