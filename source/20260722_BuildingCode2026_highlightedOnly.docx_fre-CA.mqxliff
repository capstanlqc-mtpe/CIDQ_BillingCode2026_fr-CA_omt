<trans-unit id="1754" mq:status="NotStarted" mq:segmentguid="ff63ed5c-a1e1-4d5b-b634-70adf765e8d7" mq:lastchangedtimestamp="0001-01-01T00:00:00Z" mq:maxlengthchars="-1" mq:nosplitjoin="false" mq:firstlabel="1442" mq:lastlabel="1442" mq:autosplitjoinstate="0" mq:lastmodifrole="0" mq:multipleexactmatch="false">
<source xml:space="preserve" mq:segpart="1442" mq:hasfollowingobject="hasfollowingobject">Demarcation lines on walls shall transition vertically to the floor and then extend across the floor where a line on the floor is the only practical method of outlining the path.</source>
<target xml:space="preserve"></target>
<context-group>
<context context-type="x-mmq-structural-context">trans-units / trans-unit#5396 / struct-rpr#1</context>
</context-group>
