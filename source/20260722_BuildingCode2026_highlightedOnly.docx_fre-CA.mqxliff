<source xml:space="preserve" mq:segpart="1030" mq:hasfollowingobject="hasfollowingobject"><bpt id="1" ctype="bold">{}</bpt>[F] 907.2.1.2 Emergency voice/alarm communication captions.<ept id="1">{}</ept></source>
