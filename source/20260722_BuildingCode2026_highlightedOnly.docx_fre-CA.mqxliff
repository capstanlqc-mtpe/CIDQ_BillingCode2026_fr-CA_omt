<source xml:space="preserve" mq:segpart="1709" mq:hasfollowingobject="hasfollowingobject"><bpt id="1" ctype="bold">{}</bpt>1030.13.1.1 Aisle accessway capacity and width for seating at tables.<ept id="1">{}</ept></source>
