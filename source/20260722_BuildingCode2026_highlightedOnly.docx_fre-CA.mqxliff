<source xml:space="preserve" mq:segpart="519" mq:hasfollowingobject="hasfollowingobject">A telephone or other two-way communications system connected to an approved constantly attended station shall be provided at not less than every fifth floor in each stairway where the doors to the stairway are locked.</source>
<target xml:space="preserve"></target>
<context-group>
