<source xml:space="preserve" mq:segpart="2994" mq:hasfollowingobject="hasfollowingobject">Firebrick shall conform to ASTM C1261 and shall be laid with medium-duty refractory mortar conforming to ASTM C199.</source>
<target xml:space="preserve"></target>
<context-group>
