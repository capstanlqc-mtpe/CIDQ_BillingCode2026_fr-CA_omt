<trans-unit id="3711" mq:status="NotStarted" mq:segmentguid="6e7a8348-34dc-4733-a1ae-88538b6eb88e" mq:lastchangedtimestamp="0001-01-01T00:00:00Z" mq:maxlengthchars="-1" mq:nosplitjoin="false" mq:firstlabel="2977" mq:lastlabel="2977" mq:autosplitjoinstate="0" mq:lastmodifrole="0" mq:multipleexactmatch="false">
<source xml:space="preserve" mq:segpart="2977" mq:hasfollowingobject="hasfollowingobject">Masonry or concrete chimneys in Seismic Design Category D0, D1 or D2 shall be anchored at each floor, ceiling or roof line more than 6 feet (1829 mm) above grade, except where constructed completely within the exterior walls.</source>
<target xml:space="preserve"></target>
