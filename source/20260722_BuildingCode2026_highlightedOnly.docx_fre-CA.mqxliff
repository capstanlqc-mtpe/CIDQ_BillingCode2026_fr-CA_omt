<source xml:space="preserve" mq:segpart="245" mq:hasfollowingobject="hasfollowingobject"><bpt id="1" ctype="bold">{}</bpt>[A] 107.3.4.1 Deferred submittals.<ept id="1">{}</ept></source>
<target xml:space="preserve"></target>
<context-group>
