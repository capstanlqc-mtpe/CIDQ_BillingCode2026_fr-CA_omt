<trans-unit id="280" mq:status="NotStarted" mq:segmentguid="e870a807-6968-427e-9c12-9fec4d4d09b1" mq:lastchangedtimestamp="0001-01-01T00:00:00Z" mq:maxlengthchars="-1" mq:nosplitjoin="false" mq:firstlabel="246" mq:lastlabel="246" mq:autosplitjoinstate="0" mq:lastmodifrole="0" mq:multipleexactmatch="false">
<source xml:space="preserve" mq:segpart="246" mq:hasfollowingobject="hasfollowingobject">Deferral of any submittal items shall have the prior approval of the building official.</source>
<target xml:space="preserve"></target>
<context-group>
<context context-type="x-mmq-structural-context">trans-units / trans-unit#243 / struct-rpr#1</context>
