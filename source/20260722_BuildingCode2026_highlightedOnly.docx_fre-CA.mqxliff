<source xml:space="preserve" mq:segpart="3874" mq:hasfollowingobject="hasfollowingobject">The shoulder of the wheelchair space occupant is considered to be 36 inches (915 mm) or more from the front and 12 inches (305 mm) or more from the rear of the wheelchair space.</source>
<target xml:space="preserve"></target>
<context-group>
<context context-type="x-mmq-structural-context">trans-units / trans-unit#8824 / struct-rpr#1</context>
