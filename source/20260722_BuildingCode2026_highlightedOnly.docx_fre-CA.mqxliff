<source xml:space="preserve" mq:segpart="2200" mq:hasfollowingobject="hasfollowingobject">Except as provided for in Sections 1109.2.2 and 1109.2.3, at least one of each type of fixture, element, control or dispenser in each accessible toilet room and bathing room shall be <bpt id="1" ctype="italic">{}</bpt>accessible<ept id="1">{}</ept>.<ph id="2">&lt;/rpr id=&quot;5&quot; transform=&quot;close&quot;&gt;</ph></source>
