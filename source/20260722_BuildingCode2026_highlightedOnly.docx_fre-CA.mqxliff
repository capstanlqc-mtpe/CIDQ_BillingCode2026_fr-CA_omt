<source xml:space="preserve" mq:segpart="2986" mq:hasfollowingobject="hasfollowingobject"><bpt id="1" ctype="bold">{}</bpt>R1001.6 Firebox dimensions.<ept id="1">{}</ept></source>
<target xml:space="preserve"></target>
<context-group>
