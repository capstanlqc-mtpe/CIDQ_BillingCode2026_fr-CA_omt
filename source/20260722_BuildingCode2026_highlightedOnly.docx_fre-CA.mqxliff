<trans-unit id="466" mq:status="NotStarted" mq:segmentguid="771215bb-ab65-4be9-82bf-ae95207727de" mq:lastchangedtimestamp="0001-01-01T00:00:00Z" mq:maxlengthchars="-1" mq:nosplitjoin="false" mq:firstlabel="385" mq:lastlabel="385" mq:autosplitjoinstate="0" mq:lastmodifrole="0" mq:multipleexactmatch="false">
<source xml:space="preserve" mq:segpart="385" mq:hasfollowingobject="hasfollowingobject">Interlocking or scissor stairways shall be counted as one interior exit stairway.</source>
<target xml:space="preserve"></target>
<context-group>
