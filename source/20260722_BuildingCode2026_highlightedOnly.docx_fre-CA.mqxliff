<trans-unit id="5132" mq:status="NotStarted" mq:segmentguid="642acd73-fac9-481d-8bab-d40fe474e3c7" mq:lastchangedtimestamp="2026-07-21T07:30:06Z" mq:lastchanginguser="EmmaG" mq:maxlengthchars="-1" mq:nosplitjoin="false" mq:firstlabel="3947" mq:lastlabel="3947" mq:autosplitjoinstate="0" mq:lastmodifrole="0" mq:multipleexactmatch="false">
<source xml:space="preserve" mq:segpart="3947" mq:hasfollowingobject="hasfollowingobject"><bpt id="1" ctype="x-sup">{}</bpt><ph id="2">&lt;rpr id=&quot;117&quot;&gt;</ph>5<ept id="1">{}</ept>Table 802.9.2.2 is based on providing a spectator in a wheelchair a line of sight over the head of a spectator two rows in front of the wheelchair space location using average anthropometrical data.</source>
<target xml:space="preserve"></target>
<context-group>
<context context-type="x-mmq-structural-context">trans-units / trans-unit#8897</context>
</context-group>
<mq:warnings40>
