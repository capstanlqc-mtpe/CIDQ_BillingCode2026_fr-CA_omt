<source xml:space="preserve" mq:segpart="1442" mq:hasfollowingobject="hasfollowingobject">Perimeter demarcation lines shall be placed on the wall with the bottom edge of the stripe not more than 4 inches (102 mm) above the finished floor.</source>
<target xml:space="preserve"></target>
<context-group>
