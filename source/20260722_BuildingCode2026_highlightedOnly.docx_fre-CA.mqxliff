<mq:commitinfos xmlns="MQXliff" /><mq:nosplitjoins />
<mq:originalsource edited="false" />
</trans-unit>
<trans-unit id="972" mq:status="NotStarted" mq:segmentguid="27db5453-31dc-41fa-873c-751b4a0af128" mq:lastchangedtimestamp="0001-01-01T00:00:00Z" mq:maxlengthchars="-1" mq:nosplitjoin="false" mq:firstlabel="801" mq:lastlabel="801" mq:autosplitjoinstate="0" mq:lastmodifrole="0" mq:multipleexactmatch="false">
<source xml:space="preserve" mq:segpart="801" mq:hasfollowingobject="hasfollowingobject">Carpet-type floor coverings shall be tested as proposed for use, including underlayment.</source>
<target xml:space="preserve"></target>
<context-group>
