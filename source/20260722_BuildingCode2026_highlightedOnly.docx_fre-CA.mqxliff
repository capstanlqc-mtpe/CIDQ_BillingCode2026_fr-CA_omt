<trans-unit id="998" mq:status="NotStarted" mq:segmentguid="0bd017b9-bce2-48da-976b-8f97fd4e0276" mq:lastchangedtimestamp="0001-01-01T00:00:00Z" mq:maxlengthchars="-1" mq:nosplitjoin="false" mq:firstlabel="823" mq:lastlabel="823" mq:autosplitjoinstate="0" mq:lastmodifrole="0" mq:multipleexactmatch="false">
<source xml:space="preserve" mq:segpart="823" mq:hasfollowingobject="hasfollowingobject">The following requirements shall apply to all occupancies:</source>
<target xml:space="preserve"></target>
<context-group>
<context context-type="x-mmq-structural-context">trans-units / trans-unit#3972 / struct-rpr#1</context>
</context-group>
