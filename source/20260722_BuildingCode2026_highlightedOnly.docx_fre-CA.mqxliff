<source xml:space="preserve" mq:segpart="3994" mq:hasfollowingobject="hasfollowingobject"><bpt id="1" ctype="bold">{}</bpt>802.11.5 Backdrop.<ept id="1">{}</ept></source>
<target xml:space="preserve"></target>
