<trans-unit id="2249" mq:status="NotStarted" mq:segmentguid="3f665264-6dd2-41d4-a0fd-2364bb952f42" mq:lastchangedtimestamp="0001-01-01T00:00:00Z" mq:maxlengthchars="-1" mq:nosplitjoin="false" mq:firstlabel="1838" mq:lastlabel="1838" mq:autosplitjoinstate="0" mq:lastmodifrole="0" mq:multipleexactmatch="false">
<source xml:space="preserve" mq:segpart="1838" mq:hasfollowingobject="hasfollowingobject">Unless subject to the requirements of Section 1030.17.4, a fascia or railing system in accordance with the guard requirements of Section 1015 and having a minimum height of 26 inches (660 mm) shall be provided where the floor or footboard elevation is more than 30 inches (762 mm) above the floor or grade below and the fascia or railing would otherwise interfere with the sightlines of immediately adjacent seating.</source>
<target xml:space="preserve"></target>
<context-group>
<context context-type="x-mmq-structural-context">trans-units / trans-unit#5802 / struct-rpr#1</context>
