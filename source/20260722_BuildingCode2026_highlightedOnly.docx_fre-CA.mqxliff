<trans-unit id="1231" mq:status="NotStarted" mq:segmentguid="73f40328-6e09-4634-ad0f-89e755cd23dc" mq:lastchangedtimestamp="0001-01-01T00:00:00Z" mq:maxlengthchars="-1" mq:nosplitjoin="false" mq:firstlabel="1026" mq:lastlabel="1026" mq:autosplitjoinstate="0" mq:lastmodifrole="0" mq:multipleexactmatch="false">
<source xml:space="preserve" mq:segpart="1026" mq:hasfollowingobject="hasfollowingobject">Manual fire alarm boxes are not required where the building is equipped throughout with an automatic sprinkler system installed in accordance with Section 903.3.1.1 and the occupant notification appliances will activate throughout the notification zones upon sprinkler water flow.</source>
<target xml:space="preserve"></target>
<context-group>
<context context-type="x-mmq-structural-context">trans-units / trans-unit#4174 / struct-rpr#1</context>
</context-group>
