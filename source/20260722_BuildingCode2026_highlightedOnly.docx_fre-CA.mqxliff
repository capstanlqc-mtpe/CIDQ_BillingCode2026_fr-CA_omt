<mq:originalsource edited="false" />
</trans-unit>
<trans-unit id="1820" mq:status="NotStarted" mq:segmentguid="36762761-4d98-41bd-bc03-951a841e3025" mq:lastchangedtimestamp="0001-01-01T00:00:00Z" mq:maxlengthchars="-1" mq:nosplitjoin="false" mq:firstlabel="1490" mq:lastlabel="1490" mq:autosplitjoinstate="0" mq:lastmodifrole="0" mq:multipleexactmatch="false">
<source xml:space="preserve" mq:segpart="1490" mq:hasfollowingobject="hasfollowingobject">The open-ended corridors are connected on each end to an exterior exit stairway or ramp complying with Section 1027.</source>
<target xml:space="preserve"></target>
<context-group>
<context context-type="x-mmq-structural-context">trans-units / trans-unit#5457 / struct-rpr#1</context>
</context-group>
<mq:startingws xml:space="preserve" />
<mq:endingws xml:space="preserve" />
<mq:commitinfos xmlns="MQXliff" /><mq:nosplitjoins />
<mq:originalsource edited="false" />
