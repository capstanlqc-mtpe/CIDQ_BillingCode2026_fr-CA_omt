<source xml:space="preserve" mq:segpart="2857" mq:hasfollowingobject="hasfollowingobject">Where a fuel-burning appliance is located within a bedroom or its attached bathroom, a carbon monoxide alarm shall be installed within the bedroom.</source>
<target xml:space="preserve"></target>
