<source xml:space="preserve" mq:segpart="4086" mq:hasfollowingobject="hasfollowingobject"><bpt id="1" ctype="bold">{}</bpt>808.3 Ambient sound level.<ept id="1">{}</ept></source>
<target xml:space="preserve"></target>
