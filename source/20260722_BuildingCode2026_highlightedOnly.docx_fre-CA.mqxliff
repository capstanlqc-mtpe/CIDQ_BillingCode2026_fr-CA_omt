<source xml:space="preserve" mq:segpart="713" mq:hasfollowingobject="hasfollowingobject">Each vertical opening shall comply in accordance with one of the protection methods in Sections 712.1.1 through 712.1.16.</source>
<target xml:space="preserve"></target>
