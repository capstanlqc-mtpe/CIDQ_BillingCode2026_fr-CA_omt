<source xml:space="preserve" mq:segpart="1506" mq:hasfollowingobject="hasfollowingobject">Not more than 50 percent of the number and minimum width or required capacity of the interior exit stairways and ramps is permitted to egress through a vestibule provided that all of the following conditions are met:</source>
<target xml:space="preserve"></target>
<context-group>
