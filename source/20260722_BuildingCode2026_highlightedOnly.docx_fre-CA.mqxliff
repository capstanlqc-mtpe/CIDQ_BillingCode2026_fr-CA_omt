<source xml:space="preserve" mq:segpart="222" mq:hasfollowingobject="hasfollowingobject">Construction documents for all buildings shall describe the exterior wall envelope in sufficient detail to determine compliance with this code.</source>
<target xml:space="preserve"></target>
<context-group>
<context context-type="x-mmq-structural-context">trans-units / trans-unit#219 / struct-rpr#1</context>
</context-group>
