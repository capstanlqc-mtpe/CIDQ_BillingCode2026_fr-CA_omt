<trans-unit id="281" mq:status="NotStarted" mq:segmentguid="b0cc2320-97e0-481c-b9d6-c7212f1987e4" mq:lastchangedtimestamp="0001-01-01T00:00:00Z" mq:maxlengthchars="-1" mq:nosplitjoin="false" mq:firstlabel="246" mq:lastlabel="246" mq:autosplitjoinstate="0" mq:lastmodifrole="0" mq:multipleexactmatch="false">
<source xml:space="preserve" mq:segpart="246" mq:hasfollowingobject="hasfollowingobject">The registered design professional in responsible charge shall list the deferred submittals on the construction documents for review by the building official.</source>
<target xml:space="preserve"></target>
<context-group>
<context context-type="x-mmq-structural-context">trans-units / trans-unit#243 / struct-rpr#1</context>
</context-group>
<mq:startingws xml:space="preserve" />
