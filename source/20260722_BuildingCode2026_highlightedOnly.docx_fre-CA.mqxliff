<trans-unit id="157" mq:status="NotStarted" mq:segmentguid="e1048616-f3e3-441d-a7ae-c3a899d9c8ee" mq:lastchangedtimestamp="0001-01-01T00:00:00Z" mq:maxlengthchars="-1" mq:nosplitjoin="false" mq:firstlabel="122" mq:lastlabel="122" mq:autosplitjoinstate="0" mq:lastmodifrole="0" mq:multipleexactmatch="false">
<source xml:space="preserve" mq:segpart="122" mq:hasfollowingobject="hasfollowingobject">The deferred submittal items shall not be installed until the deferred submittal documents have been approved by the building official.</source>
<target xml:space="preserve"></target>
