<source xml:space="preserve" mq:segpart="2265" mq:hasfollowingobject="hasfollowingobject"><bpt id="1" ctype="bold">{}</bpt>1202.5.1 Ventilation area required.<ept id="1">{}</ept></source>
<target xml:space="preserve"></target>
<context-group>
