<source xml:space="preserve" mq:segpart="1316" mq:hasfollowingobject="hasfollowingobject">Enclosures for interior exit stairways and ramps shall have a fire-resistance rating not less than the floor assembly penetrated, but need not exceed 2 hours.</source>
<target xml:space="preserve"></target>
