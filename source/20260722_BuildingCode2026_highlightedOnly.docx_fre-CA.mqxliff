<mq:endingws xml:space="preserve" />
<mq:commitinfos xmlns="MQXliff" /><mq:nosplitjoins />
<mq:originalsource edited="false" />
</trans-unit>
<trans-unit id="523" mq:status="NotStarted" mq:segmentguid="1432c0f4-2c8f-4546-816a-78c383261591" mq:lastchangedtimestamp="0001-01-01T00:00:00Z" mq:maxlengthchars="-1" mq:nosplitjoin="false" mq:firstlabel="432" mq:lastlabel="432" mq:autosplitjoinstate="0" mq:lastmodifrole="0" mq:multipleexactmatch="false">
<source xml:space="preserve" mq:segpart="432" mq:hasfollowingobject="hasfollowingobject">The glass wall shall be installed in a gasketed frame in a manner that the framing system deflects without breaking (loading) the glass before the sprinkler system operates; and</source>
<target xml:space="preserve"></target>
<context-group>
<context context-type="x-mmq-structural-context">trans-units / trans-unit#806 / struct-rpr#1</context>
</context-group>
