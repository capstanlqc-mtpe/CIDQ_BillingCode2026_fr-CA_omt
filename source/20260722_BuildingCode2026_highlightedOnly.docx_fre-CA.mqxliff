<trans-unit id="602" mq:status="NotStarted" mq:segmentguid="0edb78b7-0c57-4622-8c74-ff93f74dbe79" mq:lastchangedtimestamp="0001-01-01T00:00:00Z" mq:maxlengthchars="-1" mq:nosplitjoin="false" mq:firstlabel="517" mq:lastlabel="517" mq:autosplitjoinstate="0" mq:lastmodifrole="0" mq:multipleexactmatch="false">
<source xml:space="preserve" mq:segpart="517" mq:hasfollowingobject="hasfollowingobject">Stairway doors that are locked from the stairway side shall be capable of being unlocked simultaneously without unlatching upon a signal from the fire command center.</source>
<target xml:space="preserve"></target>
<context-group>
<context context-type="x-mmq-structural-context">trans-units / trans-unit#505 / struct-rpr#1</context>
