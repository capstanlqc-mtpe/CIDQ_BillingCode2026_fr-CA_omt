<trans-unit id="3771" mq:status="NotStarted" mq:segmentguid="2430a86b-996c-4fe4-9648-47a5a99562c7" mq:lastchangedtimestamp="0001-01-01T00:00:00Z" mq:maxlengthchars="-1" mq:nosplitjoin="false" mq:firstlabel="3009" mq:lastlabel="3009" mq:autosplitjoinstate="0" mq:lastmodifrole="0" mq:multipleexactmatch="false">
<source xml:space="preserve" mq:segpart="3009" mq:hasfollowingobject="hasfollowingobject">Masonry fireplaces listed and labeled for use in contact with combustibles in accordance with UL 127 and installed in accordance with the manufacturer’s instructions are permitted to have combustible material in contact with their exterior surfaces.</source>
<target xml:space="preserve"></target>
<context-group>
<context context-type="x-mmq-structural-context">trans-units / trans-unit#7087 / struct-rpr#1</context>
</context-group>
<mq:startingws xml:space="preserve" />
<mq:endingws xml:space="preserve" />
<mq:commitinfos xmlns="MQXliff" /><mq:nosplitjoins />
<mq:originalsource edited="false" />
</trans-unit>
<trans-unit id="3772" mq:status="NotStarted" mq:segmentguid="82cc2287-cc5c-4048-8508-6ced77783bde" mq:lastchangedtimestamp="0001-01-01T00:00:00Z" mq:maxlengthchars="-1" mq:nosplitjoin="false" mq:firstlabel="3010" mq:lastlabel="3010" mq:autosplitjoinstate="0" mq:lastmodifrole="0" mq:multipleexactmatch="false">
<source xml:space="preserve" mq:segpart="3010" mq:hasfollowingobject="hasfollowingobject">Where masonry fireplaces are part of masonry or concrete walls, combustible materials shall not be in contact with the masonry or concrete walls less than 12 inches (306 mm) from the inside surface of the nearest firebox lining.</source>
<target xml:space="preserve"></target>
<context-group>
<context context-type="x-mmq-structural-context">trans-units / trans-unit#7088 / struct-rpr#1</context>
</context-group>
<mq:startingws xml:space="preserve" />
<mq:endingws xml:space="preserve" />
<mq:commitinfos xmlns="MQXliff" /><mq:nosplitjoins />
<mq:originalsource edited="false" />
</trans-unit>
<trans-unit id="3773" mq:status="NotStarted" mq:segmentguid="66c2eeb7-c3b0-4d64-93d4-b26057610bb2" mq:lastchangedtimestamp="0001-01-01T00:00:00Z" mq:maxlengthchars="-1" mq:nosplitjoin="false" mq:firstlabel="3011" mq:lastlabel="3011" mq:autosplitjoinstate="0" mq:lastmodifrole="0" mq:multipleexactmatch="false">
<source xml:space="preserve" mq:segpart="3011" mq:hasfollowingobject="hasfollowingobject">Exposed combustible trim and the edges of sheathing materials such as wood siding, flooring and gypsum board shall be permitted to abut the masonry fireplace sidewalls and hearth extension in accordance with Figure R1001.11, provided such combustible trim or sheathing is not less than 12 inches (305 mm) from the inside surface of the nearest firebox lining.</source>
<target xml:space="preserve"></target>
<context-group>
<context context-type="x-mmq-structural-context">trans-units / trans-unit#7089 / struct-rpr#1</context>
</context-group>
<mq:startingws xml:space="preserve" />
<mq:endingws xml:space="preserve" />
<mq:commitinfos xmlns="MQXliff" /><mq:nosplitjoins />
<mq:originalsource edited="false" />
</trans-unit>
<trans-unit id="3774" mq:status="NotStarted" mq:segmentguid="e0e93c4b-22a0-4f4a-96e5-8b0b9582957e" mq:lastchangedtimestamp="0001-01-01T00:00:00Z" mq:maxlengthchars="-1" mq:nosplitjoin="false" mq:firstlabel="3012" mq:lastlabel="3012" mq:autosplitjoinstate="0" mq:lastmodifrole="0" mq:multipleexactmatch="false">
<source xml:space="preserve" mq:segpart="3012" mq:hasfollowingobject="hasfollowingobject">Exposed combustible mantels or trim is permitted to be placed directly on the masonry fireplace front surrounding the fireplace opening providing such combustible materials are not placed within 6 inches (152 mm) of a fireplace opening.</source>
<target xml:space="preserve"></target>
<context-group>
<context context-type="x-mmq-structural-context">trans-units / trans-unit#7090 / struct-rpr#1</context>
</context-group>
<mq:startingws xml:space="preserve" />
<mq:endingws xml:space="preserve"> </mq:endingws>
<mq:commitinfos xmlns="MQXliff" /><mq:nosplitjoins />
<mq:originalsource edited="false" />
</trans-unit>
<trans-unit id="3775" mq:status="NotStarted" mq:segmentguid="5b98f3aa-3ad3-419c-ad12-2265864b2b71" mq:lastchangedtimestamp="0001-01-01T00:00:00Z" mq:maxlengthchars="-1" mq:nosplitjoin="false" mq:firstlabel="3012" mq:lastlabel="3012" mq:autosplitjoinstate="0" mq:lastmodifrole="0" mq:multipleexactmatch="false">
<source xml:space="preserve" mq:segpart="3012" mq:hasfollowingobject="hasfollowingobject">Combustible material within 12 inches (306 mm) of the fireplace opening shall not project more than 1/8 inch (3 mm) for each 1-inch (25 mm) distance from such an opening.</source>
<target xml:space="preserve"></target>
<context-group>
