<trans-unit id="1909" mq:status="NotStarted" mq:segmentguid="1729da20-5bd8-42d5-8c94-903e3d6173d9" mq:lastchangedtimestamp="2026-07-21T07:30:06Z" mq:lastchanginguser="EmmaG" mq:maxlengthchars="-1" mq:nosplitjoin="false" mq:firstlabel="1562" mq:lastlabel="1562" mq:autosplitjoinstate="0" mq:lastmodifrole="0" mq:multipleexactmatch="false">
<source xml:space="preserve" mq:segpart="1562" mq:hasfollowingobject="hasfollowingobject">3.<ph id="1">&lt;mq:ch val=&quot;	&quot; /&gt;</ph>Where egress requires stepped aisle descent, not less than 0.075 inch (1.9 mm) of additional aisle capacity for each occupant shall be provided on those portions of aisle capacity that do not have a handrail within a horizontal distance of 30 inches (762 mm).</source>
<target xml:space="preserve"></target>
