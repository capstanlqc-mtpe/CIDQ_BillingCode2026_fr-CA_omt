<trans-unit id="566" mq:status="NotStarted" mq:segmentguid="cc518598-3f85-4458-8dc9-621e9fe6da3a" mq:lastchangedtimestamp="0001-01-01T00:00:00Z" mq:maxlengthchars="-1" mq:nosplitjoin="false" mq:firstlabel="470" mq:lastlabel="470" mq:autosplitjoinstate="0" mq:lastmodifrole="0" mq:multipleexactmatch="false">
<source xml:space="preserve" mq:segpart="470" mq:hasfollowingobject="hasfollowingobject">Floors of fly galleries and catwalks shall be constructed of any approved material.</source>
<target xml:space="preserve"></target>
<context-group>
