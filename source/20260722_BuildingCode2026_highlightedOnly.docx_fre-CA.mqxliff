<source xml:space="preserve" mq:segpart="132" mq:hasfollowingobject="hasfollowingobject">Where a permit is required, a fee for each permit shall be paid as required, in accordance with the schedule as established by the applicable governing authority.</source>
<target xml:space="preserve"></target>
