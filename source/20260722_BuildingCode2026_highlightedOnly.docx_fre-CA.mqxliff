<source xml:space="preserve" mq:segpart="718" mq:hasfollowingobject="hasfollowingobject"><bpt id="1" ctype="bold">{}</bpt>712.1.3 Escalator openings.<ept id="1">{}</ept></source>
<target xml:space="preserve"></target>
