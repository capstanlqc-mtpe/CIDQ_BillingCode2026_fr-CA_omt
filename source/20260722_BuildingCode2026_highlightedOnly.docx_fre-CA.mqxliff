<source xml:space="preserve" mq:segpart="3990" mq:hasfollowingobject="hasfollowingobject"><bpt id="1" ctype="bold">{}</bpt>802.11.3 Location.<ept id="1">{}</ept></source>
<target xml:space="preserve"></target>
<context-group>
