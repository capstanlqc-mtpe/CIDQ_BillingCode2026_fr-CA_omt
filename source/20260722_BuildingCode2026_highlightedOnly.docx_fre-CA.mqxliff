<source xml:space="preserve" mq:segpart="1714" mq:hasfollowingobject="hasfollowingobject"><bpt id="1" ctype="bold">{}</bpt>1030.13.2 Clear width of aisle accessways serving seating in rows.<ept id="1">{}</ept></source>
<target xml:space="preserve"></target>
<context-group>
