<source xml:space="preserve" mq:segpart="2982" mq:hasfollowingobject="hasfollowingobject"><bpt id="1" ctype="bold">{}</bpt>R1001.5 Firebox walls.<ept id="1">{}</ept></source>
<target xml:space="preserve"></target>
<context-group>
