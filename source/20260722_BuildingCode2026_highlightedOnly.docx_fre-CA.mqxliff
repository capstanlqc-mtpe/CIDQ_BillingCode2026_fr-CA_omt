<source xml:space="preserve" mq:segpart="219" mq:hasfollowingobject="hasfollowingobject">The stop work order shall be in writing and shall be given to the owner of the property, the owner's authorized agent or the person performing the work.</source>
<target xml:space="preserve"></target>
<context-group>
