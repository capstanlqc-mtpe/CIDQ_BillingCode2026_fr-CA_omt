<source xml:space="preserve" mq:segpart="2178" mq:hasfollowingobject="hasfollowingobject"><bpt id="1" ctype="bold">{}</bpt>1108.7.1.2 Additional stories with Type B units.<ept id="1">{}</ept></source>
<target xml:space="preserve"></target>
<context-group>
