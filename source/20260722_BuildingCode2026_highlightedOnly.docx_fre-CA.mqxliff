<trans-unit id="587" mq:status="NotStarted" mq:segmentguid="b997295c-8fe8-4f05-9009-1169bde457d4" mq:lastchangedtimestamp="0001-01-01T00:00:00Z" mq:maxlengthchars="-1" mq:nosplitjoin="false" mq:firstlabel="508" mq:lastlabel="508" mq:autosplitjoinstate="0" mq:lastmodifrole="0" mq:multipleexactmatch="false">
<source xml:space="preserve" mq:segpart="508" mq:hasfollowingobject="hasfollowingobject">The means of egress in high-rise buildings shall comply with Sections 403.5.1 through 403.5.5.</source>
<target xml:space="preserve"></target>
