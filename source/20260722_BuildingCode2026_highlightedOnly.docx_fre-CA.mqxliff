<source xml:space="preserve" mq:segpart="717" mq:hasfollowingobject="hasfollowingobject">Unconcealed vertical openings totally within an individual residential dwelling unit and connecting four stories or less shall be permitted.</source>
<target xml:space="preserve"></target>
<context-group>
<context context-type="x-mmq-structural-context">trans-units / trans-unit#3478 / struct-rpr#1</context>
