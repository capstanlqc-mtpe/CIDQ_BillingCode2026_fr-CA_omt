<source xml:space="preserve" mq:segpart="1491" mq:hasfollowingobject="hasfollowingobject">The exterior walls and openings adjacent to the exterior exit stairway or ramp comply with Section 1023.7.</source>
<target xml:space="preserve"></target>
<context-group>
<context context-type="x-mmq-structural-context">trans-units / trans-unit#5458 / struct-rpr#1</context>
</context-group>
