<trans-unit id="155" mq:status="NotStarted" mq:segmentguid="d71cab14-ee0a-4f0b-ad3e-f4d726fdb1fa" mq:lastchangedtimestamp="0001-01-01T00:00:00Z" mq:maxlengthchars="-1" mq:nosplitjoin="false" mq:firstlabel="121" mq:lastlabel="121" mq:autosplitjoinstate="0" mq:lastmodifrole="0" mq:multipleexactmatch="false">
<source xml:space="preserve" mq:segpart="121" mq:hasfollowingobject="hasfollowingobject">The registered design professional in responsible charge shall list the deferred submittals on the construction documents for review by the building official.</source>
<target xml:space="preserve"></target>
<context-group>
<context context-type="x-mmq-structural-context">trans-units / trans-unit#121 / struct-rpr#1</context>
