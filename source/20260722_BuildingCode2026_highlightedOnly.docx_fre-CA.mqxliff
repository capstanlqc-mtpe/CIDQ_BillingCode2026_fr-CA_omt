<trans-unit id="562" mq:status="NotStarted" mq:segmentguid="b59fd64a-5527-4590-b5b6-1ee3d94acf40" mq:lastchangedtimestamp="0001-01-01T00:00:00Z" mq:maxlengthchars="-1" mq:nosplitjoin="false" mq:firstlabel="468" mq:lastlabel="468" mq:autosplitjoinstate="0" mq:lastmodifrole="0" mq:multipleexactmatch="false">
<source xml:space="preserve" mq:segpart="468" mq:hasfollowingobject="hasfollowingobject"><bpt id="1" ctype="bold">{}</bpt>410.2.2 Technical production areas: galleries, gridirons and catwalks.<ept id="1">{}</ept></source>
<target xml:space="preserve"></target>
<context-group>
<context context-type="x-mmq-structural-context">trans-units / trans-unit#841 / struct-rpr#1</context>
</context-group>
<mq:startingws xml:space="preserve" />
<mq:endingws xml:space="preserve" />
<mq:commitinfos xmlns="MQXliff" /><mq:nosplitjoins />
<mq:originalsource edited="false" />
