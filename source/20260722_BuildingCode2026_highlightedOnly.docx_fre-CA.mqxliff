<source xml:space="preserve" mq:segpart="806" mq:hasfollowingobject="hasfollowingobject"><bpt id="1" ctype="bold">{}</bpt>804.4.2 Minimum critical radiant flux.<ept id="1">{}</ept></source>
<target xml:space="preserve"></target>
<context-group>
