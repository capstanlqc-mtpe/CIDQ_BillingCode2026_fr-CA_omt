<trans-unit id="1908" mq:status="NotStarted" mq:segmentguid="35d7a240-3c26-4f1d-96c2-93f27641d539" mq:lastchangedtimestamp="2026-07-21T07:30:06Z" mq:lastchanginguser="EmmaG" mq:maxlengthchars="-1" mq:nosplitjoin="false" mq:firstlabel="1561" mq:lastlabel="1561" mq:autosplitjoinstate="0" mq:lastmodifrole="0" mq:multipleexactmatch="false">
<source xml:space="preserve" mq:segpart="1561" mq:hasfollowingobject="hasfollowingobject">2.<ph id="1">&lt;mq:ch val=&quot;	&quot; /&gt;</ph>Not less than 0.005 inch (0.127 mm) of additional aisle capacity for each occupant shall be provided for each 0.10 inch (2.5 mm) of riser height above 7 inches (178 mm).</source>
<target xml:space="preserve"></target>
