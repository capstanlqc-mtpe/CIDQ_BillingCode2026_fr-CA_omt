<source xml:space="preserve" mq:segpart="1812" mq:hasfollowingobject="hasfollowingobject">Where stepped aisles have seating on one side and the aisle width is 74 inches (1880 mm) or greater, two handrails are required.</source>
<target xml:space="preserve"></target>
<context-group>
<context context-type="x-mmq-structural-context">trans-units / trans-unit#5776 / struct-rpr#1</context>
</context-group>
