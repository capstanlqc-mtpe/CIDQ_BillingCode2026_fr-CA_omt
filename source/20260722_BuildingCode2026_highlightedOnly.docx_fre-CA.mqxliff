<source xml:space="preserve" mq:segpart="3005" mq:hasfollowingobject="hasfollowingobject">Hearth extensions shall extend not less than 16 inches (406 mm) in front of and not less than 8 inches (203 mm) beyond each side of the fireplace opening.</source>
<target xml:space="preserve"></target>
<context-group>
<context context-type="x-mmq-structural-context">trans-units / trans-unit#7083 / struct-rpr#1</context>
</context-group>
