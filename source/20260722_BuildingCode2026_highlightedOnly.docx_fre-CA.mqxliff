<trans-unit id="463" mq:status="NotStarted" mq:segmentguid="770f8525-a951-4979-b8db-69332ae97fd6" mq:lastchangedtimestamp="0001-01-01T00:00:00Z" mq:maxlengthchars="-1" mq:nosplitjoin="false" mq:firstlabel="385" mq:lastlabel="385" mq:autosplitjoinstate="0" mq:lastmodifrole="0" mq:multipleexactmatch="false">
<source xml:space="preserve" mq:segpart="385" mq:hasfollowingobject="hasfollowingobject">Required interior exit stairways shall be separated by a distance not less than 30 feet (9144 mm) or not less than one-fourth of the length of the maximum overall diagonal dimension of the building or area to be served, whichever is less.</source>
<target xml:space="preserve"></target>
<context-group>
<context context-type="x-mmq-structural-context">trans-units / trans-unit#760 / struct-rpr#1</context>
</context-group>
<mq:startingws xml:space="preserve" />
<mq:endingws xml:space="preserve"> </mq:endingws>
<mq:commitinfos xmlns="MQXliff" /><mq:nosplitjoins />
<mq:originalsource edited="false" />
</trans-unit>
<trans-unit id="464" mq:status="NotStarted" mq:segmentguid="ca37779a-eee8-4700-8be8-665c0fef22bb" mq:lastchangedtimestamp="0001-01-01T00:00:00Z" mq:maxlengthchars="-1" mq:nosplitjoin="false" mq:firstlabel="385" mq:lastlabel="385" mq:autosplitjoinstate="0" mq:lastmodifrole="0" mq:multipleexactmatch="false">
<source xml:space="preserve" mq:segpart="385" mq:hasfollowingobject="hasfollowingobject">The distance shall be measured in a straight line between the nearest points of the enclosure surrounding the interior exit stairways.</source>
<target xml:space="preserve"></target>
<context-group>
<context context-type="x-mmq-structural-context">trans-units / trans-unit#760 / struct-rpr#1</context>
</context-group>
<mq:startingws xml:space="preserve" />
<mq:endingws xml:space="preserve"> </mq:endingws>
<mq:commitinfos xmlns="MQXliff" /><mq:nosplitjoins />
<mq:originalsource edited="false" />
</trans-unit>
<trans-unit id="465" mq:status="NotStarted" mq:segmentguid="9c27c376-578b-405f-b9f1-a7512f15a2b3" mq:lastchangedtimestamp="0001-01-01T00:00:00Z" mq:maxlengthchars="-1" mq:nosplitjoin="false" mq:firstlabel="385" mq:lastlabel="385" mq:autosplitjoinstate="0" mq:lastmodifrole="0" mq:multipleexactmatch="false">
<source xml:space="preserve" mq:segpart="385" mq:hasfollowingobject="hasfollowingobject">In buildings with three or more interior exit stairways, not fewer than two of the interior exit stairways shall comply with this section.</source>
<target xml:space="preserve"></target>
<context-group>
<context context-type="x-mmq-structural-context">trans-units / trans-unit#760 / struct-rpr#1</context>
</context-group>
