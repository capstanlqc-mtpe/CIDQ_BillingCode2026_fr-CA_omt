<trans-unit id="3718" mq:status="NotStarted" mq:segmentguid="3ca56709-106f-43fd-ab64-a9dfff4cc467" mq:lastchangedtimestamp="0001-01-01T00:00:00Z" mq:maxlengthchars="-1" mq:nosplitjoin="false" mq:firstlabel="2981" mq:lastlabel="2981" mq:autosplitjoinstate="0" mq:lastmodifrole="0" mq:multipleexactmatch="false">
<source xml:space="preserve" mq:segpart="2981" mq:hasfollowingobject="hasfollowingobject">Where cold-formed steel framing is used, the location where the 1/2-inch (12.7 mm) bolts are used to attach the straps to the framing shall be reinforced with not less than a 3-inch × 3-inch × 0.229-inch (76 mm × 76 mm × 5.8 mm) steel plate on top of the strap that is screwed to the framing with not fewer than seven No. 6 screws for each bolt.</source>
<target xml:space="preserve"></target>
<context-group>
<context context-type="x-mmq-structural-context">trans-units / trans-unit#7059 / struct-rpr#1</context>
</context-group>
