<source xml:space="preserve" mq:segpart="1355" mq:hasfollowingobject="hasfollowingobject">An interior exit stairway and ramp shall not continue below its level of exit discharge unless an approved barrier is provided at the level of exit discharge to prevent persons from unintentionally continuing into levels below.</source>
<target xml:space="preserve"></target>
<context-group>
<context context-type="x-mmq-structural-context">trans-units / trans-unit#5311 / struct-rpr#1</context>
