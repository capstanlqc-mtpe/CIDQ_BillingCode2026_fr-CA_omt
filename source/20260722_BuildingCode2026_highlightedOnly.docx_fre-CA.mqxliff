<trans-unit id="389" mq:status="NotStarted" mq:segmentguid="769c425b-e8ad-4f99-bb45-9f4d80df47b6" mq:lastchangedtimestamp="0001-01-01T00:00:00Z" mq:maxlengthchars="-1" mq:nosplitjoin="false" mq:firstlabel="326" mq:lastlabel="326" mq:autosplitjoinstate="0" mq:lastmodifrole="0" mq:multipleexactmatch="false">
<source xml:space="preserve" mq:segpart="326" mq:hasfollowingobject="hasfollowingobject">Each sprinkler system zone in buildings that are more than 420 feet (128 m) in building height shall be supplied by not fewer than two risers.</source>
<target xml:space="preserve"></target>
<context-group>
