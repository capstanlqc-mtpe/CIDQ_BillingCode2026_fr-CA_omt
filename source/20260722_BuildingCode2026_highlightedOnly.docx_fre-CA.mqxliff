<trans-unit id="3188" mq:status="NotStarted" mq:segmentguid="50e1a841-dc70-456a-804d-a9d578067918" mq:lastchangedtimestamp="0001-01-01T00:00:00Z" mq:maxlengthchars="-1" mq:nosplitjoin="false" mq:firstlabel="2558" mq:lastlabel="2558" mq:autosplitjoinstate="0" mq:lastmodifrole="0" mq:multipleexactmatch="false">
<source xml:space="preserve" mq:segpart="2558" mq:hasfollowingobject="hasfollowingobject">The minimum openable area to the outdoors shall be based on the total floor area being ventilated.</source>
<target xml:space="preserve"></target>
