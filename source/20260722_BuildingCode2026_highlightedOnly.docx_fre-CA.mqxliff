<source xml:space="preserve" mq:segpart="845" mq:hasfollowingobject="hasfollowingobject">Combustible trim, excluding handrails and guardrails, shall not exceed 10 percent of the specific wall or ceiling area to which it is attached.</source>
<target xml:space="preserve"></target>
