<source xml:space="preserve" mq:segpart="2185" mq:hasfollowingobject="hasfollowingobject"><bpt id="1" ctype="bold">{}</bpt>1108.7.3 Elevator service to the lowest story with units.<ept id="1">{}</ept></source>
<target xml:space="preserve"></target>
<context-group>
<context context-type="x-mmq-structural-context">trans-units / trans-unit#6141 / struct-rpr#1</context>
</context-group>
