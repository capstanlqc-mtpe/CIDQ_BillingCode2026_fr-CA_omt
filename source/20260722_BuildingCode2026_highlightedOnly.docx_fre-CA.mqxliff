<trans-unit id="556" mq:status="NotStarted" mq:segmentguid="3faf9cff-1ef3-4fc5-81f9-1e4cb086c711" mq:lastchangedtimestamp="0001-01-01T00:00:00Z" mq:maxlengthchars="-1" mq:nosplitjoin="false" mq:firstlabel="464" mq:lastlabel="464" mq:autosplitjoinstate="0" mq:lastmodifrole="0" mq:multipleexactmatch="false">
<source xml:space="preserve" mq:segpart="464" mq:hasfollowingobject="hasfollowingobject">In buildings of Type IIA, IIIA and VA construction, a fire-resistance-rated floor is not required, provided that the space below the stage is equipped with an automatic sprinkler system or fire-extinguishing system in accordance with Section 903 or 904.</source>
<target xml:space="preserve"></target>
<context-group>
<context context-type="x-mmq-structural-context">trans-units / trans-unit#837 / struct-rpr#1</context>
</context-group>
<mq:startingws xml:space="preserve" />
<mq:endingws xml:space="preserve" />
<mq:commitinfos xmlns="MQXliff" /><mq:nosplitjoins />
<mq:originalsource edited="false" />
</trans-unit>
<trans-unit id="557" mq:status="NotStarted" mq:segmentguid="ea2d636c-8dbb-48e2-9983-467e4c60c64e" mq:lastchangedtimestamp="0001-01-01T00:00:00Z" mq:maxlengthchars="-1" mq:nosplitjoin="false" mq:firstlabel="465" mq:lastlabel="465" mq:autosplitjoinstate="0" mq:lastmodifrole="0" mq:multipleexactmatch="false">
<source xml:space="preserve" mq:segpart="465" mq:hasfollowingobject="hasfollowingobject">In all types of construction, the finished floor shall be constructed of wood or approved noncombustible materials.</source>
<target xml:space="preserve"></target>
<context-group>
<context context-type="x-mmq-structural-context">trans-units / trans-unit#838 / struct-rpr#1</context>
</context-group>
<mq:startingws xml:space="preserve" />
<mq:endingws xml:space="preserve"> </mq:endingws>
<mq:commitinfos xmlns="MQXliff" /><mq:nosplitjoins />
<mq:originalsource edited="false" />
</trans-unit>
<trans-unit id="558" mq:status="NotStarted" mq:segmentguid="6788993d-16f1-4429-ae73-8262aa17b0f2" mq:lastchangedtimestamp="0001-01-01T00:00:00Z" mq:maxlengthchars="-1" mq:nosplitjoin="false" mq:firstlabel="465" mq:lastlabel="465" mq:autosplitjoinstate="0" mq:lastmodifrole="0" mq:multipleexactmatch="false">
<source xml:space="preserve" mq:segpart="465" mq:hasfollowingobject="hasfollowingobject">Openings through stage floors shall be equipped with tight-fitting, solid wood trap doors with approved safety locks.</source>
<target xml:space="preserve"></target>
<context-group>
<context context-type="x-mmq-structural-context">trans-units / trans-unit#838 / struct-rpr#1</context>
</context-group>
