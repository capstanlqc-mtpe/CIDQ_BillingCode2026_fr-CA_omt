<trans-unit id="1003" mq:status="NotStarted" mq:segmentguid="a43695b3-a5bc-4253-b82e-3f859f5469c7" mq:lastchangedtimestamp="0001-01-01T00:00:00Z" mq:maxlengthchars="-1" mq:nosplitjoin="false" mq:firstlabel="828" mq:lastlabel="828" mq:autosplitjoinstate="0" mq:lastmodifrole="0" mq:multipleexactmatch="false">
<source xml:space="preserve" mq:segpart="828" mq:hasfollowingobject="hasfollowingobject"><bpt id="1" ctype="bold">{}</bpt>[F] 806.2 Combustible decorative materials.<ept id="1">{}</ept></source>
<target xml:space="preserve"></target>
<context-group>
