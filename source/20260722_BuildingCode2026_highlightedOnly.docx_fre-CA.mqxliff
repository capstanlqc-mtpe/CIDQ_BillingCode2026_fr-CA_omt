<source xml:space="preserve" mq:segpart="307" mq:hasfollowingobject="hasfollowingobject"><bpt id="1" ctype="bold">{}</bpt>[BS] 403.2.2 Structural integrity of interior exit stairways and elevator hoistway enclosures.<ept id="1">{}</ept></source>
<target xml:space="preserve"></target>
<context-group>
<context context-type="x-mmq-structural-context">trans-units / trans-unit#682 / struct-rpr#1</context>
</context-group>
<mq:startingws xml:space="preserve" />
<mq:endingws xml:space="preserve" />
<mq:commitinfos xmlns="MQXliff" /><mq:nosplitjoins />
<mq:originalsource edited="false" />
