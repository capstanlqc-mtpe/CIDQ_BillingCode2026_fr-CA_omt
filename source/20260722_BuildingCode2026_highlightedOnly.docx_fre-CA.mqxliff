<trans-unit id="1002" mq:status="NotStarted" mq:segmentguid="bd3d2201-e597-4fe6-903a-ba67246d950b" mq:lastchangedtimestamp="0001-01-01T00:00:00Z" mq:maxlengthchars="-1" mq:nosplitjoin="false" mq:firstlabel="827" mq:lastlabel="827" mq:autosplitjoinstate="0" mq:lastmodifrole="0" mq:multipleexactmatch="false">
<source xml:space="preserve" mq:segpart="827" mq:hasfollowingobject="hasfollowingobject">The permissible amount of decorative vegetation and noncombustible decorative materials shall not be limited.</source>
<target xml:space="preserve"></target>
<context-group>
<context context-type="x-mmq-structural-context">trans-units / trans-unit#3976 / struct-rpr#1</context>
</context-group>
