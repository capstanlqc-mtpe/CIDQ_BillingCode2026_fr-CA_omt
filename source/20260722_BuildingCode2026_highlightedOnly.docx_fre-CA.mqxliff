<trans-unit id="560" mq:status="NotStarted" mq:segmentguid="efbe9d6a-48c1-4970-bc64-6aff2819caa1" mq:lastchangedtimestamp="0001-01-01T00:00:00Z" mq:maxlengthchars="-1" mq:nosplitjoin="false" mq:firstlabel="467" mq:lastlabel="467" mq:autosplitjoinstate="0" mq:lastmodifrole="0" mq:multipleexactmatch="false">
<source xml:space="preserve" mq:segpart="467" mq:hasfollowingobject="hasfollowingobject">Stage areas shall be measured to include the entire performance area and adjacent backstage and support areas not separated from the performance area by fire-resistance-rated construction.</source>
<target xml:space="preserve"></target>
<context-group>
<context context-type="x-mmq-structural-context">trans-units / trans-unit#840 / struct-rpr#1</context>
</context-group>
<mq:startingws xml:space="preserve" />
<mq:endingws xml:space="preserve"> </mq:endingws>
<mq:commitinfos xmlns="MQXliff" /><mq:nosplitjoins />
<mq:originalsource edited="false" />
</trans-unit>
<trans-unit id="561" mq:status="NotStarted" mq:segmentguid="5596d036-52e0-41b4-b09c-83ff753e579e" mq:lastchangedtimestamp="0001-01-01T00:00:00Z" mq:maxlengthchars="-1" mq:nosplitjoin="false" mq:firstlabel="467" mq:lastlabel="467" mq:autosplitjoinstate="0" mq:lastmodifrole="0" mq:multipleexactmatch="false">
<source xml:space="preserve" mq:segpart="467" mq:hasfollowingobject="hasfollowingobject">Stage height shall be measured from the lowest point on the stage floor to the highest point of the roof or floor deck above the stage.</source>
<target xml:space="preserve"></target>
<context-group>
<context context-type="x-mmq-structural-context">trans-units / trans-unit#840 / struct-rpr#1</context>
