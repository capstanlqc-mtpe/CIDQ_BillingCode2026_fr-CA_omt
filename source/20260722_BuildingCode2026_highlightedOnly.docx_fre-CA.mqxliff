<trans-unit id="5298" mq:status="NotStarted" mq:segmentguid="6fbda3ec-ae72-4a0f-a9c6-b0a601cb0011" mq:lastchangedtimestamp="0001-01-01T00:00:00Z" mq:maxlengthchars="-1" mq:nosplitjoin="false" mq:firstlabel="4087" mq:lastlabel="4087" mq:autosplitjoinstate="0" mq:lastmodifrole="0" mq:multipleexactmatch="false">
<source xml:space="preserve" mq:segpart="4087" mq:hasfollowingobject="hasfollowingobject">Ambient sound levels from sound sources outside and inside the classroom shall be evaluated individually.</source>
<target xml:space="preserve"></target>
<context-group>
<context context-type="x-mmq-structural-context">trans-units / trans-unit#9033 / struct-rpr#1</context>
</context-group>
<mq:startingws xml:space="preserve" />
<mq:endingws xml:space="preserve"> </mq:endingws>
<mq:commitinfos xmlns="MQXliff" /><mq:nosplitjoins />
<mq:originalsource edited="false" />
</trans-unit>
<trans-unit id="5299" mq:status="NotStarted" mq:segmentguid="76460d6f-f59b-478b-b8a8-33fefd578001" mq:lastchangedtimestamp="0001-01-01T00:00:00Z" mq:maxlengthchars="-1" mq:nosplitjoin="false" mq:firstlabel="4087" mq:lastlabel="4087" mq:autosplitjoinstate="0" mq:lastmodifrole="0" mq:multipleexactmatch="false">
<source xml:space="preserve" mq:segpart="4087" mq:hasfollowingobject="hasfollowingobject">The greatest one-hour averaged sound levels shall be evaluated at the loudest usable location in the room at a height of 36 inches (915 mm) to 42 inches (1065 mm) above the floor and no closer than 36 inches (915 mm) from any wall, window or object.</source>
<target xml:space="preserve"></target>
<context-group>
<context context-type="x-mmq-structural-context">trans-units / trans-unit#9033 / struct-rpr#1</context>
</context-group>
<mq:startingws xml:space="preserve" />
<mq:endingws xml:space="preserve"> </mq:endingws>
<mq:commitinfos xmlns="MQXliff" /><mq:nosplitjoins />
<mq:originalsource edited="false" />
</trans-unit>
<trans-unit id="5300" mq:status="NotStarted" mq:segmentguid="d1e3eb02-8eae-40e8-9a6a-71f53e4acad1" mq:lastchangedtimestamp="0001-01-01T00:00:00Z" mq:maxlengthchars="-1" mq:nosplitjoin="false" mq:firstlabel="4087" mq:lastlabel="4087" mq:autosplitjoinstate="0" mq:lastmodifrole="0" mq:multipleexactmatch="false">
<source xml:space="preserve" mq:segpart="4087" mq:hasfollowingobject="hasfollowingobject">The ambient sound level limits shall apply to fully-furnished, unoccupied classrooms, and with only permanent HVAC, electrical and plumbing systems functioning.</source>
<target xml:space="preserve"></target>
<context-group>
<context context-type="x-mmq-structural-context">trans-units / trans-unit#9033 / struct-rpr#1</context>
</context-group>
<mq:startingws xml:space="preserve" />
<mq:endingws xml:space="preserve"> </mq:endingws>
<mq:commitinfos xmlns="MQXliff" /><mq:nosplitjoins />
<mq:originalsource edited="false" />
</trans-unit>
<trans-unit id="5301" mq:status="NotStarted" mq:segmentguid="9bfe0979-204c-4974-aa37-5a2b3524faf0" mq:lastchangedtimestamp="0001-01-01T00:00:00Z" mq:maxlengthchars="-1" mq:nosplitjoin="false" mq:firstlabel="4087" mq:lastlabel="4087" mq:autosplitjoinstate="0" mq:lastmodifrole="0" mq:multipleexactmatch="false">
<source xml:space="preserve" mq:segpart="4087" mq:hasfollowingobject="hasfollowingobject">Classroom equipment, including, but not limited to, computers, printers and fish tank pumps shall be turned off during these measurements.</source>
<target xml:space="preserve"></target>
<context-group>
<context context-type="x-mmq-structural-context">trans-units / trans-unit#9033 / struct-rpr#1</context>
