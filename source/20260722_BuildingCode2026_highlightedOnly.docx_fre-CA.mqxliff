<mq:commitinfos xmlns="MQXliff" /><mq:nosplitjoins />
<mq:originalsource edited="false" />
</trans-unit>
<trans-unit id="3366" mq:status="NotStarted" mq:segmentguid="539971a4-fb09-41dc-9db6-6123c9f57805" mq:lastchangedtimestamp="2026-07-21T07:30:06Z" mq:lastchanginguser="EmmaG" mq:maxlengthchars="-1" mq:nosplitjoin="false" mq:firstlabel="2702" mq:lastlabel="2702" mq:autosplitjoinstate="0" mq:lastmodifrole="0" mq:multipleexactmatch="false">
<source xml:space="preserve" mq:segpart="2702" mq:hasfollowingobject="hasfollowingobject">1.<ph id="1">&lt;mq:ch val=&quot;	&quot; /&gt;</ph>Where the glazing is within 24 inches (610 mm) of either side of the door in the plane of the door in a closed position.</source>
<target xml:space="preserve"></target>
<context-group>
<context context-type="x-mmq-structural-context">trans-units / trans-unit#6785 / struct-rpr#1</context>
</context-group>
