<trans-unit id="3709" mq:status="NotStarted" mq:segmentguid="217dad6f-41fa-4a55-9c7a-751ee5b5a0cd" mq:lastchangedtimestamp="0001-01-01T00:00:00Z" mq:maxlengthchars="-1" mq:nosplitjoin="false" mq:firstlabel="2975" mq:lastlabel="2975" mq:autosplitjoinstate="0" mq:lastmodifrole="0" mq:multipleexactmatch="false">
<source xml:space="preserve" mq:segpart="2975" mq:hasfollowingobject="hasfollowingobject">Two such ties shall be installed at each bend in the vertical bars.</source>
<target xml:space="preserve"></target>
<context-group>
<context context-type="x-mmq-structural-context">trans-units / trans-unit#7053 / struct-rpr#1</context>
