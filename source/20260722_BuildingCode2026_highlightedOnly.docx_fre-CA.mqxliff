<source xml:space="preserve" mq:segpart="316" mq:hasfollowingobject="hasfollowingobject"><bpt id="1" ctype="bold">{}</bpt>[BS] 403.2.2.3 Concrete and masonry walls.<ept id="1">{}</ept></source>
