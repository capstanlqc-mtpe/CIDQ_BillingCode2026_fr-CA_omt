<source xml:space="preserve" mq:segpart="1548" mq:hasfollowingobject="hasfollowingobject"><bpt id="1" ctype="bold">{}</bpt>1030.2 Assembly main exit.<ept id="1">{}</ept></source>
<target xml:space="preserve"></target>
