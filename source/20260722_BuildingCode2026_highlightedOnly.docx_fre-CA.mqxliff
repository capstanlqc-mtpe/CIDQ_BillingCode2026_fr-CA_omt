<trans-unit id="664" mq:status="NotStarted" mq:segmentguid="6af9378f-bf95-41fe-9023-1d94558552a9" mq:lastchangedtimestamp="0001-01-01T00:00:00Z" mq:maxlengthchars="-1" mq:nosplitjoin="false" mq:firstlabel="572" mq:lastlabel="572" mq:autosplitjoinstate="0" mq:lastmodifrole="0" mq:multipleexactmatch="false">
<source xml:space="preserve" mq:segpart="572" mq:hasfollowingobject="hasfollowingobject">The entry to the exit stairway is the edge of the closest riser of the exit stairway.</source>
<target xml:space="preserve"></target>
<context-group>
<context context-type="x-mmq-structural-context">trans-units / trans-unit#559 / struct-rpr#1</context>
