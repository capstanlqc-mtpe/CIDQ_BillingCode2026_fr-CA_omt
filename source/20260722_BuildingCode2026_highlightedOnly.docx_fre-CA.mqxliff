<source xml:space="preserve" mq:segpart="287" mq:hasfollowingobject="hasfollowingobject"><bpt id="1" ctype="bold">{}</bpt>[A] 110.3.7 Weather-exposed balcony and walking surface waterproofing.<ept id="1">{}</ept></source>
