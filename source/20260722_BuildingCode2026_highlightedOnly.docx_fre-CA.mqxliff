<source xml:space="preserve" mq:segpart="1428" mq:hasfollowingobject="hasfollowingobject">Outlining stripes shall have a minimum horizontal width of 1 inch (25 mm) and a maximum width of 2 inches (51 mm).</source>
<target xml:space="preserve"></target>
<context-group>
<context context-type="x-mmq-structural-context">trans-units / trans-unit#5382 / struct-rpr#1</context>
