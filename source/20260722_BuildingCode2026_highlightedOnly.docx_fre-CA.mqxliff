<mq:originalsource edited="false" />
</trans-unit>
<trans-unit id="757" mq:status="NotStarted" mq:segmentguid="ed376547-eabe-4cf0-9629-1a1ef58339ff" mq:lastchangedtimestamp="0001-01-01T00:00:00Z" mq:maxlengthchars="-1" mq:nosplitjoin="false" mq:firstlabel="617" mq:lastlabel="617" mq:autosplitjoinstate="0" mq:lastmodifrole="0" mq:multipleexactmatch="false">
<source xml:space="preserve" mq:segpart="617" mq:hasfollowingobject="hasfollowingobject">A smoke and draft control door assembly as specified in Section 716.2.2.1.1 shall not be required at each elevator hoistway door opening or at each exit doorway between an area of refuge and the exit enclosure.</source>
