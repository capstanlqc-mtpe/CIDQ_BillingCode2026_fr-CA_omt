<source xml:space="preserve" mq:segpart="1834" mq:hasfollowingobject="hasfollowingobject">Cross aisles located more than 30 inches (762 mm) above the floor or grade below shall have guards in accordance with Section 1015.</source>
<target xml:space="preserve"></target>
