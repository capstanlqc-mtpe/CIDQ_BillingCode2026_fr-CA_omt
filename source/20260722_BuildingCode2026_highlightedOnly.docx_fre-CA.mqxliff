<trans-unit id="1631" mq:status="NotStarted" mq:segmentguid="1e1b5cf0-ebee-46cf-97b7-5359ddd32dd8" mq:lastchangedtimestamp="0001-01-01T00:00:00Z" mq:maxlengthchars="-1" mq:nosplitjoin="false" mq:firstlabel="1353" mq:lastlabel="1353" mq:autosplitjoinstate="0" mq:lastmodifrole="0" mq:multipleexactmatch="false">
<source xml:space="preserve" mq:segpart="1353" mq:hasfollowingobject="hasfollowingobject">Openings within such exterior walls shall be protected by opening protectives having a fire protection rating of not less than 3/4 hour.</source>
<target xml:space="preserve"></target>
