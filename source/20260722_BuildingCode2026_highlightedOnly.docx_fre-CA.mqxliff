<source xml:space="preserve" mq:segpart="1503" mq:hasfollowingobject="hasfollowingobject">The entire area of the level of exit discharge is separated from areas below by construction conforming to the fire-resistance rating for the enclosure.</source>
<target xml:space="preserve"></target>
<context-group>
<context context-type="x-mmq-structural-context">trans-units / trans-unit#5469 / struct-rpr#1</context>
</context-group>
