<source xml:space="preserve" mq:segpart="2992" mq:hasfollowingobject="hasfollowingobject">Masonry fireplaces shall be equipped with a ferrous metal damper located not less than 8 inches (203 mm) above the top of the fireplace opening.</source>
<target xml:space="preserve"></target>
