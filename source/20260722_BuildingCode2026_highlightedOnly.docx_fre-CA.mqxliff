<trans-unit id="2638" mq:status="NotStarted" mq:segmentguid="77c1e4e5-2a2d-464e-a35e-829e233fe446" mq:lastchangedtimestamp="0001-01-01T00:00:00Z" mq:maxlengthchars="-1" mq:nosplitjoin="false" mq:firstlabel="2173" mq:lastlabel="2173" mq:autosplitjoinstate="0" mq:lastmodifrole="0" mq:multipleexactmatch="false">
<source xml:space="preserve" mq:segpart="2173" mq:hasfollowingobject="hasfollowingobject">Where specifically permitted by Section 1108.5 or 1108.6, the required number of Type A units and Type B units is permitted to be reduced in accordance with Sections 1108.7.1 through 1108.7.5.</source>
<target xml:space="preserve"></target>
<context-group>
