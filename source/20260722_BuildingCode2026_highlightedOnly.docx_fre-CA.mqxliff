<trans-unit id="1015" mq:status="NotStarted" mq:segmentguid="73fb0889-58f3-4e2b-bfef-f6a66aaacc6b" mq:lastchangedtimestamp="0001-01-01T00:00:00Z" mq:maxlengthchars="-1" mq:nosplitjoin="false" mq:firstlabel="839" mq:lastlabel="839" mq:autosplitjoinstate="0" mq:lastmodifrole="0" mq:multipleexactmatch="false">
<source xml:space="preserve" mq:segpart="839" mq:hasfollowingobject="hasfollowingobject">Reports of test results shall be prepared in accordance with the test method used and furnished to the building official on request.</source>
<target xml:space="preserve"></target>
