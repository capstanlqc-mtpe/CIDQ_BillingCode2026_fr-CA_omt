<trans-unit id="3705" mq:status="NotStarted" mq:segmentguid="4a37d65f-f795-42e6-8998-81366ed5d07a" mq:lastchangedtimestamp="0001-01-01T00:00:00Z" mq:maxlengthchars="-1" mq:nosplitjoin="false" mq:firstlabel="2973" mq:lastlabel="2973" mq:autosplitjoinstate="0" mq:lastmodifrole="0" mq:multipleexactmatch="false">
<source xml:space="preserve" mq:segpart="2973" mq:hasfollowingobject="hasfollowingobject">Grout shall be prevented from bonding with the flue liner so that the flue liner is free to move with thermal expansion.</source>
<target xml:space="preserve"></target>
<context-group>
<context context-type="x-mmq-structural-context">trans-units / trans-unit#7051 / struct-rpr#1</context>
</context-group>
