<trans-unit id="2675" mq:status="NotStarted" mq:segmentguid="e90100fd-42f8-4fae-bacf-ea8e54c6a941" mq:lastchangedtimestamp="0001-01-01T00:00:00Z" mq:maxlengthchars="-1" mq:nosplitjoin="false" mq:firstlabel="2205" mq:lastlabel="2205" mq:autosplitjoinstate="0" mq:lastmodifrole="0" mq:multipleexactmatch="false">
<source xml:space="preserve" mq:segpart="2205" mq:hasfollowingobject="hasfollowingobject">Where no more than one urinal is provided in a toilet room or bathing room, the urinal is not required to be accessible.</source>
<target xml:space="preserve"></target>
<context-group>
