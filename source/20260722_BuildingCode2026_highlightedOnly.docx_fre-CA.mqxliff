<trans-unit id="1892" mq:status="NotStarted" mq:segmentguid="839dfda6-f1d4-41a3-b737-c00381d6b1d7" mq:lastchangedtimestamp="0001-01-01T00:00:00Z" mq:maxlengthchars="-1" mq:nosplitjoin="false" mq:firstlabel="1549" mq:lastlabel="1549" mq:autosplitjoinstate="0" mq:lastmodifrole="0" mq:multipleexactmatch="false">
<source xml:space="preserve" mq:segpart="1549" mq:hasfollowingobject="hasfollowingobject">A building, room or space used for assembly purposes that has an occupant load of greater than 300 and is provided with a main exit, that main exit shall be of sufficient capacity to accommodate not less than one-half of the occupant load, but such capacity shall be not less than the total required capacity of all means of egress leading to the exit.</source>
<target xml:space="preserve"></target>
<context-group>
<context context-type="x-mmq-structural-context">trans-units / trans-unit#5513 / struct-rpr#1</context>
</context-group>
<mq:startingws xml:space="preserve" />
<mq:endingws xml:space="preserve"> </mq:endingws>
<mq:commitinfos xmlns="MQXliff" /><mq:nosplitjoins />
<mq:originalsource edited="false" />
</trans-unit>
<trans-unit id="1893" mq:status="NotStarted" mq:segmentguid="0a973184-f74e-40a4-ae52-e742d45bc2ca" mq:lastchangedtimestamp="0001-01-01T00:00:00Z" mq:maxlengthchars="-1" mq:nosplitjoin="false" mq:firstlabel="1549" mq:lastlabel="1549" mq:autosplitjoinstate="0" mq:lastmodifrole="0" mq:multipleexactmatch="false">
<source xml:space="preserve" mq:segpart="1549" mq:hasfollowingobject="hasfollowingobject">Where the building is classified as a Group A occupancy, the main exit shall front on not less than one street or an unoccupied space of not less than 10 feet (3048 mm) in width that adjoins a street or public way.</source>
<target xml:space="preserve"></target>
<context-group>
<context context-type="x-mmq-structural-context">trans-units / trans-unit#5513 / struct-rpr#1</context>
</context-group>
<mq:startingws xml:space="preserve" />
<mq:endingws xml:space="preserve"> </mq:endingws>
<mq:commitinfos xmlns="MQXliff" /><mq:nosplitjoins />
<mq:originalsource edited="false" />
</trans-unit>
<trans-unit id="1894" mq:status="NotStarted" mq:segmentguid="3e4c8e6a-b429-48f3-a3cb-d6e467b0c340" mq:lastchangedtimestamp="0001-01-01T00:00:00Z" mq:maxlengthchars="-1" mq:nosplitjoin="false" mq:firstlabel="1549" mq:lastlabel="1549" mq:autosplitjoinstate="0" mq:lastmodifrole="0" mq:multipleexactmatch="false">
<source xml:space="preserve" mq:segpart="1549" mq:hasfollowingobject="hasfollowingobject">In a building, room or space used for assembly purposes where there is not a well-defined main exit or where multiple main exits are provided, exits shall be permitted to be distributed around the perimeter of the building provided that the total capacity of egress is not less than 100 percent of the required capacity.</source>
<target xml:space="preserve"></target>
<context-group>
<context context-type="x-mmq-structural-context">trans-units / trans-unit#5513 / struct-rpr#1</context>
</context-group>
