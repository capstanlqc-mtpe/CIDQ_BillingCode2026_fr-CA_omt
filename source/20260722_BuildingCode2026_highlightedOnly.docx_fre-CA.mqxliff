<trans-unit id="271" mq:status="NotStarted" mq:segmentguid="b7d8cc7d-a220-439c-bbf0-3e40d2400209" mq:lastchangedtimestamp="0001-01-01T00:00:00Z" mq:maxlengthchars="-1" mq:nosplitjoin="false" mq:firstlabel="240" mq:lastlabel="240" mq:autosplitjoinstate="0" mq:lastmodifrole="0" mq:multipleexactmatch="false">
<source xml:space="preserve" mq:segpart="240" mq:hasfollowingobject="hasfollowingobject"><bpt id="1" ctype="bold">{}</bpt>[A] 107.3.3 Phased approval.<ept id="1">{}</ept></source>
<target xml:space="preserve"></target>
<context-group>
