<source xml:space="preserve" mq:segpart="1836" mq:hasfollowingobject="hasfollowingobject">Where the backs of seats on the front of the cross aisle project 24 inches (610 mm) or more above the adjacent floor of the aisle, a guard need not be provided.</source>
<target xml:space="preserve"></target>
<context-group>
