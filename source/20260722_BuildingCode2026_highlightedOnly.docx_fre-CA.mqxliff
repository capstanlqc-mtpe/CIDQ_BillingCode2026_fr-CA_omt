<source xml:space="preserve" mq:segpart="2979" mq:hasfollowingobject="hasfollowingobject">Two 3/16-inch by 1-inch (5 mm by 25 mm) straps shall be embedded not less than 12 inches (305 mm) into the chimney.</source>
<target xml:space="preserve"></target>
<context-group>
<context context-type="x-mmq-structural-context">trans-units / trans-unit#7057 / struct-rpr#1</context>
</context-group>
<mq:startingws xml:space="preserve" />
<mq:endingws xml:space="preserve"> </mq:endingws>
