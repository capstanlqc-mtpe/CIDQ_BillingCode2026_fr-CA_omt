<source xml:space="preserve" mq:segpart="1829" mq:hasfollowingobject="hasfollowingobject">Where there is an aisle between the seating and the perimeter, the guard height shall be measured in accordance with Section 1015.3.</source>
<target xml:space="preserve"></target>
