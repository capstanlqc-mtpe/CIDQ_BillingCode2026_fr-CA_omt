<source xml:space="preserve" mq:segpart="1356" mq:hasfollowingobject="hasfollowingobject"><bpt id="1" ctype="bold">{}</bpt>1023.9 Stairway identification signs.<ept id="1">{}</ept></source>
<target xml:space="preserve"></target>
