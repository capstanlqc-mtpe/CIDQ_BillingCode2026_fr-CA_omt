<source xml:space="preserve" mq:segpart="2174" mq:hasfollowingobject="hasfollowingobject"><bpt id="1" ctype="bold">{}</bpt>1108.7.1 Structures without elevator service.<ept id="1">{}</ept></source>
<target xml:space="preserve"></target>
<context-group>
