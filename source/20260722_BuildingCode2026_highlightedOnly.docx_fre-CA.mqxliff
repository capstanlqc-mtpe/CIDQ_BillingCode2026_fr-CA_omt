<trans-unit id="1814" mq:status="NotStarted" mq:segmentguid="249301f0-9839-493e-912c-133acac8062a" mq:lastchangedtimestamp="0001-01-01T00:00:00Z" mq:maxlengthchars="-1" mq:nosplitjoin="false" mq:firstlabel="1485" mq:lastlabel="1485" mq:autosplitjoinstate="0" mq:lastmodifrole="0" mq:multipleexactmatch="false">
<source xml:space="preserve" mq:segpart="1485" mq:hasfollowingobject="hasfollowingobject">Separation from the interior of the building is not required for occupancies, other than those in Group R-1 or R-2, in buildings that are not more than two stories above grade plane where a level of exit discharge serving such occupancies is the first story above grade plane.</source>
<target xml:space="preserve"></target>
<context-group>
<context context-type="x-mmq-structural-context">trans-units / trans-unit#5452 / struct-rpr#1</context>
</context-group>
<mq:startingws xml:space="preserve" />
<mq:endingws xml:space="preserve" />
<mq:commitinfos xmlns="MQXliff" /><mq:nosplitjoins />
<mq:originalsource edited="false" />
</trans-unit>
<trans-unit id="1815" mq:status="NotStarted" mq:segmentguid="62935a42-e25d-4b64-960f-64b241839822" mq:lastchangedtimestamp="0001-01-01T00:00:00Z" mq:maxlengthchars="-1" mq:nosplitjoin="false" mq:firstlabel="1486" mq:lastlabel="1486" mq:autosplitjoinstate="0" mq:lastmodifrole="0" mq:multipleexactmatch="false">
<source xml:space="preserve" mq:segpart="1486" mq:hasfollowingobject="hasfollowingobject">Separation from the interior of the building is not required where the exterior exit stairway or ramp is served by an exterior exit ramp or balcony that connects two remote exterior exit stairways or other approved exits with a perimeter that is not less than 50 percent open.</source>
<target xml:space="preserve"></target>
<context-group>
<context context-type="x-mmq-structural-context">trans-units / trans-unit#5453 / struct-rpr#1</context>
</context-group>
<mq:startingws xml:space="preserve" />
<mq:endingws xml:space="preserve"> </mq:endingws>
<mq:commitinfos xmlns="MQXliff" /><mq:nosplitjoins />
<mq:originalsource edited="false" />
</trans-unit>
<trans-unit id="1816" mq:status="NotStarted" mq:segmentguid="1d2167bf-f415-451f-8376-4868459a0175" mq:lastchangedtimestamp="0001-01-01T00:00:00Z" mq:maxlengthchars="-1" mq:nosplitjoin="false" mq:firstlabel="1486" mq:lastlabel="1486" mq:autosplitjoinstate="0" mq:lastmodifrole="0" mq:multipleexactmatch="false">
<source xml:space="preserve" mq:segpart="1486" mq:hasfollowingobject="hasfollowingobject">To be considered open, the opening shall be not less than 50 percent of the height of the enclosing wall, with the top of the openings not less than 7 feet (2134 mm) above the top of the balcony.</source>
<target xml:space="preserve"></target>
<context-group>
<context context-type="x-mmq-structural-context">trans-units / trans-unit#5453 / struct-rpr#1</context>
</context-group>
<mq:startingws xml:space="preserve" />
<mq:endingws xml:space="preserve" />
<mq:commitinfos xmlns="MQXliff" /><mq:nosplitjoins />
<mq:originalsource edited="false" />
</trans-unit>
<trans-unit id="1817" mq:status="NotStarted" mq:segmentguid="9cafd5a4-2fab-4f87-90ae-d9d1f943ee85" mq:lastchangedtimestamp="0001-01-01T00:00:00Z" mq:maxlengthchars="-1" mq:nosplitjoin="false" mq:firstlabel="1487" mq:lastlabel="1487" mq:autosplitjoinstate="0" mq:lastmodifrole="0" mq:multipleexactmatch="false">
<source xml:space="preserve" mq:segpart="1487" mq:hasfollowingobject="hasfollowingobject">Separation from the open-ended corridor of the building is not required for exterior exit stairways or ramps, provided that Items 3.1 through 3.5 are met:</source>
<target xml:space="preserve"></target>
<context-group>
<context context-type="x-mmq-structural-context">trans-units / trans-unit#5454 / struct-rpr#1</context>
</context-group>
<mq:startingws xml:space="preserve" />
<mq:endingws xml:space="preserve" />
<mq:commitinfos xmlns="MQXliff" /><mq:nosplitjoins />
<mq:originalsource edited="false" />
</trans-unit>
<trans-unit id="1818" mq:status="NotStarted" mq:segmentguid="d4cf321d-1894-44df-a026-bd60852c836c" mq:lastchangedtimestamp="0001-01-01T00:00:00Z" mq:maxlengthchars="-1" mq:nosplitjoin="false" mq:firstlabel="1488" mq:lastlabel="1488" mq:autosplitjoinstate="0" mq:lastmodifrole="0" mq:multipleexactmatch="false">
<source xml:space="preserve" mq:segpart="1488" mq:hasfollowingobject="hasfollowingobject">The building, including open-ended corridors, and stairways and ramps, shall be equipped throughout with an automatic sprinkler system in accordance with Section 903.3.1.1 or 903.3.1.2.</source>
<target xml:space="preserve"></target>
<context-group>
<context context-type="x-mmq-structural-context">trans-units / trans-unit#5455 / struct-rpr#1</context>
</context-group>
<mq:startingws xml:space="preserve" />
