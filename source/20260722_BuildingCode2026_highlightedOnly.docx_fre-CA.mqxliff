<mq:endingws xml:space="preserve"> </mq:endingws>
<mq:commitinfos xmlns="MQXliff" /><mq:nosplitjoins />
<mq:originalsource edited="false" />
</trans-unit>
<trans-unit id="522" mq:status="NotStarted" mq:segmentguid="70b04a36-eaf3-44c2-9701-15db60a9ab59" mq:lastchangedtimestamp="0001-01-01T00:00:00Z" mq:maxlengthchars="-1" mq:nosplitjoin="false" mq:firstlabel="431" mq:lastlabel="431" mq:autosplitjoinstate="0" mq:lastmodifrole="0" mq:multipleexactmatch="false">
<source xml:space="preserve" mq:segpart="431" mq:hasfollowingobject="hasfollowingobject">The sprinkler system shall be designed so that the entire surface of the glass is wet upon activation of the sprinkler system without obstruction;</source>
<target xml:space="preserve"></target>
<context-group>
<context context-type="x-mmq-structural-context">trans-units / trans-unit#805 / struct-rpr#1</context>
</context-group>
