<source xml:space="preserve" mq:segpart="3872" mq:hasfollowingobject="hasfollowingobject">The companion seat shall be equivalent in size, quality, comfort and amenities to the seats in the immediate area to the wheelchair space location.</source>
<target xml:space="preserve"></target>
