<source xml:space="preserve" mq:segpart="2980" mq:hasfollowingobject="hasfollowingobject"><bpt id="1" ctype="bold">{}</bpt>R1001.4.1.1 Cold-formed steel framing.<ept id="1">{}</ept></source>
<target xml:space="preserve"></target>
