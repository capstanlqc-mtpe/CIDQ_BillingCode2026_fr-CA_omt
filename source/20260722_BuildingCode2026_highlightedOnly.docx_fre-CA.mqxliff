<source xml:space="preserve" mq:segpart="2285" mq:hasfollowingobject="hasfollowingobject"><bpt id="1" ctype="bold">{}</bpt>1206.2 Airborne sound.<ept id="1">{}</ept></source>
<target xml:space="preserve"></target>
