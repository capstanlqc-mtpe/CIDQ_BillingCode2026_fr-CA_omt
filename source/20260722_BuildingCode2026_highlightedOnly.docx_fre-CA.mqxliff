<source xml:space="preserve" mq:segpart="2973" mq:hasfollowingobject="hasfollowingobject">For chimneys up to 40 inches (1016 mm) wide, four No. 4 continuous vertical bars shall be placed between wythes of solid masonry or within the cells of hollow unit masonry and grouted in accordance with Section R606.</source>
<target xml:space="preserve"></target>
<context-group>
<context context-type="x-mmq-structural-context">trans-units / trans-unit#7051 / struct-rpr#1</context>
</context-group>
