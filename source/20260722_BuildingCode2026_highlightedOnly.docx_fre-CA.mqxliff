<trans-unit id="2648" mq:status="NotStarted" mq:segmentguid="15afeeab-4874-4f17-bcf9-227db080ef44" mq:lastchangedtimestamp="0001-01-01T00:00:00Z" mq:maxlengthchars="-1" mq:nosplitjoin="false" mq:firstlabel="2182" mq:lastlabel="2182" mq:autosplitjoinstate="0" mq:lastmodifrole="0" mq:multipleexactmatch="false">
<source xml:space="preserve" mq:segpart="2182" mq:hasfollowingobject="hasfollowingobject">Where arrival points are not within 50 feet (15 240 mm) of the entrance, the closest arrival point shall be used to determine access unless that arrival point serves the story required by Section 1108.7.1.1.</source>
<target xml:space="preserve"></target>
<context-group>
<context context-type="x-mmq-structural-context">trans-units / trans-unit#6138 / struct-rpr#1</context>
</context-group>
