<source xml:space="preserve" mq:segpart="448" mq:hasfollowingobject="hasfollowingobject">Buildings and structures shall be equipped throughout with an automatic sprinkler system in accordance with Section 903.3.1.1 and a secondary water supply where required by Section 403.3.3.</source>
<target xml:space="preserve"></target>
<context-group>
