<source xml:space="preserve" mq:segpart="317" mq:hasfollowingobject="hasfollowingobject">Concrete or masonry walls shall be deemed to satisfy the requirements of Sections 403.2.2.1 and 403.2.2.2.</source>
<target xml:space="preserve"></target>
