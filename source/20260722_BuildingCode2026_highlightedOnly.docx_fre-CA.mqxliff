<source xml:space="preserve" mq:segpart="217" mq:hasfollowingobject="hasfollowingobject">Where the building official finds any work regulated by this code being performed in a manner contrary to the provisions of this code or in a dangerous or unsafe manner, the building official is authorized to issue a stop work order.</source>
<target xml:space="preserve"></target>
<context-group>
<context context-type="x-mmq-structural-context">trans-units / trans-unit#212 / struct-rpr#1</context>
</context-group>
