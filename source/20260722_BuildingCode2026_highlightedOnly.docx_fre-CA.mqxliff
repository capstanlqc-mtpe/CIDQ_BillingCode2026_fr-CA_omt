<source xml:space="preserve" mq:segpart="616" mq:hasfollowingobject="hasfollowingobject"><bpt id="1" ctype="bold">{}</bpt>709.4.2 Smoke-barrier walls enclosing areas of refuge or elevator lobbies.<ept id="1">{}</ept></source>
<target xml:space="preserve"></target>
