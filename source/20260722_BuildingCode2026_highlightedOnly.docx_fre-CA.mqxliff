</trans-unit>
<trans-unit id="396" mq:status="NotStarted" mq:segmentguid="44489ea1-31ea-4290-ad4c-0874e30d43c8" mq:lastchangedtimestamp="0001-01-01T00:00:00Z" mq:maxlengthchars="-1" mq:nosplitjoin="false" mq:firstlabel="330" mq:lastlabel="330" mq:autosplitjoinstate="0" mq:lastmodifrole="0" mq:multipleexactmatch="false">
<source xml:space="preserve" mq:segpart="330" mq:hasfollowingobject="hasfollowingobject">Separate supply piping shall be provided between each connection to the water main and the pumps.</source>
<target xml:space="preserve"></target>
<context-group>
<context context-type="x-mmq-structural-context">trans-units / trans-unit#705 / struct-rpr#1</context>
</context-group>
