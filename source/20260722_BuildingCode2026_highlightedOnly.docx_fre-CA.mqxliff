<source xml:space="preserve" mq:segpart="1796" mq:hasfollowingobject="hasfollowingobject">The tolerance between adjacent risers on a stepped aisle that were designed to be equal height shall not exceed 3/16 inch (4.8 mm).</source>
<target xml:space="preserve"></target>
<context-group>
