<source xml:space="preserve" mq:segpart="1373" mq:hasfollowingobject="hasfollowingobject">A smokeproof enclosure shall terminate at an exit discharge or a public way.</source>
<target xml:space="preserve"></target>
<context-group>
<context context-type="x-mmq-structural-context">trans-units / trans-unit#5329 / struct-rpr#1</context>
