<source xml:space="preserve" mq:segpart="1371" mq:hasfollowingobject="hasfollowingobject">Where required by Section 403.5.4, 405.7.2 or 412.2.2.1, interior exit stairways and ramps shall be smokeproof enclosures in accordance with Section 909.20.</source>
<target xml:space="preserve"></target>
<context-group>
