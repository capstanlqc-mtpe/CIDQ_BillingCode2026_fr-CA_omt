<source xml:space="preserve" mq:segpart="255" mq:hasfollowingobject="hasfollowingobject">A permit shall not be valid until the fees prescribed by law have been paid, nor shall an amendment to a permit be released until the additional fee, if any, has been paid.</source>
<target xml:space="preserve"></target>
<context-group>
