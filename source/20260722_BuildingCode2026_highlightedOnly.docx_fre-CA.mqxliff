<trans-unit id="468" mq:status="NotStarted" mq:segmentguid="923c1906-7cc8-4c78-8381-c0187e70ab87" mq:lastchangedtimestamp="0001-01-01T00:00:00Z" mq:maxlengthchars="-1" mq:nosplitjoin="false" mq:firstlabel="387" mq:lastlabel="387" mq:autosplitjoinstate="0" mq:lastmodifrole="0" mq:multipleexactmatch="false">
<source xml:space="preserve" mq:segpart="387" mq:hasfollowingobject="hasfollowingobject">For buildings other than Group R-2 and their ancillary spaces that are more than 420 feet (128 m) in building height, one additional interior exit stairway meeting the requirements of Sections 1011 and 1023 shall be provided in addition to the minimum number of exits required by Section 1006.3.</source>
<target xml:space="preserve"></target>
<context-group>
<context context-type="x-mmq-structural-context">trans-units / trans-unit#762 / struct-rpr#1</context>
</context-group>
<mq:startingws xml:space="preserve" />
