<trans-unit id="507" mq:status="NotStarted" mq:segmentguid="f6c9f100-c675-4045-88f6-27ba76d5d7ff" mq:lastchangedtimestamp="0001-01-01T00:00:00Z" mq:maxlengthchars="-1" mq:nosplitjoin="false" mq:firstlabel="444" mq:lastlabel="444" mq:autosplitjoinstate="0" mq:lastmodifrole="0" mq:multipleexactmatch="false">
<source xml:space="preserve" mq:segpart="444" mq:hasfollowingobject="hasfollowingobject">Any other wall materials that provide impact resistance equivalent to that required by Sections 403.2.2.1 for Soft Body Impact Classification Level 2 and 403.2.2.2 for Hard Body Impact Classification Level 3, as measured by the test method described in ASTM C1629/C1629M, shall be permitted.</source>
<target xml:space="preserve"></target>
<context-group>
