<source xml:space="preserve" mq:segpart="443" mq:hasfollowingobject="hasfollowingobject"><bpt id="1" ctype="bold">{}</bpt>[BS] 403.2.2.4 Other wall materials.<ept id="1">{}</ept></source>
<target xml:space="preserve"></target>
<context-group>
