<trans-unit id="529" mq:status="NotStarted" mq:segmentguid="1fe41799-aa74-45a0-87a4-6f98db44f879" mq:lastchangedtimestamp="0001-01-01T00:00:00Z" mq:maxlengthchars="-1" mq:nosplitjoin="false" mq:firstlabel="438" mq:lastlabel="438" mq:autosplitjoinstate="0" mq:lastmodifrole="0" mq:multipleexactmatch="false">
<source xml:space="preserve" mq:segpart="438" mq:hasfollowingobject="hasfollowingobject">A horizontal assembly is not required between the atrium and openings for exit access stairways and ramps complying with Item 4 of Section 1019.3.</source>
<target xml:space="preserve"></target>
<context-group>
<context context-type="x-mmq-structural-context">trans-units / trans-unit#812 / struct-rpr#1</context>
