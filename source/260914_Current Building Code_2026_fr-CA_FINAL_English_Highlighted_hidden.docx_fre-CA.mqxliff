<trans-unit id="1024" mq:status="NotStarted" mq:segmentguid="5e212d31-b528-4b29-bcd1-987ee3731b7f" mq:lastchangedtimestamp="0001-01-01T00:00:00Z" mq:maxlengthchars="-1" mq:nosplitjoin="false" mq:firstlabel="771" mq:lastlabel="771" mq:autosplitjoinstate="0" mq:lastmodifrole="0" mq:multipleexactmatch="false">
<source xml:space="preserve" mq:segpart="771" mq:hasfollowingobject="hasfollowingobject">The installation of kick plates on existing doors and gates without a smooth surface within 10 inches (255 mm) of the floor shall be permitted.</source>
<target xml:space="preserve"></target>
<context-group>
<context context-type="x-mmq-structural-context">trans-units / trans-unit#7061 / struct-rpr#1</context>
</context-group>
