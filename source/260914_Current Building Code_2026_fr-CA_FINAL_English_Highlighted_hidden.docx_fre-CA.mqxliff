<source xml:space="preserve" mq:segpart="194" mq:hasfollowingobject="hasfollowingobject">The building shall be sprinklered throughout in accordance with Section 903.3.1.1 and automatic sprinklers shall also be provided in the concealed space.</source>
<target xml:space="preserve"></target>
