<trans-unit id="292" mq:status="NotStarted" mq:segmentguid="780f85b7-1335-4325-911c-9262e57d73b6" mq:lastchangedtimestamp="0001-01-01T00:00:00Z" mq:maxlengthchars="-1" mq:nosplitjoin="false" mq:firstlabel="184" mq:lastlabel="184" mq:autosplitjoinstate="0" mq:lastmodifrole="0" mq:multipleexactmatch="false">
<source xml:space="preserve" mq:segpart="184" mq:hasfollowingobject="hasfollowingobject">Type IV-HT (Heavy Timber) construction is that type of construction in which the exterior walls are of noncombustible materials and the interior building elements are of solid wood, laminated heavy timber or structural composite lumber (SCL), without concealed spaces or with concealed spaces complying with Section 602.4.4.3.</source>
<target xml:space="preserve"></target>
<context-group>
<context context-type="x-mmq-structural-context">trans-units / trans-unit#2356 / struct-rpr#1</context>
</context-group>
<mq:startingws xml:space="preserve" />
<mq:endingws xml:space="preserve"> </mq:endingws>
<mq:commitinfos xmlns="MQXliff" /><mq:nosplitjoins />
<mq:originalsource edited="false" />
</trans-unit>
<trans-unit id="293" mq:status="NotStarted" mq:segmentguid="8d0047cb-3445-4281-8c67-ea68173b1f87" mq:lastchangedtimestamp="0001-01-01T00:00:00Z" mq:maxlengthchars="-1" mq:nosplitjoin="false" mq:firstlabel="184" mq:lastlabel="184" mq:autosplitjoinstate="0" mq:lastmodifrole="0" mq:multipleexactmatch="false">
<source xml:space="preserve" mq:segpart="184" mq:hasfollowingobject="hasfollowingobject">The minimum dimensions for permitted materials including solid timber, glued-laminated timber, SCL and cross-laminated timber (CLT) and the details of Type IV construction shall comply with the provisions of this Section and Section 2304.11.</source>
<target xml:space="preserve"></target>
<context-group>
<context context-type="x-mmq-structural-context">trans-units / trans-unit#2356 / struct-rpr#1</context>
</context-group>
<mq:startingws xml:space="preserve" />
<mq:endingws xml:space="preserve"> </mq:endingws>
<mq:commitinfos xmlns="MQXliff" /><mq:nosplitjoins />
<mq:originalsource edited="false" />
</trans-unit>
<trans-unit id="294" mq:status="NotStarted" mq:segmentguid="71fd6fbf-4e86-40ac-a862-4085998c97e9" mq:lastchangedtimestamp="0001-01-01T00:00:00Z" mq:maxlengthchars="-1" mq:nosplitjoin="false" mq:firstlabel="184" mq:lastlabel="184" mq:autosplitjoinstate="0" mq:lastmodifrole="0" mq:multipleexactmatch="false">
<source xml:space="preserve" mq:segpart="184" mq:hasfollowingobject="hasfollowingobject">Exterior walls complying with Section 602.4.4.1 or 602.4.4.2 shall be permitted.</source>
<target xml:space="preserve"></target>
<context-group>
<context context-type="x-mmq-structural-context">trans-units / trans-unit#2356 / struct-rpr#1</context>
</context-group>
