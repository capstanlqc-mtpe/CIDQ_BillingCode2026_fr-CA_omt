<trans-unit id="416" mq:status="NotStarted" mq:segmentguid="50aa307b-20a2-44b0-9cf5-4a0ed519fb43" mq:lastchangedtimestamp="0001-01-01T00:00:00Z" mq:maxlengthchars="-1" mq:nosplitjoin="false" mq:firstlabel="284" mq:lastlabel="284" mq:autosplitjoinstate="0" mq:lastmodifrole="0" mq:multipleexactmatch="false">
<source xml:space="preserve" mq:segpart="284" mq:hasfollowingobject="hasfollowingobject">Where walls and ceilings are required to be of fire-resistance-rated or noncombustible construction and walls are set out or ceilings are dropped distances greater than specified in Section 803.15.1, Class A finish materials, in accordance with Section 803.1.1 or 803.1.2, shall be used.</source>
<target xml:space="preserve"></target>
