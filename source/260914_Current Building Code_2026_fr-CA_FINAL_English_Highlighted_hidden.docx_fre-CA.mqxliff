<source xml:space="preserve" mq:segpart="675" mq:hasfollowingobject="hasfollowingobject">In new buildings and facilities, the turning space shall be a T–shaped space complying with one of the following:</source>
<target xml:space="preserve"></target>
<context-group>
<context context-type="x-mmq-structural-context">trans-units / trans-unit#6805 / struct-rpr#1</context>
</context-group>
<mq:startingws xml:space="preserve" />
<mq:endingws xml:space="preserve" />
<mq:commitinfos xmlns="MQXliff" /><mq:nosplitjoins />
