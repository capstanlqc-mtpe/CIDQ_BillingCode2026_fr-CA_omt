<source xml:space="preserve" mq:segpart="676" mq:hasfollowingobject="hasfollowingobject">At the intersection of each arm and the base, the interior corners shall be chamfered for 8 inches (205 mm) minimum along both the arm and along the base.</source>
<target xml:space="preserve"></target>
<context-group>
<context context-type="x-mmq-structural-context">trans-units / trans-unit#6806 / struct-rpr#1</context>
</context-group>
