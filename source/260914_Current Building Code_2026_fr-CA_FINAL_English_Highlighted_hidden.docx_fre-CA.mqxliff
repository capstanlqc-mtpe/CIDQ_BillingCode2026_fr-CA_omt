<trans-unit id="556" mq:status="NotStarted" mq:segmentguid="e3d7120f-0e98-49dd-a4e7-de898c82cda2" mq:lastchangedtimestamp="0001-01-01T00:00:00Z" mq:maxlengthchars="-1" mq:nosplitjoin="false" mq:firstlabel="391" mq:lastlabel="391" mq:autosplitjoinstate="0" mq:lastmodifrole="0" mq:multipleexactmatch="false">
<source xml:space="preserve" mq:segpart="391" mq:hasfollowingobject="hasfollowingobject">The word “EXIT” shall be in high contrast with the background and shall be clearly discernible when the means of exit sign illumination is or is not energized.</source>
<target xml:space="preserve"></target>
<context-group>
