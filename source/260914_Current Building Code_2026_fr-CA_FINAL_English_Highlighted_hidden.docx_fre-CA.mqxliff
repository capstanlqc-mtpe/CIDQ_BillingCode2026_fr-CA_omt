<source xml:space="preserve" mq:segpart="93" mq:hasfollowingobject="hasfollowingobject">This occupancy condition shall include buildings in which free movement is allowed from sleeping areas and any other occupied smoke compartment to one or more other smoke compartments.</source>
<target xml:space="preserve"></target>
<context-group>
<context context-type="x-mmq-structural-context">trans-units / trans-unit#517 / struct-rpr#1</context>
