<source xml:space="preserve" mq:segpart="185" mq:hasfollowingobject="hasfollowingobject"><bpt id="1" ctype="bold">{}</bpt>602.4.4.1 Fire-retardant-treated wood in exterior walls.<ept id="1">{}</ept></source>
