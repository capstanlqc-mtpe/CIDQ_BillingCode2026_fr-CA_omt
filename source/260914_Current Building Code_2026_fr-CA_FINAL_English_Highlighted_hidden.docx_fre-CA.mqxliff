<source xml:space="preserve" mq:segpart="112" mq:hasfollowingobject="hasfollowingobject">The minimum dimensions and permitted materials for building elements shall comply with the provisions of this Section and Section 2304.11.</source>
<target xml:space="preserve"></target>
