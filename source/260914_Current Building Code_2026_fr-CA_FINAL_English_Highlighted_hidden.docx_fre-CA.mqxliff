<source xml:space="preserve" mq:segpart="91" mq:hasfollowingobject="hasfollowingobject">Buildings of Group I-3 shall be classified as one of the occupancy conditions specified in Sections 308.4.1 through 308.4.5 and shall comply with Section 408.</source>
<target xml:space="preserve"></target>
