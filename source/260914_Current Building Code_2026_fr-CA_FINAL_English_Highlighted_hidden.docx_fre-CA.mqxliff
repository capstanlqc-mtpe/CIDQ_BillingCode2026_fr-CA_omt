<trans-unit id="513" mq:status="NotStarted" mq:segmentguid="f99b0dd0-0e29-4fd7-b227-aeaad05124cf" mq:lastchangedtimestamp="0001-01-01T00:00:00Z" mq:maxlengthchars="-1" mq:nosplitjoin="false" mq:firstlabel="359" mq:lastlabel="359" mq:autosplitjoinstate="0" mq:lastmodifrole="0" mq:multipleexactmatch="false">
<source xml:space="preserve" mq:segpart="359" mq:hasfollowingobject="hasfollowingobject">There shall not be enclosed usable space under exterior exit stairways unless the space is completely enclosed in 1-hour fire-resistance-rated construction.</source>
<target xml:space="preserve"></target>
<context-group>
<context context-type="x-mmq-structural-context">trans-units / trans-unit#4079 / struct-rpr#1</context>
