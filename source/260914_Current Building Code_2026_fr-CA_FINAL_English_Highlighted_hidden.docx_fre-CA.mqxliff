<source xml:space="preserve" mq:segpart="379" mq:hasfollowingobject="hasfollowingobject">The bottom of the sign shall be not less than 10 inches (254 mm) nor more than 18 inches (455 mm) above the floor level.</source>
<target xml:space="preserve"></target>
