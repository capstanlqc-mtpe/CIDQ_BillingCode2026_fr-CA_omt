<source xml:space="preserve" mq:segpart="260" mq:hasfollowingobject="hasfollowingobject">If the materials are tested in accordance with ASTM E84 or UL 723, specimen preparation and mounting shall be in accordance with ASTM E2573.</source>
<target xml:space="preserve"></target>
<context-group>
