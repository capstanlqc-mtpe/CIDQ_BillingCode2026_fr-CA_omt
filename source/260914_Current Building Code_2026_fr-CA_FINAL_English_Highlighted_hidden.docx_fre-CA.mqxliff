<trans-unit id="276" mq:status="NotStarted" mq:segmentguid="055c9107-4e83-4f69-b7a5-4aaf7de782b2" mq:lastchangedtimestamp="0001-01-01T00:00:00Z" mq:maxlengthchars="-1" mq:nosplitjoin="false" mq:firstlabel="172" mq:lastlabel="172" mq:autosplitjoinstate="0" mq:lastmodifrole="0" mq:multipleexactmatch="false">
<source xml:space="preserve" mq:segpart="172" mq:hasfollowingobject="hasfollowingobject">The exterior side of walls of combustible construction shall be protected with noncombustible protection with a minimum assigned time of 40 minutes, as determined in Table 722.7.1(1).</source>
<target xml:space="preserve"></target>
<context-group>
<context context-type="x-mmq-structural-context">trans-units / trans-unit#2344 / struct-rpr#1</context>
</context-group>
<mq:startingws xml:space="preserve" />
<mq:endingws xml:space="preserve"> </mq:endingws>
<mq:commitinfos xmlns="MQXliff" /><mq:nosplitjoins />
<mq:originalsource edited="false" />
</trans-unit>
<trans-unit id="277" mq:status="NotStarted" mq:segmentguid="53606fbb-d206-40ef-9c83-70eb21a211ff" mq:lastchangedtimestamp="0001-01-01T00:00:00Z" mq:maxlengthchars="-1" mq:nosplitjoin="false" mq:firstlabel="172" mq:lastlabel="172" mq:autosplitjoinstate="0" mq:lastmodifrole="0" mq:multipleexactmatch="false">
<source xml:space="preserve" mq:segpart="172" mq:hasfollowingobject="hasfollowingobject">Components of the exterior wall covering shall be of noncombustible material except water-resistive barriers having a peak heat release rate of less than 150 kW/m2, a total heat release of less than 20 MJ/m2 and an effective heat of combustion of less than 18 MJ/kg as determined in accordance with ASTM E1354 and having a flame spread index of 25 or less and a smoke-developed index of 450 or less as determined in accordance with ASTM E84 or UL 723.</source>
<target xml:space="preserve"></target>
<context-group>
<context context-type="x-mmq-structural-context">trans-units / trans-unit#2344 / struct-rpr#1</context>
</context-group>
<mq:startingws xml:space="preserve" />
<mq:endingws xml:space="preserve"> </mq:endingws>
<mq:commitinfos xmlns="MQXliff" /><mq:nosplitjoins />
<mq:originalsource edited="false" />
</trans-unit>
<trans-unit id="278" translate="no" mq:locked="locked" mq:status="NotStarted" mq:segmentguid="2cc2e19c-7dce-44d0-9073-a6999df9b4b7" mq:lastchangedtimestamp="2026-09-15T17:05:49Z" mq:lastchanginguser="Valentina" mq:maxlengthchars="-1" mq:nosplitjoin="false" mq:firstlabel="172" mq:lastlabel="172" mq:autosplitjoinstate="0" mq:lastmodifrole="0" mq:multipleexactmatch="false">
<source xml:space="preserve" mq:segpart="172" mq:hasfollowingobject="hasfollowingobject">The ASTM E1354 test shall be conducted on specimens at the thickness intended for use, in the horizontal orientation and at an incident radiant heat flux of 50 kW/m2.</source>
<target xml:space="preserve"></target>
<context-group>
<context context-type="x-mmq-structural-context">trans-units / trans-unit#2344 / struct-rpr#1</context>
