<trans-unit id="1025" mq:status="NotStarted" mq:segmentguid="d2988201-6865-4c01-9a14-8fbf55104fe7" mq:lastchangedtimestamp="0001-01-01T00:00:00Z" mq:maxlengthchars="-1" mq:nosplitjoin="false" mq:firstlabel="771" mq:lastlabel="771" mq:autosplitjoinstate="0" mq:lastmodifrole="0" mq:multipleexactmatch="false">
<source xml:space="preserve" mq:segpart="771" mq:hasfollowingobject="hasfollowingobject">The kick plates shall extend to 10 inches (255 mm) above the floor and no more than 1 inch (25 mm) from the sides and bottom of the door.</source>
<target xml:space="preserve"></target>
<context-group>
<context context-type="x-mmq-structural-context">trans-units / trans-unit#7061 / struct-rpr#1</context>
</context-group>
