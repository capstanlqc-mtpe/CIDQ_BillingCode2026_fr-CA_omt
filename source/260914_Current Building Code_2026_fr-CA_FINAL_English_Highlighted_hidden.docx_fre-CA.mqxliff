<source xml:space="preserve" mq:segpart="120" mq:hasfollowingobject="hasfollowingobject">The required fire-resistance rating of noncombustible elements and protected mass timber elements shall be determined in accordance with Section 703.2.<ph id="1">&lt;/rpr id=&quot;14&quot; transform=&quot;close&quot;&gt;</ph></source>
<target xml:space="preserve"></target>
