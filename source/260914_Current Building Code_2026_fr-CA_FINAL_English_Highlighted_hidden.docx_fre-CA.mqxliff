<source xml:space="preserve" mq:segpart="363" mq:hasfollowingobject="hasfollowingobject"><bpt id="1" ctype="bold">{}</bpt>1011.10 Spiral stairways.<ept id="1">{}</ept></source>
<target xml:space="preserve"></target>
<context-group>
