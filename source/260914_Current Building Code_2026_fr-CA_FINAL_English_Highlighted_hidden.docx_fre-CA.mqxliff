<source xml:space="preserve" mq:segpart="849" mq:hasfollowingobject="hasfollowingobject"><bpt id="1" ctype="bold">{}</bpt>604.9.5.2 Toe clearance at wheelchair accessible toilet compartments for children’s use.<ept id="1">{}</ept></source>
<target xml:space="preserve"></target>
