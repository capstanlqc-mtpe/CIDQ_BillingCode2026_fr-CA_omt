<trans-unit id="555" mq:status="NotStarted" mq:segmentguid="cd47b97b-bf2d-45b7-9876-d6b55001792d" mq:lastchangedtimestamp="0001-01-01T00:00:00Z" mq:maxlengthchars="-1" mq:nosplitjoin="false" mq:firstlabel="390" mq:lastlabel="390" mq:autosplitjoinstate="0" mq:lastmodifrole="0" mq:multipleexactmatch="false">
<source xml:space="preserve" mq:segpart="390" mq:hasfollowingobject="hasfollowingobject">Signs larger than the minimum established in this section shall have letter widths, strokes and spacing in proportion to their height.</source>
<target xml:space="preserve"></target>
<context-group>
<context context-type="x-mmq-structural-context">trans-units / trans-unit#4179 / struct-rpr#1</context>
