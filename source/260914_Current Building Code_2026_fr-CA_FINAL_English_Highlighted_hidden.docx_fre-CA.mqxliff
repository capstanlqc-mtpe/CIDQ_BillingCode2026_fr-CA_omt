<source xml:space="preserve" mq:segpart="365" mq:hasfollowingobject="hasfollowingobject">The risers shall be sufficient to provide a headroom of 78 inches (1981 mm) minimum, but riser height shall not be more than 91/2 inches (241 mm).</source>
<target xml:space="preserve"></target>
<context-group>
