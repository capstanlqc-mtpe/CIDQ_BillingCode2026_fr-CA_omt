<trans-unit id="232" mq:status="NotStarted" mq:segmentguid="b726d06a-06e8-40cd-b9fb-e6c4cfd44751" mq:lastchangedtimestamp="0001-01-01T00:00:00Z" mq:maxlengthchars="-1" mq:nosplitjoin="false" mq:firstlabel="137" mq:lastlabel="137" mq:autosplitjoinstate="0" mq:lastmodifrole="0" mq:multipleexactmatch="false">
<source xml:space="preserve" mq:segpart="137" mq:hasfollowingobject="hasfollowingobject">Components of the exterior wall covering shall be of noncombustible material except water-resistive barriers having a peak heat release rate of less than 150kW/m2, a total heat release of less than 20 MJ/m2 and an effective heat of combustion of less than 18MJ/kg as determined in accordance with ASTM E1354, and having a flame spread index of 25 or less and a smoke-developed index of 450 or less as determined in accordance with ASTM E84 or UL 723.</source>
<target xml:space="preserve"></target>
<context-group>
