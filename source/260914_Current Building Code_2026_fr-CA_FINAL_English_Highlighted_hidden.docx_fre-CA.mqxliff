<trans-unit id="521" mq:status="NotStarted" mq:segmentguid="32339cd4-81d0-4fa4-a96d-072575bed7d2" mq:lastchangedtimestamp="0001-01-01T00:00:00Z" mq:maxlengthchars="-1" mq:nosplitjoin="false" mq:firstlabel="365" mq:lastlabel="365" mq:autosplitjoinstate="0" mq:lastmodifrole="0" mq:multipleexactmatch="false">
<source xml:space="preserve" mq:segpart="365" mq:hasfollowingobject="hasfollowingobject">A spiral stairway shall have a 63/4-inch (171 mm) minimum clear tread depth at a point 12 inches (305 mm) from the narrow edge.</source>
<target xml:space="preserve"></target>
<context-group>
<context context-type="x-mmq-structural-context">trans-units / trans-unit#4087 / struct-rpr#1</context>
</context-group>
