<source xml:space="preserve" mq:segpart="544" mq:hasfollowingobject="hasfollowingobject"><bpt id="1" ctype="bold">{}</bpt>1109.2.8 Performance areas.<ept id="1">{}</ept></source>
<target xml:space="preserve"></target>
