<source xml:space="preserve" mq:segpart="196" mq:hasfollowingobject="hasfollowingobject">Surfaces within the concealed space shall be fully sheathed with not less than 5/8-inch Type X gypsum board.</source>
<target xml:space="preserve"></target>
