<source xml:space="preserve" mq:segpart="551" mq:hasfollowingobject="hasfollowingobject">In sports facilities, tiered dining areas providing seating required to be accessible shall be required to have accessible routes serving at least 25 percent of the dining area, provided that accessible routes serve accessible seating and where each tier is provided with the same services.</source>
<target xml:space="preserve"></target>
<context-group>
<context context-type="x-mmq-structural-context">trans-units / trans-unit#5451 / struct-rpr#1</context>
</context-group>
