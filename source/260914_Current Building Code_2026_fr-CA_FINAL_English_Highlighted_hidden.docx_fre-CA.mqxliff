<source xml:space="preserve" mq:segpart="195" mq:hasfollowingobject="hasfollowingobject">The concealed space shall be completely filled with noncombustible insulation.</source>
<target xml:space="preserve"></target>
<context-group>
<context context-type="x-mmq-structural-context">trans-units / trans-unit#2367 / struct-rpr#1</context>
</context-group>
