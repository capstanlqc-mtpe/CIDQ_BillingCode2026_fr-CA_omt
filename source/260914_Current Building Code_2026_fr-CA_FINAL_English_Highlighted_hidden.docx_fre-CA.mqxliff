<trans-unit id="870" translate="no" mq:locked="locked" mq:status="PreTranslated" mq:percent="100" mq:segmentguid="d7cae240-36c9-4257-a486-c74f5f4ba250" mq:lastchangedtimestamp="2026-09-14T15:56:56Z" mq:lastchanginguser="EmmaG" mq:maxlengthchars="-1" mq:nosplitjoin="false" mq:firstlabel="651" mq:lastlabel="651" mq:autosplitjoinstate="0" mq:lastmodifrole="4" mq:multipleexactmatch="false">
<source xml:space="preserve" mq:segpart="651" mq:hasfollowingobject="hasfollowingobject">One drinking fountain shall comply with the requirements for people who use a wheelchair and one drinking fountain shall comply with the requirements for standing persons.</source>
<target xml:space="preserve">Un abreuvoir doit être conforme aux exigences applicables aux personnes utilisant un fauteuil roulant, et un appareil de fontaine d’eau à boire doit être conforme aux exigences applicables aux personnes en position debout.</target>
