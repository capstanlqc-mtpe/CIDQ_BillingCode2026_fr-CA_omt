<source xml:space="preserve" mq:segpart="776" mq:hasfollowingobject="hasfollowingobject">Full powered automatic doors and gates shall comply with ANSI/BHMA A156.10 listed in Section 106.2.7.</source>
<target xml:space="preserve"></target>
