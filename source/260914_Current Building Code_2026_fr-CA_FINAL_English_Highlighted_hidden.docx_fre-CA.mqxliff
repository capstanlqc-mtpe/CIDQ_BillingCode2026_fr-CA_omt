<mq:originalsource edited="false" />
</trans-unit>
<trans-unit id="554" mq:status="NotStarted" mq:segmentguid="1b18a6f2-d155-4df7-b74f-9cf757185c4d" mq:lastchangedtimestamp="0001-01-01T00:00:00Z" mq:maxlengthchars="-1" mq:nosplitjoin="false" mq:firstlabel="390" mq:lastlabel="390" mq:autosplitjoinstate="0" mq:lastmodifrole="0" mq:multipleexactmatch="false">
<source xml:space="preserve" mq:segpart="390" mq:hasfollowingobject="hasfollowingobject">The word “EXIT” shall have letters having a width not less than 2 inches (51 mm) wide, except the letter “I,” and the minimum spacing between letters shall be not less than 3/8 inch (9.5 mm).</source>
<target xml:space="preserve"></target>
<context-group>
<context context-type="x-mmq-structural-context">trans-units / trans-unit#4179 / struct-rpr#1</context>
</context-group>
