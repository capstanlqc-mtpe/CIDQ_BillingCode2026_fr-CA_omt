<trans-unit id="562" mq:status="NotStarted" mq:segmentguid="b5077dbb-1f27-4b0e-b946-2dd4aee66433" mq:lastchangedtimestamp="0001-01-01T00:00:00Z" mq:maxlengthchars="-1" mq:nosplitjoin="false" mq:firstlabel="395" mq:lastlabel="395" mq:autosplitjoinstate="0" mq:lastmodifrole="0" mq:multipleexactmatch="false">
<source xml:space="preserve" mq:segpart="395" mq:hasfollowingobject="hasfollowingobject">To ensure continued illumination for a duration of not less than 90 minutes in case of primary power loss, the sign illumination means shall be connected to an emergency power system provided from storage batteries, unit equipment or an on-site generator.</source>
<target xml:space="preserve"></target>
<context-group>
