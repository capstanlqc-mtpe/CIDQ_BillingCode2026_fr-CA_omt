<source xml:space="preserve" mq:segpart="502" mq:hasfollowingobject="hasfollowingobject">Wheelchair spaces in team or player seating serving areas of sport activity are not required to be dispersed.</source>
<target xml:space="preserve"></target>
<context-group>
