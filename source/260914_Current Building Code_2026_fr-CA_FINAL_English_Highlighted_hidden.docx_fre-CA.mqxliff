<trans-unit id="740" mq:status="NotStarted" mq:segmentguid="8f4ad90b-23db-47aa-a747-e0701fcd6150" mq:lastchangedtimestamp="0001-01-01T00:00:00Z" mq:maxlengthchars="-1" mq:nosplitjoin="false" mq:firstlabel="550" mq:lastlabel="550" mq:autosplitjoinstate="0" mq:lastmodifrole="0" mq:multipleexactmatch="false">
<source xml:space="preserve" mq:segpart="550" mq:hasfollowingobject="hasfollowingobject">An accessible route to dining and drinking areas in a mezzanine is not required, provided that the mezzanine contains less than 25 percent of the total combined area for dining and drinking and the same services, and decor are provided in the accessible area.</source>
<target xml:space="preserve"></target>
<context-group>
<context context-type="x-mmq-structural-context">trans-units / trans-unit#5450 / struct-rpr#1</context>
</context-group>
